// VERA — MAX4466 + Electret Microphone Filtered Wiring Harness
// Goal: eliminate AC hum, Pi 5 switching-rail noise, and RF pickup.
// Render: dot -Tpng -Tsvg -Tpdf mic_harness.dot
digraph mic_harness {
  rankdir=LR;
  graph [fontname="Helvetica", fontsize=11, labelloc="t",
         label="VERA Mic Harness — Filtered Power, Shielded Signal\nv1.24.0"];
  node  [fontname="Helvetica", fontsize=10, shape=box, style="filled,rounded"];
  edge  [fontname="Helvetica", fontsize=9];

  // ---------- POWER PATH (Pi 5 → MAX4466 VCC) ----------
  subgraph cluster_pwr {
    label="Power Filter Network (mounted at MAX4466 end)";
    style=dashed; color="#888";
    pi33  [label="Pi 5 GPIO Header\nPin 1 (3.3 V)\n[noisy switching rail]", fillcolor="#fde2e2"];
    fb    [label="Ferrite Bead\nBLM18AG601SN1\n(600 Ω @ 100 MHz)", fillcolor="#fff4cc"];
    rser  [label="R_ser 10 Ω 1/8 W\n(forms RC with C1)", fillcolor="#fff4cc"];
    c1    [label="C1 10 µF\ntantalum/elec\n(bulk)", fillcolor="#cce5ff"];
    c2    [label="C2 100 nF\nceramic X7R\n(mid)", fillcolor="#cce5ff"];
    c3    [label="C3 10 nF\nceramic X7R\n(HF)", fillcolor="#cce5ff"];
    vcc   [label="MAX4466 VDD\n(clean 3.3 V)", fillcolor="#d9f5d9"];

    pi33 -> fb -> rser -> vcc;
    rser -> c1 [style=dotted, arrowhead=none, label="to GND"];
    rser -> c2 [style=dotted, arrowhead=none, label="to GND"];
    rser -> c3 [style=dotted, arrowhead=none, label="to GND"];
  }

  // ---------- MIC + AMP ----------
  mic   [label="Electret Capsule\n(2-pin, 2.2 kΩ bias)", fillcolor="#e2d5f5"];
  max   [label="MAX4466 Module\n(gain pot → set ~50×)\nVDD / GND / OUT", fillcolor="#e2d5f5"];
  mic -> max [label="bias + audio"];

  vcc -> max [label="VDD"];

  // ---------- SIGNAL PATH (MAX4466 OUT → CM108 MIC IN) ----------
  subgraph cluster_sig {
    label="Signal Conditioning + Shielded Cable";
    style=dashed; color="#888";
    rseries [label="R_lp 1 kΩ 1/8 W\n(in series on OUT)", fillcolor="#fff4cc"];
    clp     [label="C_lp 4.7 nF C0G\n(to GND)\nLPF fc ≈ 34 kHz\nkills RF >100 kHz", fillcolor="#cce5ff"];
    twist   [label="Twisted pair cable\n(signal + GND, twisted)\nLENGTH ≤ 30 cm", fillcolor="#fde6c4"];
    foil    [label="Copper Tape Shield\n(wrap around twist)\nGROUNDED AT CM108 END ONLY\n(other end floats)", fillcolor="#f0e6d2"];
    cm108   [label="CM108 USB Audio\n3.5 mm TRS MIC IN\n(tip = signal, sleeve = GND)", fillcolor="#d9f5d9"];

    max     -> rseries [label="OUT (AC-coupled inside chip)"];
    rseries -> clp     [label="audio"];
    clp     -> twist   [label="filtered audio"];
    twist   -> cm108   [label="≤ 30 cm twisted"];
    foil    -> twist   [style=dotted, arrowhead=none, label="wraps around"];
    foil    -> cm108   [label="drain wire → GND\n(SINGLE-POINT)", color="red"];
  }

  // ---------- GROUND ----------
  gnd_star [label="Star Ground Node\n(Pi 5 GPIO Pin 6 = 0 V)\nALL grounds tie here", fillcolor="#cccccc", shape=octagon];
  c1   -> gnd_star;
  c2   -> gnd_star;
  c3   -> gnd_star;
  clp  -> gnd_star;
  max  -> gnd_star [label="MAX GND pin"];
  cm108-> gnd_star [label="USB GND (already)"];

  // ---------- LEGEND ----------
  subgraph cluster_legend {
    label="Notes"; fontsize=10;
    rules [shape=note, fillcolor="#ffffe0", label=
      "1. Mount C1/C2/C3 within 5 mm of MAX4466 VDD pin (short leads = effective filter).\l\
2. Ferrite bead blocks RF from Pi switching regulator (1–2 MHz harmonics).\l\
3. R_ser + C1 = 100 µs RC time constant → low-pass to remove >1 kHz ripple.\l\
4. Twisted pair rejects common-mode magnetic pickup (50/60 Hz hum).\l\
5. Copper foil shield grounded at ONE end only — Faraday cage, no ground loop.\l\
6. Keep harness away from: servo PWM wires, fan PWM, USB cables, AC adapters.\l\
7. After install: measure noise floor with `arecord -d 5 -f cd silence.wav`,\l\
   then `sox silence.wav -n stat` — RMS amplitude should be < 0.001.\l"];
  }
}
