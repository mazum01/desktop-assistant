// VERA — System Architecture
//
// This file is the source of truth for docs/architecture/architecture.pdf.
// Regenerate with:  bash docs/architecture/build.sh
//
// Per agent imperative #7: this diagram MUST be updated whenever a service,
// driver, hardware item, or topic is added/removed/renamed.

digraph VERA {
    rankdir=TB;
    splines=true;
    nodesep=0.4;
    ranksep=0.6;
    fontname="Helvetica";
    labelloc="t";
    label=<<b>VERA — Vision-Enabled Reasoning Agent — System Architecture</b><br/><font point-size="10">v1.44.0 — openWakeWord neural wake detection + voice pipeline + STT controls across CLI/Web/OpenClaw</font>>;
    fontsize=16;

    node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, margin=0.15];
    edge  [fontname="Helvetica", fontsize=8, color="#555555"];

    // ─────────────────────────────────────────────────────────────────
    // Hardware layer
    // ─────────────────────────────────────────────────────────────────
    subgraph cluster_hw {
        label="Hardware (Raspberry Pi 5)";
        style="filled,rounded";
        fillcolor="#f5e9d8";
        fontsize=11;

        hw_tmp117  [label="TMP117\n(I²C 0x48)",       fillcolor="#ffd6a5"];
        hw_fan     [label="NF-A6x25 PWM Fan\nPWM ← GPIO13 (kernel HW PWM, 25 kHz)\nTACH → GPIO6 (2 ppr)", fillcolor="#ffd6a5"];
        hw_servo   [label="DS3218 Servo\n(PCA9685 ch15)", fillcolor="#ffd6a5"];
        hw_cam     [label="Pi Cam Module 3 Wide\n(CSI-0)", fillcolor="#ffd6a5"];
        hw_mic     [label="reSpeaker XVF3800\n(USB mic array)",        fillcolor="#ffd6a5"];
        hw_spk     [label="reSpeaker XVF3800 output →\nattached speaker", fillcolor="#ffd6a5"];
        hw_hailo   [label="Hailo-8 AI HAT+\n(26 TOPS, PCIe)",  fillcolor="#ffd6a5"];
    }

    // ─────────────────────────────────────────────────────────────────
    // Driver layer (src/...)
    // ─────────────────────────────────────────────────────────────────
    subgraph cluster_drv {
        label="Drivers (src/)";
        style="filled,rounded";
        fillcolor="#dfeefc";
        fontsize=11;

        drv_tmp117 [label="thermal/tmp117.py",          fillcolor="#a5c8ff"];
        drv_fan    [label="thermal/fan.py\n(sysfs HW PWM\n+ lgpio fallback)", fillcolor="#a5c8ff"];
        drv_tach   [label="thermal/fan_tach.py\n(lgpio edge cb)", fillcolor="#a5c8ff"];
        drv_thmgr  [label="thermal/thermal_manager.py", fillcolor="#a5c8ff"];
        drv_servo  [label="motion/servo_controller.py", fillcolor="#a5c8ff"];
        drv_cam    [label="vision/camera.py\n(picamera2)", fillcolor="#a5c8ff"];
        drv_aout   [label="audio/output.py",            fillcolor="#a5c8ff"];
        drv_ain    [label="audio/input.py",             fillcolor="#a5c8ff"];
        drv_tts    [label="audio/tts.py\n(espeak-ng)",  fillcolor="#a5c8ff"];
        drv_van    [label="audio/version_announcer.py", fillcolor="#a5c8ff"];
        drv_hailo  [label="perception/hailo_inference.py\n(VDevice wrapper)",  fillcolor="#a5c8ff"];
        drv_facedet [label="perception/face_detector.py\n(SCRFD decode + Haar fallback)", fillcolor="#a5c8ff"];
        drv_objdet  [label="perception/object_detector.py\n(YOLOv8s + letterbox cache)", fillcolor="#a5c8ff"];
    }

    // ─────────────────────────────────────────────────────────────────
    // Core
    // ─────────────────────────────────────────────────────────────────
    subgraph cluster_core {
        label="Core (src/core/)";
        style="filled,rounded";
        fillcolor="#e7e3fb";
        fontsize=11;

        core_bus     [label="core MessageBus\n(in-process pub/sub)", fillcolor="#bdb1f5"];
        thermal_bus  [label="thermal MessageBus\n(in-process pub/sub)", fillcolor="#bdb1f5"];
        core_svc     [label="Service base\n(start/tick/stop)",  fillcolor="#bdb1f5"];
        core_ver     [label="version.py\n(reads /VERSION)",     fillcolor="#bdb1f5"];
        core_qh      [label="QuietHours\n(enabled / start / end\nloaded from config/quiet_hours.yaml)", fillcolor="#bdb1f5"];
    }

    // ─────────────────────────────────────────────────────────────────
    // Services
    // ─────────────────────────────────────────────────────────────────
    subgraph cluster_svc_thermal {
        label="systemd: desktop-assistant-thermal.service";
        style="filled,rounded";
        fillcolor="#fde0e0";
        fontsize=11;

        svc_thermal [label="ThermalService\n— thermal.temp\n— thermal.fan\n— thermal.rpm\n— thermal.critical\n— thermal.error", fillcolor="#f4a3a3"];
        svc_thermal_ipc [label="IPCBridge (thermal)\nPUB ipc:///tmp/desktop-assistant-thermal.pub\nREP ipc:///tmp/desktop-assistant-thermal.rep", fillcolor="#f4a3a3"];
    }

    subgraph cluster_svc_core {
        label="systemd: desktop-assistant-core.service";
        style="filled,rounded";
        fillcolor="#e2f5d8";
        fontsize=11;

        svc_motion  [label="MotionService\n← motion.pan_to / relax / stop\n→ motion.position / moved", fillcolor="#a8d88d"];
        svc_vision  [label="VisionService\n→ vision.frame_ready\n← vision.capture_still\n+ latest_frame()",        fillcolor="#a8d88d"];
        svc_audio   [label="AudioCaptureService\n→ audio.level / chunk\n+ latest_chunk()",                          fillcolor="#a8d88d"];
        svc_voice   [label="VoiceCommandService\n← audio stream/VAD\n→ voice.state / wake / transcript / intent\n→ av.utterance (routed transcript)\nwake-window + dialog context", fillcolor="#a8d88d"];
        svc_av      [label="AVService\n← av.say / beep / utterance / announce_version\n→ av.spoke / av.speaking_started / version_announced", fillcolor="#a8d88d"];
        svc_perception [label="PerceptionService\n← vision.frame_ready\n→ perception.faces / perception.error\n+ FaceEmbedder (ArcFace) + FaceRegistry", fillcolor="#a8d88d"];
        svc_telemetry [label="TelemetryService\n← thermal.* / motion.position / audio.level\n→ telemetry.flush\nSQLite ring buffer", fillcolor="#a8d88d"];
        svc_ipc     [label="IPCBridge (core)\nPUB ipc:///tmp/desktop-assistant.pub\nREP ipc:///tmp/desktop-assistant.rep\nSUB ← thermal.pub (upstream)\ncmds: ping / topics / last / publish / status", fillcolor="#a8d88d"];
        svc_face    [label="FaceService\n← perception.faces / face.meet\n→ av.say (greetings)\n→ face.identified\ncooldown-based re-greet", fillcolor="#a8d88d"];
        svc_track   [label="TrackingService\n← perception.faces\n→ motion.pan_to\n← av.speaking_started / av.spoke\n20Hz spring-damper tracking\nidle random gaze · speaking nod", fillcolor="#a8d88d"];
        svc_web     [label="WebService (FastAPI)\nGET / — dashboard SPA\nGET /stream — MJPEG 640×360 feed\nWS /ws — live JSON status\nGET /api/faces — list (has_thumb flag)\nGET /api/skills — registered skills\nGET /api/faces/{id}/thumb — face JPEG\nPUT /api/faces/{id} — rename\nDEL /api/faces/{id} — delete one\nDEL /api/faces — delete all\nGET|PUT /api/settings/quiet-hours\nGET|PUT /api/settings/audio\nGET|PUT /api/settings/voice\nGET|PUT /api/room\nPOST /api/say|pan|version|utterance\nport 8080", fillcolor="#a8d88d"];
        svc_clock   [label="ClockService\n+ ClockAnnouncer\n→ av.say (hourly/half-hourly)\nrespects QuietHours", fillcolor="#a8d88d"];
        svc_object  [label="ObjectService\n← vision.frame_ready / object.set_enabled\n→ object.detections\n2fps · max_objects cap · BGR→RGB fix", fillcolor="#a8d88d"];
        svc_music   [label="MusicService\n← music.play / stop / pause / next\n← music.thumbs_up / thumbs_down / set_volume\nPandora / audio playback", fillcolor="#a8d88d"];
        svc_podcast [label="PodcastService\nApple Podcasts search + RSS subscriptions\n← podcast.play/pause/resume/stop/refresh\n→ podcast.playback / subscriptions_updated", fillcolor="#a8d88d"];
        svc_skills  [label="SkillsService\n← av.utterance / thermal.temp\n→ av.say / vision.describe / av.tell_joke\n→ face.meet / motion.pan_to / music.*\n→ object.set_enabled / music.set_volume\n→ tracking.set_face_tracking\nSkillRegistry — first-match dispatch\n17 skills: help · system_status · volume\n   quiet_hours · weather · reminder\n   smart_home · news + 9 others\nConfigField framework: enabled / config_schema", fillcolor="#a8d88d"];
        svc_notif   [label="NotificationService\n← thermal.temp / perception.faces\n← av.speaking_started / av.spoke\n→ av.say (thermal alerts, absence alerts)\nrate-limited · quiet-hours aware", fillcolor="#a8d88d"];
        svc_room    [label="RoomService\n← room.set\n→ room.updated / av.say\npersists room name · visual scene\nbaseline histogram · sustained\ndivergence detection → TTS prompt", fillcolor="#a8d88d"];
    }

    // ─────────────────────────────────────────────────────────────────
    // External
    // ─────────────────────────────────────────────────────────────────
    subgraph cluster_ext {
        label="External processes";
        style="filled,rounded";
        fillcolor="#fff7c2";
        fontsize=11;

        ext_cli [label="scripts/desktop-assistant\n(CLI: ping / status / pan / say / watch / ...)", fillcolor="#ffe375"];
        ext_web [label="Web Browser\nhttp://<pi>:8080", fillcolor="#ffe375"];
        ext_3p  [label="3rd-party subscribers\n(dashboards, future ML pipelines)", fillcolor="#ffe375", style="rounded,filled,dashed"];
        ext_db  [label="~/.local/share/desktop-assistant/\ntelemetry.db (SQLite ring)\nfaces.db (identity registry)\nthumbs/ (64×64 JPEG face crops)", fillcolor="#ffe375"];
    }

    // ─────────────────────────────────────────────────────────────────
    // Edges — hardware → drivers
    // ─────────────────────────────────────────────────────────────────
    hw_tmp117 -> drv_tmp117 [label="I²C"];
    hw_fan    -> drv_fan    [label="PWM"];
    hw_fan    -> drv_tach   [label="tach"];
    hw_servo  -> drv_servo  [label="I²C/PWM"];
    hw_cam    -> drv_cam    [label="CSI"];
    hw_mic    -> drv_ain    [label="USB"];
    hw_spk    -> drv_aout   [label="USB"];
    hw_hailo  -> drv_hailo  [label="PCIe"];

    drv_hailo -> drv_facedet;
    drv_hailo -> drv_objdet;

    drv_tmp117 -> drv_thmgr;
    drv_fan    -> drv_thmgr;
    drv_tach   -> drv_thmgr;
    drv_tts    -> drv_aout  [style=dashed, label="renders to"];
    drv_van    -> drv_tts;
    drv_van    -> core_ver  [style=dashed];

    // ─────────────────────────────────────────────────────────────────
    // Drivers → services
    // ─────────────────────────────────────────────────────────────────
    drv_thmgr -> svc_thermal;
    drv_servo -> svc_motion;
    drv_facedet -> svc_perception;
    drv_objdet  -> svc_object;
    drv_cam   -> svc_vision;
    drv_ain   -> svc_audio;
    drv_aout  -> svc_av;
    drv_tts   -> svc_av;
    drv_van   -> svc_av;

    // ─────────────────────────────────────────────────────────────────
    // Services ↔ bus
    // ─────────────────────────────────────────────────────────────────
    svc_thermal -> thermal_bus [color="#cc3333"];
    thermal_bus -> svc_thermal_ipc [color="#cc3333"];
    svc_thermal_ipc -> svc_ipc [label="ZMQ PUB→SUB\n(cross-process)", color="#aa6600", style=bold];
    svc_ipc -> core_bus [color="#226622", label="re-emit"];

    core_bus -> svc_motion  [color="#226622"];
    svc_motion -> core_bus  [color="#226622"];
    core_bus -> svc_vision  [color="#226622"];
    svc_vision -> core_bus  [color="#226622"];
    core_bus -> svc_audio   [color="#226622"];
    svc_audio -> core_bus   [color="#226622"];
    core_bus -> svc_voice   [color="#226622"];
    svc_voice -> core_bus   [color="#226622"];
    svc_audio -> svc_voice  [label="latest_chunk() + chunk_index()", style=dashed, color="#888888"];
    core_bus -> svc_av      [color="#226622"];
    svc_av   -> core_bus    [color="#226622"];
    core_bus -> svc_perception [color="#226622"];
    svc_perception -> core_bus [color="#226622"];
    svc_vision -> svc_perception [label="latest_frame()", style=dashed, color="#888888"];
    core_bus -> svc_telemetry [color="#226622"];
    svc_telemetry -> core_bus [color="#226622"];
    core_bus -> svc_ipc     [color="#226622"];
    svc_ipc  -> core_bus    [color="#226622"];
    core_bus -> svc_face    [color="#226622"];
    svc_face -> core_bus    [color="#226622"];
    core_bus -> svc_track   [color="#226622"];
    svc_track -> core_bus   [color="#226622"];
    core_bus -> svc_web     [color="#226622"];
    svc_vision -> svc_web   [label="latest_frame()", style=dashed, color="#888888"];
    core_bus -> svc_clock   [color="#226622"];
    svc_clock -> core_bus   [color="#226622"];
    core_bus -> svc_object  [color="#226622"];
    svc_object -> core_bus  [color="#226622"];
    svc_vision -> svc_object [label="latest_frame()", style=dashed, color="#888888"];
    core_bus -> svc_music   [color="#226622"];
    svc_music -> core_bus   [color="#226622"];
    core_bus -> svc_podcast [color="#226622"];
    svc_podcast -> core_bus [color="#226622"];
    core_bus -> svc_skills  [color="#226622"];
    svc_skills -> core_bus  [color="#226622"];
    core_bus -> svc_notif   [color="#226622"];
    svc_notif -> core_bus   [color="#226622"];
    core_bus -> svc_room    [color="#226622"];
    svc_room -> core_bus    [color="#226622"];
    svc_vision -> svc_room  [label="latest_frame()", style=dashed, color="#888888"];

    core_qh -> svc_clock    [label="suppresses\nannouncements", style=dashed, color="#888888"];
    core_qh -> svc_face     [label="suppresses\ngreetings",     style=dashed, color="#888888"];
    core_qh -> svc_web      [label="config R/W",               style=dashed, color="#888888"];
    core_qh -> svc_notif    [label="suppresses\nalerts",        style=dashed, color="#888888"];

    svc_thermal -> core_svc [style=dotted, label="extends"];
    svc_thermal_ipc -> core_svc [style=dotted];
    svc_motion  -> core_svc [style=dotted];
    svc_vision  -> core_svc [style=dotted];
    svc_audio   -> core_svc [style=dotted];
    svc_voice   -> core_svc [style=dotted];
    svc_av      -> core_svc [style=dotted];
    svc_perception -> core_svc [style=dotted];
    svc_telemetry -> core_svc [style=dotted];
    svc_ipc     -> core_svc [style=dotted];
    svc_face    -> core_svc [style=dotted];
    svc_track   -> core_svc [style=dotted];
    svc_clock   -> core_svc [style=dotted];
    svc_object  -> core_svc [style=dotted];
    svc_music   -> core_svc [style=dotted];
    svc_podcast -> core_svc [style=dotted];
    svc_skills  -> core_svc [style=dotted];
    svc_notif   -> core_svc [style=dotted];
    svc_room    -> core_svc [style=dotted];
    // (WebService does not extend Service base class)

    // ─────────────────────────────────────────────────────────────────
    // External
    // ─────────────────────────────────────────────────────────────────
    ext_cli -> svc_ipc [label="ZMQ REQ/SUB", color="#aa6600"];
    ext_3p  -> svc_ipc [label="ZMQ SUB",     color="#aa6600", style=dashed];
    ext_web -> svc_web [label="HTTP/WS :8080", color="#aa6600"];
    svc_telemetry -> ext_db [label="writes telemetry.db", color="#aa6600"];
    svc_perception -> ext_db [label="writes faces.db", color="#aa6600", style=dashed];

    // ─────────────────────────────────────────────────────────────────
    // Boot ordering
    // ─────────────────────────────────────────────────────────────────
    {rank=same; svc_thermal; svc_motion; svc_vision; svc_audio; svc_voice; svc_av; svc_perception; svc_telemetry; svc_ipc; svc_face; svc_track; svc_web; svc_clock; svc_object; svc_music; svc_podcast; svc_skills; svc_notif;}
}
