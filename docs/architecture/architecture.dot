// VERA — System Architecture
//
// This file is the source of truth for docs/architecture/architecture.pdf.
// Regenerate with:  bash docs/architecture/build.sh
//
// Per agent imperative #7: this diagram MUST be updated whenever a service,
// driver, hardware item, or topic is added/removed/renamed.

digraph VERA {
    rankdir=TB;
    splines=true;
    nodesep=0.4;
    ranksep=0.6;
    fontname="Helvetica";
    labelloc="t";
    label=<<b>VERA — Vision-Enabled Reasoning Agent — System Architecture</b><br/><font point-size="10">v1.92.0 — Web UI: display unit systems, eye labels, thermal in Engineering</font>>;
    fontsize=16;

    node  [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=10, margin=0.15];
    edge  [fontname="Helvetica", fontsize=8, color="#555555"];

    subgraph cluster_matter {
        label="Optional Matter processes (systemd user services, Node.js 24)";
        style="filled,rounded";
        fillcolor="#e4f4e4";
        matter_controller [label="vera-matter-controller\nOHF matter-server\nlocal dashboard/WS 127.0.0.1:5580", fillcolor="#b4ddb4"];
        matter_bridge [label="vera-matter-bridge\nsrc/matter/bridge.mjs\nVERA Audio Mute, UDP 5541", fillcolor="#b4ddb4"];
        matter_state [label="~/.local/share/vera-matter\nseparate controller + bridge fabrics\nprivate persistent credentials", fillcolor="#b4ddb4"];
        matter_devices [label="Tapo P316M / Matter Wi-Fi devices\nnative multi-admin sharing", fillcolor="#ffd6a5"];
        matter_google [label="Google Home Matter controller", fillcolor="#d6eaff"];
        matter_controller -> matter_devices [label="Matter / IPv6 LAN"];
        matter_google -> matter_devices [label="independent Matter fabric"];
        matter_google -> matter_bridge [label="Matter / IPv6 LAN"];
        matter_bridge -> svc_web [label="loopback GET/PUT /api/audio/mute"];
        svc_web -> svc_media_ipc [label="strict music.get_muted / set_muted RPC", style=dashed];
        matter_controller -> matter_state;
        matter_bridge -> matter_state;
    }

    subgraph cluster_updater {
        label="Root-owned deployment controller (separate from VERA)";
        style="filled,rounded";
        fillcolor="#e4f4e4";
        update_github [label="GitHub stable releases\nmazum01/desktop-assistant\nHTTPS, exact tag/commit", fillcolor="#b4ddb4"];
        update_timer [label="vera-updater.timer\nvera-updater-check.service\nlocal-time installation window", fillcolor="#b4ddb4"];
        update_runner [label="vera-updater.service\n/opt/vera-updater/src/updater\nstage / deploy / verify / recover", fillcolor="#b4ddb4"];
        update_state [label="/var/lib/vera-updater\nprotected backups + transaction state\npost-reboot continuation", fillcolor="#b4ddb4"];
        update_controls [label="vera update + authenticated System GUI\n/run/vera-updater/control.sock\npeer-checked fixed operations", fillcolor="#b4ddb4"];
        update_ready [label="deployment.readiness RPC\nloaded version/revision/PID\nfresh telemetry + service/hardware health", fillcolor="#b4ddb4"];
        update_timer -> update_runner;
        update_controls -> update_runner [label="local Unix socket"];
        update_runner -> update_github [label="manifest + verified assets"];
        update_runner -> update_state [label="atomic journal"];
        update_runner -> update_ready [label="ZeroMQ IPC"];
        update_runner -> hw_fan [label="verified full-duty kernel PWM\nbefore thermal restart"];
    }

    // ─────────────────────────────────────────────────────────────────
    // Hardware layer
    // ─────────────────────────────────────────────────────────────────
    subgraph cluster_hw {
        label="Hardware (Raspberry Pi 5)";
        style="filled,rounded";
        fillcolor="#f5e9d8";
        fontsize=11;

        hw_tmp117  [label="TMP117\n(VERA3, I²C 0x48)", fillcolor="#ffd6a5"];
        hw_tmp102  [label="TMP102\n(VERA, I²C 0x48)", fillcolor="#ffd6a5"];
        hw_fan     [label="NF-A6x25 PWM Fan\nPWM ← GPIO13 (kernel HW PWM, 25 kHz)\nTACH → GPIO6 (2 ppr)", fillcolor="#ffd6a5"];
        hw_servo   [label="Pan servo + optional tilt\nPCA9685 configurable channels\n180deg direct-drive / legacy DS3218\nconfigured safe travel limits", fillcolor="#ffd6a5"];
        hw_cam     [label="Pi Cam Module 3 Wide\n(CSI-0)", fillcolor="#ffd6a5"];
        hw_mic     [label="reSpeaker XVF3800\n(USB mic array)",        fillcolor="#ffd6a5"];
        hw_spk     [label="reSpeaker XVF3800 output →\nattached speaker", fillcolor="#ffd6a5"];
        hw_hailo   [label="Hailo AI Accelerator\n(Hailo-8 / Hailo-10H, PCIe)",  fillcolor="#ffd6a5"];
        hw_display [label="Waveshare ESP32-S3-Touch-LCD-1.47\n172×320 SPI TFT (touch disabled)\n(BLE mouth/status display + BLE OTA)\nC6 touch + legacy profiles supported", fillcolor="#ffd6a5"];
        hw_display_sd [label="Display microSD (S3)\n/videos/*.mjpg or *.mjpeg\nbaseline JPEG streams, no audio", fillcolor="#ffd6a5"];
        hw_display_imu [label="Optional QMI8658 (identity-probed)\nnot specified on S3 hardware\nroll/pitch/relative yaw, no compass", fillcolor="#ffd6a5"];
    }

    // ─────────────────────────────────────────────────────────────────
    // Driver layer (src/...)
    // ─────────────────────────────────────────────────────────────────
    subgraph cluster_drv {
        label="Drivers (src/)";
        style="filled,rounded";
        fillcolor="#dfeefc";
        fontsize=11;

        drv_tmp117 [label="thermal/tmp117.py",          fillcolor="#a5c8ff"];
        drv_temp   [label="thermal/temperature_sensor.py\n(probes TMP117 / TMP102)", fillcolor="#a5c8ff"];
        drv_fan    [label="thermal/fan.py\n(sysfs HW PWM\n+ lgpio fallback)", fillcolor="#a5c8ff"];
        drv_tach   [label="thermal/fan_tach.py\n(lgpio edge cb)", fillcolor="#a5c8ff"];
        drv_thmgr  [label="thermal/thermal_manager.py", fillcolor="#a5c8ff"];
        drv_hailotemp [label="thermal/hailo_temp.py\n(Hailo die temp via HailoRT control,\nmonitor only)", fillcolor="#a5c8ff"];
        drv_servo  [label="motion/servo_controller.py", fillcolor="#a5c8ff"];
        drv_visual [label="motion/visual_servo.py (optional controller)\nstable target lock + damped visual feedback\nidentified camera/servo Jacobian\nconfig/tracking_calibration.json (local)", fillcolor="#a5c8ff"];
        drv_legacy [label="motion/head_tracker.py (original body)\nlegacy Kalman + minimum-jerk pan tracking\nnew-body idle motion controller", fillcolor="#a5c8ff"];
        drv_gaze   [label="motion/gaze_tracker.py (new body default)\nworld-bearing Kalman + minimum-jerk pan/tilt\nsmooth pursuit · fixation hold · saccadic suppression", fillcolor="#a5c8ff"];
        body_profile [label="core/body.py\nconfig/body.yaml (machine-local identity/tuning)\nconfig/body_profiles.yaml (hardware/controller)\nbody-tagged runtime servo geometry", fillcolor="#a5c8ff"];
        drv_cam    [label="vision/camera.py\n(picamera2)", fillcolor="#a5c8ff"];
        drv_aout   [label="audio/output.py",            fillcolor="#a5c8ff"];
        drv_ain    [label="audio/input.py",             fillcolor="#a5c8ff"];
        drv_tts    [label="audio/tts.py\n(espeak-ng)",  fillcolor="#a5c8ff"];
        drv_van    [label="audio/version_announcer.py", fillcolor="#a5c8ff"];
        drv_hailo  [label="perception/hailo_inference.py\n(VStreams + InferModel API)",  fillcolor="#a5c8ff"];
        drv_models [label="perception/hailo_models.py\nconfig/hailo/models.yaml\nprobe / select / download HEFs\npython3 -m ...hailo_models --install", fillcolor="#a5c8ff"];
        drv_facedet [label="perception/face_detector.py\n(SCRFD decode + Haar fallback)", fillcolor="#a5c8ff"];
        drv_objdet  [label="perception/object_detector.py\n(YOLOv11l on-chip NMS; YOLO26m+ONNX H8 fallback)", fillcolor="#a5c8ff"];
    }

    // ─────────────────────────────────────────────────────────────────
    // Core
    // ─────────────────────────────────────────────────────────────────
    subgraph cluster_core {
        label="Core (src/core/)";
        style="filled,rounded";
        fillcolor="#e7e3fb";
        fontsize=11;

        core_bus     [label="core MessageBus\n(in-process pub/sub)", fillcolor="#bdb1f5"];
        thermal_bus  [label="thermal MessageBus\n(in-process pub/sub)", fillcolor="#bdb1f5"];
        media_bus    [label="media MessageBus\n(in-process pub/sub)", fillcolor="#bdb1f5"];
        core_svc     [label="Service base\n(start/tick/stop)",  fillcolor="#bdb1f5"];
        core_ver     [label="version.py\n(reads /VERSION)",     fillcolor="#bdb1f5"];
        core_qh      [label="QuietHours\n(enabled / start / end\nloaded from config/quiet_hours.yaml)", fillcolor="#bdb1f5"];
    }

    // ─────────────────────────────────────────────────────────────────
    // Services
    // ─────────────────────────────────────────────────────────────────
    subgraph cluster_svc_thermal {
        label="systemd: desktop-assistant-thermal.service";
        style="filled,rounded";
        fillcolor="#fde0e0";
        fontsize=11;

        svc_thermal [label="ThermalService\n— thermal.temp\n— thermal.fan\n— thermal.rpm\n— thermal.critical\n— thermal.error\n— thermal.hailo", fillcolor="#f4a3a3"];
        svc_thermal_ipc [label="IPCBridge (thermal)\nPUB ipc:///tmp/desktop-assistant-thermal.pub\nREP ipc:///tmp/desktop-assistant-thermal.rep", fillcolor="#f4a3a3"];
    }

    subgraph cluster_svc_media {
        label="systemd: desktop-assistant-media.service\n(Phase 1 process split — see\ndocs/architecture/PROCESS_ISOLATION_PROPOSAL.md)";
        style="filled,rounded";
        fillcolor="#d8e8f5";
        fontsize=11;

        svc_music   [label="MusicService\n← music.play / stop / pause / next\n← music.thumbs_up / thumbs_down / set_volume\nPandora / audio playback", fillcolor="#9cc4e8"];
        svc_podcast [label="PodcastService\nApple Podcasts search + RSS subscriptions\n← podcast.play/pause/resume/stop/refresh\n→ podcast.playback / subscriptions_updated", fillcolor="#9cc4e8"];
        svc_media_ipc [label="IPCBridge (media)\nPUB ipc:///tmp/desktop-assistant-media.pub\nREP ipc:///tmp/desktop-assistant-media.rep\nSUB ← core.pub (upstream)\nRPCs: music.get_state/set_volume/…\npodcast.search/subscribe/play/…", fillcolor="#9cc4e8"];
    }

    subgraph cluster_svc_core {
        label="systemd: desktop-assistant-core.service";
        style="filled,rounded";
        fillcolor="#e2f5d8";
        fontsize=11;

        svc_motion  [label="MotionService\nshared PCA9685, independent pan / tilt\n50Hz bounded quintic profiles\n← motion.pan_to / tilt_to / center / relax / stop\n← motion.calibration_lock (expiring lease)\n← motion.set_channels / set_limits / set_tilt_limits\n→ motion.position / moved / settings / error\n→ motion.channels_changed / limits_changed / tilt_limits_changed\nRPC motion.get_status / motion.set_channels", fillcolor="#a8d88d"];
        svc_vision  [label="VisionService / RawCameraService\n→ vision.frame_ready / vision.frame2_ready\n← vision.capture_still\nRPC vision.get_focus / set_focus\nRPC camera2.get_focus / set_focus\nWeb: GET|PUT /api/settings/camera{,2}/focus\nper-device persisted AF / manual diopters\n+ latest_frame()",        fillcolor="#a8d88d"];
        svc_audio   [label="AudioCaptureService\n→ audio.level / chunk\n+ latest_chunk()",                          fillcolor="#a8d88d"];
        svc_voice   [label="VoiceCommandService\n← audio stream/VAD\n→ voice.state / wake / transcript / intent\n→ av.utterance (routed transcript)\nwake-window + dialog context", fillcolor="#a8d88d"];
        svc_av      [label="AVService\n← av.say / beep / utterance / announce_version\n→ av.spoke / av.speaking_started / version_announced", fillcolor="#a8d88d"];
        svc_display [label="DisplayService\n← system.startup_status / service.started / *.error\n← display.spectrum / av.speaking_started / av.spoke\n← display.video (list/play/stop/status)\n→ display.status / display.error / display.reply\n→ display.reply.<request_id> / display.device_event\n→ display.spectrum_latency (audio→BLE→ack timing)\nBLE command writes (MTU; eq frames write-without-response)", fillcolor="#a8d88d"];
        fw_display [label="Arduino firmware\nfirmware/vera_display\n(ESP32-S3 process boundary; C6 profiles retained)\nsd_video + JPEGDEC / orientation fusion\nmain-loop queue + reserved angle footer\nNimBLEOta service (BLE OTA, 0x8018)", fillcolor="#a8d88d"];
        svc_perception [label="PerceptionService\n← vision.frame_ready\n→ perception.faces / perception.error\n+ FaceEmbedder (ArcFace) + FaceRegistry", fillcolor="#a8d88d"];
        svc_spectrum [label="PlaybackSpectrumService\n← music.state_changed / podcast.playback\npw-record on DA EQ sink monitor (pre sync-delay) + FFT\n→ display.spectrum\n← display.spectrum_latency → AvSyncCalibrator\npw-cli set-param EQ sync_delay (A/V sync)", fillcolor="#a8d88d"];
        svc_telemetry [label="TelemetryService\n← thermal.* / motion.position / audio.level\n→ telemetry.flush\nSQLite ring buffer", fillcolor="#a8d88d"];
        svc_ipc     [label="IPCBridge (core)\nPUB ipc:///tmp/desktop-assistant.pub\nREP ipc:///tmp/desktop-assistant.rep\nSUB ← thermal.pub (upstream)\ncmds: ping / topics / last / publish / status", fillcolor="#a8d88d"];
        svc_face    [label="FaceService\n← perception.faces / face.meet\n→ av.say (greetings)\n→ face.identified\ncooldown-based re-greet", fillcolor="#a8d88d"];
        svc_track   [label="TrackingService (body-selected controller)\noriginal: legacy Kalman/minimum-jerk pan only\nnew: gaze (Kalman bearing) pan/tilt; visual_servo optional\n← perception.faces / perception.objects (fresh persons)\n← object.enabled_changed (person-seek gate)\n← motion.position / settings / limits_changed\nEnabled + ready servos required\nRecognized / largest face; 1s loss handoff\nLargest person + 15% stability margin\n→ motion.pan_to / tilt_to (new body only)\n← tracking.start_autotune / cancel_autotune (visual_servo)\n→ motion.calibration_lock / av.say\n← av.spoke (announce before probes)\n→ tracking.debug / autotune_progress / autotune_done\nTilt: travel limits and center +/-20deg\nindependent random idle pan · speaking nod", fillcolor="#a8d88d"];
        svc_web     [label="WebService (FastAPI)\nGET / — dashboard SPA (hash routes, ES modules)\nGET /stream — MJPEG 640×360 feed\nWS /ws — live JSON status\nGET /api/faces — list (has_thumb flag)\nGET /api/skills — registered skills\nGET /api/faces/{id}/thumb — face JPEG\nPUT /api/faces/{id} — rename\nDEL /api/faces/{id} — delete one\nDEL /api/faces — delete all\nGET|PUT /api/settings/quiet-hours\nGET|PUT /api/settings/units (display_units.json)\nGET|PUT /api/settings/audio\nGET|PUT /api/settings/voice\nGET|PUT /api/settings/servo/channels\nPUT /api/settings/servo/tilt-limits\nGET|PUT /api/room\nGET|PUT /api/music/* — proxied via IPCClient\nGET|POST /api/podcasts/* — proxied via IPCClient\nPOST /api/say|pan|tilt|version|utterance\nport 8080", fillcolor="#a8d88d"];
        svc_clock   [label="ClockService\n+ ClockAnnouncer\n→ av.say (hourly/half-hourly)\nrespects QuietHours", fillcolor="#a8d88d"];
        svc_object  [label="ObjectService\n← vision.frame_ready / object.set_enabled\n← perception.faces (selective label association)\n→ perception.objects (held overlays + fresh persons)\n→ object.enabled_changed (startup + changes)\n2fps · overlay max_objects cap · BGR→RGB fix", fillcolor="#a8d88d"];
        svc_mono [label="MonoDepthService\nscdepthv3 on Hailo-8 / Hailo-10H\n→ vision.mono_depth_map\nrelative 320×256 depth, 3 Hz", fillcolor="#a8d88d"];
        svc_skills  [label="SkillsService\n← av.utterance / thermal.temp / thermal.hailo\n→ av.say / vision.describe / av.tell_joke\n→ face.meet / motion.pan_to / music.*\n→ object.set_enabled / music.set_volume\n→ tracking.set_face_tracking\nSkillRegistry — first-match dispatch\n17 skills: help · system_status · volume\n   quiet_hours · weather · reminder\n   smart_home · news + 9 others\nConfigField framework: enabled / config_schema", fillcolor="#a8d88d"];
        svc_notif   [label="NotificationService\n← thermal.temp / thermal.hailo / perception.faces\n← av.speaking_started / av.spoke\n→ av.say (thermal, Hailo, absence alerts)\nrate-limited · quiet-hours aware", fillcolor="#a8d88d"];
        svc_room    [label="RoomService\n← room.set\n→ room.updated / av.say\npersists room name · visual scene\nbaseline histogram · sustained\ndivergence detection → TTS prompt", fillcolor="#a8d88d"];
    }

    // ─────────────────────────────────────────────────────────────────
    // External
    // ─────────────────────────────────────────────────────────────────
    subgraph cluster_ext {
        label="External processes";
        style="filled,rounded";
        fillcolor="#fff7c2";
        fontsize=11;

        ext_cli [label="scripts/desktop-assistant\nCLI: ping / status / pan / say / watch / ...\ndisplay video list/play/stop/status\nwaits for correlated device reply", fillcolor="#ffe375"];
        ext_web [label="Web Browser\nhttp://<pi>:8080", fillcolor="#ffe375"];
        ext_3p  [label="3rd-party subscribers\n(dashboards, future ML pipelines)", fillcolor="#ffe375", style="rounded,filled,dashed"];
        ext_db  [label="~/.local/share/desktop-assistant/\ntelemetry.db (SQLite ring)\nfaces.db (identity registry)\nthumbs/ (64×64 JPEG face crops)", fillcolor="#ffe375"];
        ext_ota [label="firmware/upload_esp32_display_ble.sh\n+ nimbleota.py uploader\n(BLE firmware push, no USB)", fillcolor="#ffe375"];
    }

    // ─────────────────────────────────────────────────────────────────
    // Edges — hardware → drivers
    // ─────────────────────────────────────────────────────────────────
    hw_tmp117 -> drv_tmp117 [label="I²C"];
    hw_tmp102 -> drv_temp   [label="I²C"];
    drv_tmp117 -> drv_temp  [label="TMP117 ID"];
    hw_fan    -> drv_fan    [label="PWM"];
    hw_fan    -> drv_tach   [label="tach"];
    hw_servo  -> drv_servo  [label="I²C/PWM"];
    hw_cam    -> drv_cam    [label="CSI"];
    hw_mic    -> drv_ain    [label="USB"];
    hw_spk    -> drv_aout   [label="USB"];
    hw_hailo  -> drv_hailo  [label="PCIe"];
    hw_display -> fw_display [label="SPI + GPIO", color="#aa6600"];
    svc_display -> fw_display [label="BLE GATT\nstatus / mouth / eq / video", color="#aa6600"];
    fw_display -> svc_display [label="BLE notifications\nreplies / playback events / IMU status", color="#aa6600"];
    hw_display_sd -> fw_display [label="SD_MMC 1-bit\nCLK16/CMD15/D0=17", color="#aa6600"];
    hw_display_imu -> fw_display [label="I2C 0x6A/0x6B\nidentity + checked samples", color="#aa6600"];
    ext_ota -> fw_display [label="BLE GATT (OTA)", color="#aa6600", style="dashed"];

    drv_hailo -> drv_facedet;
    drv_hailo -> drv_objdet;
    drv_models -> drv_facedet [label="matched SCRFD HEF"];
    drv_models -> svc_perception [label="matched ArcFace HEF"];
    drv_models -> svc_mono [label="matched depth HEF"];
    drv_hailo -> svc_mono;
    svc_vision -> svc_mono [label="latest_frame()"];
    svc_mono -> svc_web [label="vision.mono_depth_map"];

    drv_temp   -> drv_thmgr;
    drv_fan    -> drv_thmgr;
    drv_tach   -> drv_thmgr;
    drv_tts    -> drv_aout  [style=dashed, label="renders to"];
    drv_van    -> drv_tts;
    drv_van    -> core_ver  [style=dashed];

    // ─────────────────────────────────────────────────────────────────
    // Drivers → services
    // ─────────────────────────────────────────────────────────────────
    drv_thmgr -> svc_thermal;
    hw_hailo -> drv_hailotemp [label="PCIe control\n(temp only)", style=dashed];
    drv_hailotemp -> svc_thermal;
    drv_servo -> svc_motion;
    drv_visual -> svc_track;
    drv_legacy -> svc_track;
    drv_gaze -> svc_track;
    body_profile -> svc_motion [label="wiring, range, limits, tilt capability"];
    body_profile -> svc_track [label="controller and mount direction"];
    drv_facedet -> svc_perception;
    drv_objdet  -> svc_object;
    drv_cam   -> svc_vision;
    drv_ain   -> svc_audio;
    drv_aout  -> svc_av;
    drv_tts   -> svc_av;
    drv_van   -> svc_av;

    // ─────────────────────────────────────────────────────────────────
    // Services ↔ bus
    // ─────────────────────────────────────────────────────────────────
    svc_thermal -> thermal_bus [color="#cc3333"];
    thermal_bus -> svc_thermal_ipc [color="#cc3333"];
    svc_thermal_ipc -> svc_ipc [label="ZMQ PUB→SUB\n(cross-process)", color="#aa6600", style=bold];
    svc_ipc -> core_bus [color="#226622", label="re-emit"];

    svc_music -> media_bus [color="#3355aa"];
    media_bus -> svc_music [color="#3355aa"];
    svc_podcast -> media_bus [color="#3355aa"];
    media_bus -> svc_podcast [color="#3355aa"];
    media_bus -> svc_media_ipc [color="#3355aa"];
    svc_media_ipc -> media_bus [color="#3355aa"];
    // Bidirectional cross-process forwarding (unlike thermal, which is
    // one-way): media needs core's music.*/podcast.* commands (published
    // by skills/CLI/WebService), and core needs media's state-change
    // events (music.state_changed, podcast.playback, av.say, …).
    svc_media_ipc -> svc_ipc [label="ZMQ PUB→SUB\n(cross-process)", color="#aa6600", style=bold];
    svc_ipc -> svc_media_ipc [label="ZMQ PUB→SUB\n(cross-process)", color="#aa6600", style=bold];

    core_bus -> svc_motion  [color="#226622"];
    svc_motion -> core_bus  [color="#226622"];
    core_bus -> svc_vision  [color="#226622"];
    svc_vision -> core_bus  [color="#226622"];
    core_bus -> svc_audio   [color="#226622"];
    svc_audio -> core_bus   [color="#226622"];
    core_bus -> svc_voice   [color="#226622"];
    svc_voice -> core_bus   [color="#226622"];
    svc_audio -> svc_voice  [label="latest_chunk() + chunk_index()", style=dashed, color="#888888"];
    core_bus -> svc_av      [color="#226622"];
    svc_av   -> core_bus    [color="#226622"];
    core_bus -> svc_spectrum [color="#226622"];
    svc_spectrum -> core_bus [color="#226622"];
    core_bus -> svc_display [color="#226622"];
    svc_display -> core_bus [color="#226622"];
    core_bus -> svc_perception [color="#226622"];
    svc_perception -> core_bus [color="#226622"];
    svc_vision -> svc_perception [label="latest_frame()", style=dashed, color="#888888"];
    core_bus -> svc_telemetry [color="#226622"];
    svc_telemetry -> core_bus [color="#226622"];
    core_bus -> svc_ipc     [color="#226622"];
    svc_ipc  -> core_bus    [color="#226622"];
    core_bus -> svc_face    [color="#226622"];
    svc_face -> core_bus    [color="#226622"];
    core_bus -> svc_track   [color="#226622"];
    svc_track -> core_bus   [color="#226622"];
    core_bus -> svc_web     [color="#226622"];
    svc_vision -> svc_web   [label="latest_frame()", style=dashed, color="#888888"];
    core_bus -> svc_clock   [color="#226622"];
    svc_clock -> core_bus   [color="#226622"];
    core_bus -> svc_object  [color="#226622"];
    svc_object -> core_bus  [color="#226622"];
    svc_vision -> svc_object [label="latest_observation()", style=dashed, color="#888888"];
    svc_web -> svc_media_ipc [label="IPCClient RPC\n(music/podcast reads+actions)", style=dashed, color="#3355aa"];
    core_bus -> svc_skills  [color="#226622"];
    svc_skills -> core_bus  [color="#226622"];
    core_bus -> svc_notif   [color="#226622"];
    svc_notif -> core_bus   [color="#226622"];
    core_bus -> svc_room    [color="#226622"];
    svc_room -> core_bus    [color="#226622"];
    svc_vision -> svc_room  [label="latest_frame()", style=dashed, color="#888888"];

    core_qh -> svc_clock    [label="suppresses\nannouncements", style=dashed, color="#888888"];
    core_qh -> svc_face     [label="suppresses\ngreetings",     style=dashed, color="#888888"];
    core_qh -> svc_web      [label="config R/W",               style=dashed, color="#888888"];
    core_qh -> svc_notif    [label="suppresses\nalerts",        style=dashed, color="#888888"];

    svc_thermal -> core_svc [style=dotted, label="extends"];
    svc_thermal_ipc -> core_svc [style=dotted];
    svc_motion  -> core_svc [style=dotted];
    svc_vision  -> core_svc [style=dotted];
    svc_audio   -> core_svc [style=dotted];
    svc_voice   -> core_svc [style=dotted];
    svc_av      -> core_svc [style=dotted];
    svc_display -> core_svc [style=dotted];
    svc_spectrum -> core_svc [style=dotted];
    svc_perception -> core_svc [style=dotted];
    svc_telemetry -> core_svc [style=dotted];
    svc_ipc     -> core_svc [style=dotted];
    svc_face    -> core_svc [style=dotted];
    svc_track   -> core_svc [style=dotted];
    svc_clock   -> core_svc [style=dotted];
    svc_object  -> core_svc [style=dotted];
    svc_music   -> core_svc [style=dotted];
    svc_podcast -> core_svc [style=dotted];
    svc_skills  -> core_svc [style=dotted];
    svc_notif   -> core_svc [style=dotted];
    svc_room    -> core_svc [style=dotted];
    svc_media_ipc -> core_svc [style=dotted];
    // (WebService does not extend Service base class)

    // ─────────────────────────────────────────────────────────────────
    // External
    // ─────────────────────────────────────────────────────────────────
    ext_cli -> svc_ipc [label="ZMQ REQ/SUB", color="#aa6600"];
    ext_3p  -> svc_ipc [label="ZMQ SUB",     color="#aa6600", style=dashed];
    ext_web -> svc_web [label="HTTP/WS :8080", color="#aa6600"];
    svc_telemetry -> ext_db [label="writes telemetry.db", color="#aa6600"];
    svc_perception -> ext_db [label="writes faces.db", color="#aa6600", style=dashed];

    // ─────────────────────────────────────────────────────────────────
    // Boot ordering
    // ─────────────────────────────────────────────────────────────────
    {rank=same; svc_thermal; svc_motion; svc_vision; svc_audio; svc_voice; svc_av; svc_display; svc_spectrum; svc_perception; svc_telemetry; svc_ipc; svc_face; svc_track; svc_web; svc_clock; svc_object; svc_skills; svc_notif; svc_music; svc_podcast; svc_media_ipc;}
}
