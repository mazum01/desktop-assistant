[Unit]
Description=VERA — thermal safety service (TMP117 + fan)
Documentation=https://github.com/mazum01/desktop-assistant
After=local-fs.target
StartLimitIntervalSec=0
# Thermal is safety-critical: no Requires=, no After= on optional services.
# It must come up first and never wait on anything that can fail.

[Service]
Type=simple
User=starter
Group=starter
SupplementaryGroups=i2c gpio
WorkingDirectory=/tmp
Environment=PYTHONUNBUFFERED=1
Environment="PYTHONPATH=/home/starter/Code/Desktop Assistant"
# On Pi 5 / RP1, the standard dtoverlay cannot mux GPIO pins at boot.
# Mux GPIO13 → PWM0_CHAN1 (Alt0) before the fan controller starts.
ExecStartPre=/usr/bin/pinctrl set 13 a0
ExecStart=/usr/bin/python3 -m src.assistant.thermal_main

# Aggressive restart policy — losing this unit means the device
# can overheat. Fan driver fails-safe to 100% on its own, but we
# still want the loop back as fast as possible.
Restart=always
RestartSec=2

StandardOutput=journal
StandardError=journal

# Hardening
# Thermal is safety-critical. Keep the surface minimal but allow /tmp
# writes (lgpio chip handle, pwm sysfs symlinks resolve there on some
# kernels). PrivateTmp=false so the optional bus bridge can publish.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
PrivateTmp=false
# /tmp                         — lgpio chip handle, ZMQ sockets
# /sys/devices/platform/axi/…  — real sysfs PWM device path (symlink via /sys/class/pwm
#                                 is not followed reliably under ProtectSystem=strict)
# WorkingDirectory              — lgpio creates .lgd-nfy0 notification pipe here;
#                                 needs chmod permission so callbacks (tach) work
ReadWritePaths=/tmp \
    /sys/devices/platform/axi/1000120000.pcie/1f00098000.pwm

[Install]
WantedBy=multi-user.target
