[Unit]
Description=OpenClaw AI Gateway — Telegram / Claude interface
Documentation=https://github.com/mazum01/desktop-assistant
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=starter
Group=starter
WorkingDirectory=/home/starter
Environment=HOME=/home/starter

# Use the nvm-managed node that OpenClaw was installed into
ExecStart=/home/starter/.nvm/versions/node/v24.15.0/bin/node \
    /home/starter/.nvm/versions/node/v24.15.0/lib/node_modules/openclaw/dist/index.js \
    gateway --port 18789

Restart=on-failure
RestartSec=5
StartLimitIntervalSec=120
StartLimitBurst=5

StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
