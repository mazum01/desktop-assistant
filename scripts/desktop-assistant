    """Show the current room VERA is in."""
    r = _request({"cmd": "last", "topic": "room.updated"})
    payload = r.get("payload") or {}
    name = payload.get("name") if isinstance(payload, dict) else None
    if name:
        print(f"Current room: {name}")
    else:
        print("Room not set. Use: vera room set <name>")
    return 0


