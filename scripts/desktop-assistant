def cmd_face_tracking_status(_args) -> int:
    from pathlib import Path
    import yaml as _yaml
    _base = Path(__file__).resolve().parents[1]
    _rt = {}
    try:
        p = _base / "config" / "runtime_state.yaml"
        _rt = _yaml.safe_load(p.read_text()) or {} if p.exists() else {}
    except Exception:
        pass
    _cfg = {}
    try:
        p2 = _base / "config" / "assistant.yaml"
        _cfg = _yaml.safe_load(p2.read_text()) or {} if p2.exists() else {}
    except Exception:
        pass
    enabled = _rt.get("head_tracking", {}).get(
        "face_tracking_enabled",
        _cfg.get("head_tracking", {}).get("face_tracking_enabled", True),
    )
    print(f"Face tracking: {'enabled' if enabled else 'disabled'}")
    return 0


