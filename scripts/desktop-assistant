def cmd_servo_status(_args) -> int:
    from pathlib import Path
    import yaml as _yaml

    _base = Path(__file__).resolve().parents[1]
    _cfg_path = _base / "config" / "assistant.yaml"
    _rt_path  = _base / "config" / "runtime_state.yaml"

    _cfg = {}
    try:
        _cfg = _yaml.safe_load(_cfg_path.read_text()) or {} if _cfg_path.exists() else {}
    except Exception:
        pass

    _rt = {}
    try:
        _rt = _yaml.safe_load(_rt_path.read_text()) or {} if _rt_path.exists() else {}
    except Exception:
        pass

    def _flag(section, key, default=True):
        return _rt.get(section, {}).get(key, _cfg.get(section, {}).get(key, default))

    servo_enabled    = _flag("servo",        "enabled")
    face_tracking    = _flag("head_tracking","face_tracking_enabled")
    random_motion    = _flag("head_tracking","random_motion_enabled")
    soft_min_deg     = _flag("servo", "soft_min_deg", 135.0)
    soft_max_deg     = _flag("servo", "soft_max_deg", 215.0)

    pos = _request({"cmd": "last", "topic": "motion.position"})
    angle = (pos.get("payload") or {}).get("angle", "?")

    on  = "\033[32menabled\033[0m"
    off = "\033[33mdisabled\033[0m"

    print()
    print("  Servo motion :")
    print(f"    Servo enabled   : {on if servo_enabled  else off}")
    print(f"    Face tracking   : {on if face_tracking  else off}")
    print(f"    Random motion   : {on if random_motion  else off}")
    print(f"    Travel limits   : {soft_min_deg}° – {soft_max_deg}°")
    print(f"    Current angle   : {angle}°")
    print()
    return 0


def cmd_servo_limits(args) -> int:
    """Set servo travel limits (min/max logical angle)."""
    min_deg = float(args.min)
    max_deg = float(args.max)
    if min_deg < 1 or max_deg > 360 or min_deg >= max_deg:
        print("Error: min must be ≥ 1, max must be ≤ 360, and min < max.")
        return 1
    r = _request({
        "cmd": "publish",
        "topic": "motion.set_limits",
        "payload": {"min_deg": min_deg, "max_deg": max_deg},
    })
    if r.get("ok"):
        print(f"Travel limits set: {min_deg}° – {max_deg}°")
        return 0
    print(f"Error: {r}")
    return 1


