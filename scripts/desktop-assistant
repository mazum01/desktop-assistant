def cmd_forget_faces(_args) -> int:
    from src.perception.face_registry import FaceRegistry
    reg = FaceRegistry()
    count = reg.delete_all_faces()
    reg.close()
    print(f"Deleted {count} face(s) from the registry.")
    return 0


def cmd_forget_guests(_args) -> int:
    from src.perception.face_registry import FaceRegistry
    reg = FaceRegistry()
    count = reg.delete_guest_faces()
    reg.close()
    print(f"Deleted {count} guest face(s) from the registry.")
    return 0


def cmd_list_faces(_args) -> int:
    from src.perception.face_registry import FaceRegistry
    reg = FaceRegistry()
    faces = reg.list_faces()
    reg.close()
    if not faces:
        print("No faces in registry.")
        return 0
    col = max(len(f["name"]) for f in faces) + 2
    print(f"\n{'Name':<{col}}  {'ID (first 8)'}  {'Seen':>5}  {'Last Seen'}")
    print("─" * (col + 40))
    import time
    for f in faces:
        age = int(time.time() - f["last_seen"])
        if age < 60:
            age_str = f"{age}s ago"
        elif age < 3600:
            age_str = f"{age//60}m ago"
        else:
            age_str = f"{age//3600}h ago"
        print(f"  {f['name']:<{col}}  {f['id'][:8]}…  {f['seen_count']:>5}  {age_str}")
    print()
    return 0


def cmd_merge_faces(args) -> int:
    from src.perception.face_registry import FaceRegistry
    reg = FaceRegistry()
    keep = reg.get_face(args.keep_id)
    absorb = reg.get_face(args.absorb_id)
    if not keep:
        print(f"Error: keep_id {args.keep_id!r} not found.")
        reg.close()
        return 1
    if not absorb:
        print(f"Error: absorb_id {args.absorb_id!r} not found.")
        reg.close()
        return 1
    ok = reg.merge_faces(args.keep_id, args.absorb_id)
    reg.close()
    if ok:
        print(f"Merged {absorb['name']!r} ({args.absorb_id[:8]}…) into {keep['name']!r} ({args.keep_id[:8]}…).")
    else:
        print("Merge failed.")
    return 0 if ok else 1


def cmd_greeting_cooldown(args) -> int:
    """Set the base face greeting cooldown (minutes)."""
    minutes = float(args.minutes)
    if minutes < 1:
        print("Error: cooldown must be at least 1 minute")
        return 1
    r = _publish("tracking.set_greeting_cooldown", {"cooldown_min": minutes})
    if r is None:
        print(f"Greeting cooldown set to {minutes:.1f} minutes (bus publish; daemon may not be running).")
    else:
        print(f"Greeting cooldown updated to {minutes:.1f} minutes.")
    return 0


def cmd_greeting_settings(_args) -> int:
    """Show current greeting configuration from assistant.yaml / runtime_state.yaml."""
    import yaml
    cfg_path  = Path(__file__).resolve().parent.parent / "config" / "assistant.yaml"
    rt_path   = Path(__file__).resolve().parent.parent / "config" / "runtime_state.yaml"
    cfg: dict = {}
    rt: dict  = {}
    try:
        with open(cfg_path) as f:
            cfg = yaml.safe_load(f) or {}
    except Exception as exc:
        print(f"Warning: could not read assistant.yaml: {exc}")
    try:
        with open(rt_path) as f:
            rt = yaml.safe_load(f) or {}
    except FileNotFoundError:
        pass
    except Exception as exc:
        print(f"Warning: could not read runtime_state.yaml: {exc}")

    fr = cfg.get("face_recognition", {})
    # Runtime state can override cooldown
    rt_cooldown = rt.get("face_recognition", {}).get("greeting_cooldown_min")

    cooldown_min = rt_cooldown if rt_cooldown is not None else fr.get("greeting_cooldown_min", 30.0)
    jitter_pct   = fr.get("greeting_cooldown_jitter_pct", 25.0)
    min_abs_s    = fr.get("min_absence_s", 30.0)
    confidence   = fr.get("confidence_threshold", 0.5)
    enabled      = fr.get("enabled", True)

    W = 34
    BOLD = "\033[1m"; RST = "\033[0m"; GRN = "\033[32m"; RED = "\033[31m"
    status_str = f"{GRN}enabled{RST}" if enabled else f"{RED}disabled{RST}"
    print()
    print(f"{BOLD}Greeting Settings{RST}")
    print("─" * W)
    print(f"  {'Face recognition':<20} {status_str}")
    print(f"  {'Cooldown (base)':<20} {cooldown_min:.1f} min")
    print(f"  {'Jitter':<20} ±{jitter_pct:.0f}%  ({cooldown_min*(1-jitter_pct/100):.1f}–{cooldown_min*(1+jitter_pct/100):.1f} min)")
    print(f"  {'Min absence':<20} {min_abs_s:.0f} s")
    print(f"  {'Min confidence':<20} {confidence:.2f}")
    print()
    return 0


def cmd_restart(_args) -> int:
    """Restart the desktop-assistant-core systemd service."""
    import subprocess
    print("Restarting desktop-assistant-core.service …")
    result = subprocess.run(
        ["sudo", "systemctl", "restart", "desktop-assistant-core.service"],
        capture_output=True, text=True,
    )
    if result.returncode != 0:
        print(f"Error: {result.stderr.strip() or 'unknown error'}")
        return 1
    print("Service restarted. Use 'da ping' to confirm it is back up.")
    return 0


def cmd_reboot(_args) -> int:
    """Reboot the Raspberry Pi."""
    import subprocess
    ans = input("Reboot the Raspberry Pi? [y/N] ").strip().lower()
    if ans != "y":
        print("Aborted.")
        return 0
    print("Rebooting …")
    result = subprocess.run(["sudo", "reboot"], capture_output=True, text=True)
    if result.returncode != 0:
        print(f"Error: {result.stderr.strip() or 'unknown error'}")
        return 1
    return 0


def cmd_shutdown(_args) -> int:
    """Shut down the Raspberry Pi."""
    import subprocess
    ans = input("Shut down the Raspberry Pi? It will need to be powered on manually. [y/N] ").strip().lower()
    if ans != "y":
        print("Aborted.")
        return 0
    print("Shutting down …")
    result = subprocess.run(["sudo", "shutdown", "-h", "now"], capture_output=True, text=True)
    if result.returncode != 0:
        print(f"Error: {result.stderr.strip() or 'unknown error'}")
        return 1
    return 0


# ── Camera 1 subcommands ──────────────────────────────────────────────────────

def cmd_camera(args) -> int:
    sub = args.camera_cmd
    if sub == "resolution":
        parts = args.resolution.split("x")
        if len(parts) != 2:
            print(f"Invalid format: {args.resolution!r}. Use WxH e.g. 640x480", file=sys.stderr)
            return 1
        try:
            w, h = int(parts[0]), int(parts[1])
        except ValueError:
            print(f"Invalid resolution: {args.resolution!r}", file=sys.stderr)
            return 1
        r = _request({
            "cmd": "publish",
            "topic": "camera.set_resolution",
            "payload": {"width": w, "height": h},
        })
        if r.get("ok"):
            print(f"Camera resolution set to {w}×{h}")
        else:
            print(json.dumps(r, indent=2))
        return 0 if r.get("ok") else 1
    if sub == "rotation":
        deg = int(args.degrees) % 360
        r = _request({"cmd": "publish", "topic": "camera.set_rotation",
                      "payload": {"rotation_deg": deg}})
        if r.get("ok"):
            print(f"Camera 1 rotation set to {deg}°")
        else:
            print(json.dumps(r, indent=2))
        return 0 if r.get("ok") else 1
    if sub == "rotation-status":
        import yaml as _yaml
        _base = Path(__file__).resolve().parents[1]
        _cfg, _rt = {}, {}
        try:
            _cfg = _yaml.safe_load((_base / "config" / "assistant.yaml").read_text()) or {}
        except Exception:
            pass
        try:
            _rt = _yaml.safe_load((_base / "config" / "runtime_state.yaml").read_text()) or {}
        except Exception:
            pass
        deg = _rt.get("camera", {}).get(
            "rotation_deg",
            _cfg.get("camera", {}).get("rotation_deg", 0),
        )
        print(f"  Camera 1 rotation : {deg}°")
        return 0
    return 1


# ── Camera 2 subcommands ──────────────────────────────────────────────────────

def cmd_camera2(args) -> int:
    sub = args.camera2_cmd
    if sub == "rotation":
        deg = int(args.degrees) % 360
        r = _request({
            "cmd": "publish",
            "topic": "camera2.set_rotation",
            "payload": {"rotation_deg": deg},
        })
        if r.get("ok"):
            print(f"Camera 2 rotation set to {deg}°")
        else:
            print(json.dumps(r, indent=2))
        return 0 if r.get("ok") else 1
    if sub == "rotation-status":
        import yaml as _yaml
        _base = Path(__file__).resolve().parents[1]
        _cfg, _rt = {}, {}
        try:
            _cfg = _yaml.safe_load((_base / "config" / "assistant.yaml").read_text()) or {}
        except Exception:
            pass
        try:
            _rt = _yaml.safe_load((_base / "config" / "runtime_state.yaml").read_text()) or {}
        except Exception:
            pass
        deg = _rt.get("camera2", {}).get(
            "rotation_deg",
            _cfg.get("camera2", {}).get("rotation_deg", 0),
        )
        print(f"  Camera 2 rotation : {deg}°")
        return 0
    return 1


# ── Voice EQ subcommands ──────────────────────────────────────────────────────

def cmd_eq(args) -> int:
    _EQ_PRESETS = ["flat", "bass_boost", "treble_boost", "vocal", "loudness", "warm"]
    sub = args.eq_cmd
    if sub == "set":
        if args.preset not in _EQ_PRESETS:
            print(f"Unknown preset '{args.preset}'. Valid: {', '.join(_EQ_PRESETS)}")
            return 1
        r = _request({
            "cmd": "publish",
            "topic": "av.set_eq_preset",
            "payload": {"preset": args.preset},
        })
        if r.get("ok"):
            print(f"EQ preset set to '{args.preset}'")
        else:
            print(json.dumps(r, indent=2))
        return 0 if r.get("ok") else 1
    if sub == "custom":
        bands = []
        for spec in args.band:
            if "=" in spec:
                parts = dict(p.split("=") for p in spec.split(","))
                hz   = float(parts.get("hz", 1000))
                gain = float(parts.get("gain", 0))
                q    = float(parts.get("q", 1.0))
            elif ":" in spec:
                pieces = spec.split(":")
                hz   = float(pieces[0]) if len(pieces) > 0 else 1000.0
                gain = float(pieces[1]) if len(pieces) > 1 else 0.0
                q    = float(pieces[2]) if len(pieces) > 2 else 1.0
            else:
                print(f"Cannot parse band spec: {spec!r}", file=sys.stderr)
                return 1
            bands.append({"hz": hz, "gain_db": gain, "q": q})
        r = _request({
            "cmd": "publish",
            "topic": "av.set_custom_eq",
            "payload": {"bands": bands},
        })
        if r.get("ok"):
            print(f"Custom EQ applied ({len(bands)} band(s)).")
        else:
            print(json.dumps(r, indent=2))
        return 0 if r.get("ok") else 1
    return 1


# ── Object Detection subcommands ──────────────────────────────────────────────

def cmd_object_detection(args) -> int:
    if args.action == "status":
        try:
            d = _http_get("/api/settings/object-detection")
            enabled = d.get("enabled", False)
            print(f"Object detection: {'enabled' if enabled else 'disabled'}")
        except Exception:
            r = _request({"cmd": "last", "topic": "object.enabled_changed"})
            payload = r.get("payload")
            if isinstance(payload, dict):
                enabled = payload.get("enabled", True)
                print(f"Object detection: {'enabled' if enabled else 'disabled'}")
            else:
                print("Object detection: status unknown")
        return 0
    enabled = args.action == "enable"
    try:
        d = _http_put("/api/settings/object-detection", {"enabled": enabled})
        ok = d.get("ok", True)
    except Exception:
        r = _request({"cmd": "publish", "topic": "object.set_enabled",
                      "payload": {"enabled": enabled}})
        ok = r.get("ok", False)
    label = "enabled" if enabled else "disabled"
    print(f"Object detection {label}." if ok else "Error toggling object detection.")
    return 0 if ok else 1


