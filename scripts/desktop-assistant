    qh_sub = qh_sp.add_subparsers(dest="qh_action", metavar="<subcommand>")
    qh_sub.required = True
    qh_sub.add_parser("status",  help="Show current quiet-hours state and window").set_defaults(func=cmd_quiet_hours)
    qh_sub.add_parser("enable",  help="Enable quiet hours").set_defaults(func=cmd_quiet_hours)
    qh_sub.add_parser("disable", help="Disable quiet hours").set_defaults(func=cmd_quiet_hours)
    ssp = qh_sub.add_parser("set", help="Set the quiet-hours window")
    ssp.add_argument("--start", default=None, help="Start time HH:MM (e.g. 22:00)")
    ssp.add_argument("--end",   default=None, help="End time HH:MM   (e.g. 07:00)")
    ssp.set_defaults(func=cmd_quiet_hours)

    # ── Skills subcommand group ───────────────────────────────────────
    sk_sp = sub.add_parser("skills", help="Voice skills management")
    sk_sub = sk_sp.add_subparsers(dest="skills_cmd", metavar="<subcommand>")
    sk_sub.required = True

    sk_sub.add_parser("list", help="List all registered voice skills").set_defaults(func=cmd_skills)

    ssp = sk_sub.add_parser("enable", help="Enable a skill by name")
    ssp.add_argument("skill_name", metavar="<name>")
    ssp.set_defaults(func=cmd_skills)

    ssp = sk_sub.add_parser("disable", help="Disable a skill by name")
    ssp.add_argument("skill_name", metavar="<name>")
    ssp.set_defaults(func=cmd_skills)

