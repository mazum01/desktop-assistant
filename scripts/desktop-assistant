def cmd_music_status(_args) -> int:
    state_r = _request({"cmd": "last", "topic": "music.state_changed"})
    song_r  = _request({"cmd": "last", "topic": "music.song_changed"})
    state = "stopped"
    if isinstance(state_r.get("payload"), dict):
        state = state_r["payload"].get("state", "stopped")
    song = {}
    if isinstance(song_r.get("payload"), dict):
        song = song_r["payload"]
    icons = {"playing": "▶", "paused": "⏸", "stopped": "■"}
    print(f"\n  State    : {icons.get(state, '?')} {state}")
    if song:
        print(f"  Title    : {song.get('title', '—')}")
        print(f"  Artist   : {song.get('artist', '—')}")
        print(f"  Station  : {song.get('station', '—')}")
    print()
    return 0


def cmd_music_volume(args) -> int:
    """Get or set system volume (0–100)."""
    try:
        if hasattr(args, "level") and args.level is not None:
            _http_put("/api/music/volume", {"level": int(args.level)})
            print(f"Volume set to {args.level}%")
        else:
            d = _http_get("/api/music/volume")
            lvl = d.get("level", -1)
            if lvl < 0:
                print("Volume: (unavailable)")
            else:
                print(f"Volume: {lvl}%")
    except Exception as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1
    return 0


def cmd_music_eq(args) -> int:
    """Get or set the software EQ preset."""
    _EQ_PRESETS = ["flat", "bass_boost", "treble_boost", "vocal", "loudness", "warm"]
    try:
        if hasattr(args, "preset") and args.preset is not None:
            if args.preset not in _EQ_PRESETS:
                print(f"Unknown preset '{args.preset}'. Valid: {', '.join(_EQ_PRESETS)}")
                return 1
            _http_put("/api/music/eq", {"preset": args.preset})
            print(f"EQ preset set to '{args.preset}'")
        else:
            d = _http_get("/api/music/eq")
            print(f"EQ preset: {d.get('preset', 'flat')}")
            print(f"Available: {', '.join(d.get('presets', _EQ_PRESETS))}")
    except Exception as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1
    return 0


def main() -> int:
    p = argparse.ArgumentParser(
        prog="vera",
        description="Control the running VERA daemon over ZMQ.",
    )
    sub = p.add_subparsers(dest="cmd")

    sp = sub.add_parser("help", help="Show command reference or help for a specific command")
    sp.add_argument("command", nargs="?", default=None, help="Command name to get help for")
    sp.set_defaults(func=cmd_help)

    # ── system subcommand group ──────────────────────────────────────
    sys_sp = sub.add_parser("system", help="System management (ping/restart/reboot/shutdown/version)")
    sys_sub = sys_sp.add_subparsers(dest="sys_cmd", metavar="<subcommand>")
    sys_sub.required = True
    sys_sub.add_parser("ping",     help="Round-trip check — confirms daemon is reachable").set_defaults(func=cmd_ping)
    sys_sub.add_parser("restart",  help="Restart vera-core systemd service").set_defaults(func=cmd_restart)
    sys_sub.add_parser("reboot",   help="Reboot the Raspberry Pi (prompts for confirmation)").set_defaults(func=cmd_reboot)
    sys_sub.add_parser("shutdown", help="Shut down the Raspberry Pi (prompts for confirmation)").set_defaults(func=cmd_shutdown)
    sys_sub.add_parser("version",  help="Speak the current version number via TTS").set_defaults(func=cmd_version)

    # ── face subcommand group ────────────────────────────────────────
    face_sp = sub.add_parser("face", help="Face registry and greeting management")
    face_sub = face_sp.add_subparsers(dest="face_cmd", metavar="<subcommand>")
    face_sub.required = True

    ssp = face_sub.add_parser("meet", help="Assign a name to the most recently seen face")
    ssp.add_argument("name", help="Name to assign (e.g. 'Alice')")
    ssp.set_defaults(func=cmd_meet)

    face_sub.add_parser("list", help="List all faces with IDs, names, and last-seen times").set_defaults(func=cmd_list_faces)
    face_sub.add_parser("refresh", help="Reload embedding cache and re-identify all faces").set_defaults(func=cmd_refresh_faces)
    face_sub.add_parser("clean-gallery", help="Prune outlier embeddings to fix mis-identification").set_defaults(func=cmd_clean_gallery)
    ssp = face_sub.add_parser("clear-embeddings", help="Clear all embeddings for one identity (forces re-enrollment)")
    ssp.add_argument("name_or_id", help="Name or ID prefix (e.g. 'Carson' or 'c523744e')")
    ssp.set_defaults(func=cmd_clear_embeddings)
    face_sub.add_parser("forget-all", help="Delete ALL known faces from the registry permanently").set_defaults(func=cmd_forget_faces)
    face_sub.add_parser("forget-guests", help="Delete only Guest-named faces, keeping named identities").set_defaults(func=cmd_forget_guests)

    ssp = face_sub.add_parser("merge", help="Merge two face identities into one")
    ssp.add_argument("keep_id",   help="Face ID to keep (use 'face list' to get IDs)")
    ssp.add_argument("absorb_id", help="Face ID to absorb into keep_id")
    ssp.set_defaults(func=cmd_merge_faces)

    ssp = face_sub.add_parser("greeting-cooldown", help="Set the base face greeting cooldown in minutes")
    ssp.add_argument("minutes", type=float, help="Base cooldown in minutes (min 1)")
    ssp.set_defaults(func=cmd_greeting_cooldown)

    face_sub.add_parser("greeting-settings", help="Show all current greeting configuration values").set_defaults(func=cmd_greeting_settings)

    # ── vision subcommand group ──────────────────────────────────────
    vis_sp = sub.add_parser("vision", help="Vision and scene description commands")
    vis_sub = vis_sp.add_subparsers(dest="vis_cmd", metavar="<subcommand>")
    vis_sub.required = True
    vis_sub.add_parser("describe", help="Speak a natural-language description of everything currently seen").set_defaults(func=cmd_vision_describe)

    # ── camera 1 subcommand group ────────────────────────────────────
    cam_sp = sub.add_parser("camera", help="Camera 1 settings (resolution, rotation)")
    cam_sub = cam_sp.add_subparsers(dest="camera_cmd", metavar="<subcommand>")
    cam_sub.required = True

    ssp = cam_sub.add_parser("resolution", help="Set capture resolution for both cameras (e.g. 640x480)")
    ssp.add_argument("resolution", help="WxH (e.g. 640x480)")
    ssp.set_defaults(func=cmd_camera)

    ssp = cam_sub.add_parser("rotation", help="Set camera 1 rotation angle (0–359°)")
    ssp.add_argument("degrees", type=int, help="Rotation in degrees (0–359)")
    ssp.set_defaults(func=cmd_camera)

    cam_sub.add_parser("rotation-status", help="Show current camera 1 rotation angle").set_defaults(func=cmd_camera)

    # ── camera 2 subcommand group ────────────────────────────────────
    cam2_sp = sub.add_parser("camera2", help="Camera 2 (raw feed) settings (rotation)")
    cam2_sub = cam2_sp.add_subparsers(dest="camera2_cmd", metavar="<subcommand>")
    cam2_sub.required = True

    ssp = cam2_sub.add_parser("rotation", help="Set camera 2 rotation angle (0–359°)")
    ssp.add_argument("degrees", type=int, help="Rotation in degrees (0–359)")
    ssp.set_defaults(func=cmd_camera2)

    cam2_sub.add_parser("rotation-status", help="Show current camera 2 rotation angle").set_defaults(func=cmd_camera2)

    # ── voice EQ subcommand group ────────────────────────────────────
    eq_sp = sub.add_parser("eq", help="Voice / TTS audio equalizer settings")
    eq_sub = eq_sp.add_subparsers(dest="eq_cmd", metavar="<subcommand>")
    eq_sub.required = True

    ssp = eq_sub.add_parser("set", help="Apply a named EQ preset")
    ssp.add_argument("preset", help="flat | bass_boost | treble_boost | vocal | loudness | warm")
    ssp.set_defaults(func=cmd_eq)

    ssp = eq_sub.add_parser("custom", help="Apply custom per-band EQ (hz=<Hz>,gain=<dB>,q=<Q>  or  <Hz>:<dB>:<Q>)")
    ssp.add_argument("band", nargs="+", help="Band spec: hz=1000,gain=3.5,q=1.0  or  1000:3.5:1.0")
    ssp.set_defaults(func=cmd_eq)

    # ── object detection subcommand group ────────────────────────────
    od_sp = sub.add_parser("object-detection", help="Enable/disable COCO object classification (Hailo-8)")
    od_sub = od_sp.add_subparsers(dest="action", metavar="<subcommand>")
    od_sub.required = True
    od_sub.add_parser("enable",  help="Turn on object detection").set_defaults(func=cmd_object_detection)
    od_sub.add_parser("disable", help="Turn off object detection").set_defaults(func=cmd_object_detection)
    od_sub.add_parser("status",  help="Show current state").set_defaults(func=cmd_object_detection)

    # ── music subcommand group ───────────────────────────────────────
    mus_sp = sub.add_parser("music", help="Pandora music playback via pianobar")
    mus_sub = mus_sp.add_subparsers(dest="mus_cmd", metavar="<subcommand>")
    mus_sub.required = True

    ssp = mus_sub.add_parser("play", help="Start or resume playback (optional station name)")
    ssp.add_argument("station", nargs="*", help="Station name to select (fuzzy match)")
    ssp.set_defaults(func=cmd_music_play)

    mus_sub.add_parser("stop",        help="Stop playback").set_defaults(func=cmd_music_stop)
    mus_sub.add_parser("next",        help="Skip to the next song").set_defaults(func=cmd_music_next)
    mus_sub.add_parser("pause",       help="Toggle pause/resume").set_defaults(func=cmd_music_pause)
    mus_sub.add_parser("thumbs-up",   help="Love the current song").set_defaults(func=cmd_music_thumbs_up)
    mus_sub.add_parser("thumbs-down", help="Ban the current song (skips it)").set_defaults(func=cmd_music_thumbs_down)
    mus_sub.add_parser("stations",    help="List available Pandora stations").set_defaults(func=cmd_music_stations)
    mus_sub.add_parser("status",      help="Show playback state and current song").set_defaults(func=cmd_music_status)

    ssp = mus_sub.add_parser("volume", help="Get or set system volume (0–100)")
    ssp.add_argument("level", nargs="?", type=int, default=None, help="Volume level 0–100 (omit to read)")
    ssp.set_defaults(func=cmd_music_volume)

    ssp = mus_sub.add_parser("eq", help="Get or set music EQ preset")
    ssp.add_argument("preset", nargs="?", default=None,
                     help="EQ preset: flat | bass_boost | treble_boost | vocal | loudness | warm")
    ssp.set_defaults(func=cmd_music_eq)

    sub.add_parser("topics", help="List subscribed topics").set_defaults(func=cmd_topics)
    sub.add_parser("ping", help="Round-trip latency check (shortcut for 'system ping')").set_defaults(func=cmd_ping)

    sp = sub.add_parser("status", help="Show health/telemetry dashboard")
    sp.add_argument("--json", action="store_true", help="Emit raw JSON")
    sp.set_defaults(func=cmd_status)

    sp = sub.add_parser("last", help="Most recent payload on a topic")
    sp.add_argument("topic")
    sp.set_defaults(func=cmd_last)

    sp = sub.add_parser("publish", help="Publish raw event to bus")
    sp.add_argument("topic")
    sp.add_argument("--payload", help="JSON payload (default: null)")
    sp.set_defaults(func=cmd_publish)

    sp = sub.add_parser("say", help="Speak a phrase via TTS")
    sp.add_argument("text")
    sp.set_defaults(func=cmd_say)

    sub.add_parser("joke", help="Tell a random dad joke").set_defaults(func=cmd_joke)
    sub.add_parser("time", help="Announce the current time").set_defaults(func=cmd_time)

    sp = sub.add_parser("record", help="Record microphone audio to a WAV file")
    sp.add_argument("--seconds", "-s", type=float, default=5.0,
                    help="Duration to record (1-120 seconds, default: 5)")
