    servo_sub.add_parser("enable",  help="Enable servo motion").set_defaults(func=cmd_servo_enable)
    servo_sub.add_parser("disable", help="Disable servo motion").set_defaults(func=cmd_servo_disable)
    servo_sub.add_parser("status",  help="Show servo state, limits, and current angle").set_defaults(func=cmd_servo_status)

