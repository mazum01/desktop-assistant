    room_set_sp.set_defaults(func=cmd_room_set)

    radon_sp = sub.add_parser("radon", help="EcoQube radon monitor")
    radon_sp.set_defaults(func=lambda _a: (print("Usage: vera radon status | vera radon announce"), 1)[1])
    radon_sub = radon_sp.add_subparsers(dest="radon_cmd")
    radon_sub.add_parser("status",   help="Show current radon level").set_defaults(func=cmd_radon)
    radon_sub.add_parser("announce", help="Speak radon level via TTS").set_defaults(func=cmd_radon)

    drop_sp = sub.add_parser("drop", help="DROP water softener system")
    drop_sp.set_defaults(func=lambda _a: (print("Usage: vera drop status | vera drop announce"), 1)[1])
    drop_sub = drop_sp.add_subparsers(dest="drop_cmd")
    drop_sub.add_parser("status",   help="Show current water softener status").set_defaults(func=cmd_drop)
    drop_sub.add_parser("announce", help="Speak softener status via TTS").set_defaults(func=cmd_drop)

    # ── IoT plugin CRUD subcommand group ─────────────────────────────
    iot_sp = sub.add_parser("iot", help="IoT plugin device management (list/types/status/add/config/remove/announce)")
    iot_sp.set_defaults(func=lambda _a: (print("Usage: vera iot <subcommand>  (try 'vera iot list')"), 1)[1])
    iot_sub = iot_sp.add_subparsers(dest="iot_cmd", metavar="<subcommand>")
    iot_sub.required = True

    iot_sub.add_parser("list",  help="List all registered IoT plugin devices").set_defaults(func=cmd_iot)
    iot_sub.add_parser("types", help="List all discoverable plugin types (from src/iot/devices/)").set_defaults(func=cmd_iot)

    ssp = iot_sub.add_parser("status", help="Show snapshot for a specific device")
    ssp.add_argument("device_id", metavar="<device_id>")
    ssp.set_defaults(func=cmd_iot)

    ssp = iot_sub.add_parser("add", help="Register and start a new IoT device plugin")
    ssp.add_argument("type_id", metavar="<type_id>", help="Plugin type_id (see 'vera iot types')")
    ssp.add_argument("--config", "-c", default=None, metavar="JSON",
                     help="JSON config string, e.g. '{\"host\": \"192.168.1.50\"}'")
    ssp.set_defaults(func=cmd_iot)

    ssp = iot_sub.add_parser("config", help="Show or update config for a registered device")
    ssp.add_argument("device_id", metavar="<device_id>")
    ssp.add_argument("settings", nargs="*", metavar="key=value",
                     help="Config fields to set (omit to show current state)")
    ssp.set_defaults(func=cmd_iot)

    ssp = iot_sub.add_parser("remove", help="Stop and unregister an IoT device")
    ssp.add_argument("device_id", metavar="<device_id>")
    ssp.set_defaults(func=cmd_iot)

    ssp = iot_sub.add_parser("announce", help="Speak device status via TTS")
    ssp.add_argument("device_id", metavar="<device_id>")
    ssp.set_defaults(func=cmd_iot)

    args = p.parse_args()
    if args.cmd is None:
        args.command = None
        return cmd_help(args)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
