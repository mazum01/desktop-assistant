def cmd_processes(_args) -> int:
    """List active vera-core and companion processes."""
    GRN = "\033[32m"; YLW = "\033[33m"; RED = "\033[31m"; DIM = "\033[2m"; RST = "\033[0m"
    try:
        d = _http_get("/api/processes")
    except Exception as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1
    procs = d.get("processes", [])
    if not procs:
        print("No processes found.")
        return 0
    print()
    print(f"  {'Name':<22} {'PID':>6}  {'Role':<10} {'Status':<10} {'CPU%':>6}  {'Mem MB':>8}  {'Threads':>7}")
    print("  " + "─" * 78)
    for p in procs:
        name    = p.get("name", "?")
        pid     = p.get("pid", "?")
        role    = p.get("role", "?")
        status  = p.get("status", "?")
        cpu     = p.get("cpu_pct")
        mem     = p.get("mem_mb")
        threads = p.get("threads")

        if role == "main":
            name_s = f"{GRN}{name}{RST}"
        elif role == "companion":
            name_s = f"{YLW}{name}{RST}"
        else:
            name_s = f"{DIM}{name}{RST}"

        cpu_s = f"{cpu:5.1f}" if cpu is not None else "    —"
        mem_s = f"{mem:7.1f}" if mem is not None else "      —"
        thr_s = f"{threads:6}" if threads is not None else "     —"
        print(f"  {name_s:<30} {pid:>6}  {role:<10} {status:<10} {cpu_s}  {mem_s}  {thr_s}")
    print()
    return 0


def cmd_watch(args) -> int:
    ctx = zmq.Context.instance()
    sock = ctx.socket(zmq.SUB)
    sock.connect(PUB_ENDPOINT)
    prefix = args.topic or ""
    sock.setsockopt_string(zmq.SUBSCRIBE, prefix)
    print(f"# watching {PUB_ENDPOINT} (prefix={prefix!r}) — Ctrl-C to stop")
    try:
        while True:
            topic, payload = sock.recv_multipart()
            print(f"{topic.decode()}\t{payload.decode()}")
    except KeyboardInterrupt:
        return 0
    finally:
        sock.close(linger=0)


