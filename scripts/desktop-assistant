    stations = []
    if isinstance(r.get("payload"), dict):
        stations = r["payload"].get("stations", [])
    if not stations:
        print("No station list available yet. Start music first: da music play")
        return 1
    print(f"\n  {'ID':<4} Station")
    print("  " + "─" * 36)
    for s in stations:
        print(f"  {s['id']:<4} {s['name']}")
    print()
    return 0


def cmd_music_status(_args) -> int:
    state_r = _request({"cmd": "last", "topic": "music.state_changed"})
    song_r  = _request({"cmd": "last", "topic": "music.song_changed"})
    state = "stopped"
    if isinstance(state_r.get("payload"), dict):
        state = state_r["payload"].get("state", "stopped")
    song = {}
    if isinstance(song_r.get("payload"), dict):
        song = song_r["payload"]
    icons = {"playing": "▶", "paused": "⏸", "stopped": "■"}
    print(f"\n  State    : {icons.get(state, '?')} {state}")
    if song:
        print(f"  Title    : {song.get('title', '—')}")
        print(f"  Artist   : {song.get('artist', '—')}")
        print(f"  Station  : {song.get('station', '—')}")
    print()
    return 0


def cmd_podcast(args) -> int:
    action = getattr(args, "podcast_action", "status") or "status"

    try:
        if action == "search":
            q = " ".join(getattr(args, "query", [])).strip()
            if not q:
                print("Usage: vera podcast search <query>", file=sys.stderr)
                return 1
            data = _http_get(f"/api/podcasts/search?q={quote_plus(q)}&limit=10")
            results = data.get("results", [])
            if not results:
                print("No results.")
                return 0
            print(f"\n  {'ID':<6} {'Title':<44} Author")
            print("  " + "-" * 92)
            for i, r in enumerate(results, start=1):
                title = (r.get("title") or "")[:44]
                author = r.get("author") or ""
                feed = r.get("feed_url") or ""
                print(f"  {i:<6} {title:<44} {author}")
                print(f"         {feed}")
            print()
            return 0

        if action == "subscribe":
            q = " ".join(getattr(args, "query_or_url", [])).strip()
            if not q:
                print("Usage: vera podcast subscribe <query|feed-url>", file=sys.stderr)
                return 1
            data = _http_post("/api/podcasts/subscribe", {"query_or_url": q})
            sub = data.get("subscription", {})
            print(f"Subscribed: {sub.get('title', 'n/a')}  (id={sub.get('id', 'n/a')})")
            return 0

        if action == "list":
            data = _http_get("/api/podcasts")
            subs = data.get("subscriptions", [])
            if not subs:
                print("No podcast subscriptions yet.")
                return 0
            print(f"\n  {'ID':<14} {'Title':<42} {'Episodes':>8}  Author")
            print("  " + "-" * 92)
            for s in subs:
                print(f"  {str(s.get('id','')):<14} {(s.get('title','') or '')[:42]:<42} {int(s.get('episode_count',0)):>8}  {(s.get('author','') or '')[:24]}")
            print()
            return 0

        if action == "episodes":
            pid = getattr(args, "podcast_id", "")
            data = _http_get(f"/api/podcasts/{pid}/episodes?limit=25")
            eps = data.get("episodes", [])
            if not eps:
                print("No episodes available.")
                return 0
            print(f"\n  Episodes for {pid}")
            print("  " + "-" * 72)
            for i, ep in enumerate(eps):
                title = (ep.get("title") or "")[:64]
                dur = ep.get("duration") or ""
                pub = ep.get("published") or ""
                print(f"  [{i:02d}] {title}")
                if pub or dur:
                    print(f"       {pub}  {dur}")
            print()
            return 0

        if action == "play":
            pid = getattr(args, "podcast_id", "")
            idx = int(getattr(args, "episode_index", 0))
            st = _http_post("/api/podcasts/play", {"podcast_id": pid, "episode_index": idx})
            print(f"Playing: {st.get('podcast_title', '')} - {st.get('episode_title', '')}")
            return 0

        if action == "pause":
            _http_post("/api/podcasts/pause", {})
            print("Podcast paused.")
            return 0

        if action == "resume":
            _http_post("/api/podcasts/resume", {})
            print("Podcast resumed.")
            return 0

        if action == "stop":
            _http_post("/api/podcasts/stop", {})
            print("Podcast stopped.")
            return 0

        if action == "status":
            st = _http_get("/api/podcasts/status")
            print(f"\n  State    : {st.get('state', 'stopped')}")
            if st.get("podcast_title"):
                print(f"  Podcast  : {st.get('podcast_title')}")
            if st.get("episode_title"):
                print(f"  Episode  : {st.get('episode_title')}")
            if st.get("duration_sec") is not None:
                pos = float(st.get("position_sec") or 0.0)
                dur = float(st.get("duration_sec") or 0.0)
                print(f"  Position : {int(pos)}s / {int(dur)}s")
            print(f"  Player   : {st.get('player') or '-'}")
            print(f"  Subs     : {st.get('subscriptions', 0)}")
            print()
            return 0

        if action == "seek":
            sec = float(getattr(args, "seconds", 0.0))
            st = _http_post("/api/podcasts/seek", {"position_sec": sec})
            print(f"Seeked to {int(float(st.get('position_sec') or sec))}s")
            return 0

        if action == "skip":
            delta = float(getattr(args, "delta_sec", 0.0))
            st = _http_post("/api/podcasts/skip", {"delta_sec": delta})
            print(f"Position: {int(float(st.get('position_sec') or 0.0))}s")
            return 0

        if action == "back15":
            st = _http_post("/api/podcasts/skip", {"delta_sec": -15.0})
            print(f"Position: {int(float(st.get('position_sec') or 0.0))}s")
            return 0

        if action == "fwd30":
            st = _http_post("/api/podcasts/skip", {"delta_sec": 30.0})
            print(f"Position: {int(float(st.get('position_sec') or 0.0))}s")
            return 0

        if action == "refresh":
            pid = getattr(args, "podcast_id", "")
            out = _http_post(f"/api/podcasts/{pid}/refresh", {})
            print(f"Refreshed {pid}: {out.get('episode_count', 0)} episodes")
            return 0

        if action == "unsubscribe":
            pid = getattr(args, "podcast_id", "")
            out = _http_delete(f"/api/podcasts/{pid}")
            print(f"Unsubscribed {pid}: deleted={out.get('deleted', 0)}")
            return 0

        print(f"Unknown podcast sub-command: {action!r}", file=sys.stderr)
        return 1

    except Exception as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1


def main() -> int:
    p = argparse.ArgumentParser(
        prog="vera",
        description="Control the running VERA daemon over ZMQ.",
    )
    sub = p.add_subparsers(dest="cmd")

    sp = sub.add_parser("help", help="Show command reference or help for a specific command")
    sp.add_argument("command", nargs="?", default=None, help="Command name to get help for")
    sp.set_defaults(func=cmd_help)

    # ── system subcommand group ──────────────────────────────────────
    sys_sp = sub.add_parser("system", help="System management (ping/restart/reboot/shutdown/version)")
    sys_sub = sys_sp.add_subparsers(dest="sys_cmd", metavar="<subcommand>")
    sys_sub.required = True
    sys_sub.add_parser("ping",      help="Round-trip check — confirms daemon is reachable").set_defaults(func=cmd_ping)
    sys_sub.add_parser("restart",   help="Restart vera-core systemd service").set_defaults(func=cmd_restart)
    sys_sub.add_parser("reboot",    help="Reboot the Raspberry Pi (prompts for confirmation)").set_defaults(func=cmd_reboot)
    sys_sub.add_parser("shutdown",  help="Shut down the Raspberry Pi (prompts for confirmation)").set_defaults(func=cmd_shutdown)
    sys_sub.add_parser("version",   help="Speak the current version number via TTS").set_defaults(func=cmd_version)
    sys_sub.add_parser("processes", help="List active vera-core and companion processes").set_defaults(func=cmd_processes)

    # ── face subcommand group ────────────────────────────────────────
    face_sp = sub.add_parser("face", help="Face registry and greeting management")
    face_sub = face_sp.add_subparsers(dest="face_cmd", metavar="<subcommand>")
    face_sub.required = True

    ssp = face_sub.add_parser("meet", help="Assign a name to the most recently seen face")
    ssp.add_argument("name", help="Name to assign (e.g. 'Alice')")
    ssp.set_defaults(func=cmd_meet)

    face_sub.add_parser("list", help="List all faces with IDs, names, and last-seen times").set_defaults(func=cmd_list_faces)
    face_sub.add_parser("refresh", help="Reload embedding cache and re-identify all faces").set_defaults(func=cmd_refresh_faces)
    face_sub.add_parser("clean-gallery", help="Prune outlier embeddings to fix mis-identification").set_defaults(func=cmd_clean_gallery)
    ssp = face_sub.add_parser("clear-embeddings", help="Clear all embeddings for one identity (forces re-enrollment)")
    ssp.add_argument("name_or_id", help="Name or ID prefix (e.g. 'Carson' or 'c523744e')")
    ssp.set_defaults(func=cmd_clear_embeddings)
    face_sub.add_parser("forget-all", help="Delete ALL known faces from the registry permanently").set_defaults(func=cmd_forget_faces)
    face_sub.add_parser("forget-guests", help="Delete only Guest-named faces, keeping named identities").set_defaults(func=cmd_forget_guests)

    ssp = face_sub.add_parser("merge", help="Merge two face identities into one")
    ssp.add_argument("keep_id",   help="Face ID to keep (use 'face list' to get IDs)")
    ssp.add_argument("absorb_id", help="Face ID to absorb into keep_id")
    ssp.set_defaults(func=cmd_merge_faces)

    ssp = face_sub.add_parser("greeting-cooldown", help="Set the base face greeting cooldown in minutes")
    ssp.add_argument("minutes", type=float, help="Base cooldown in minutes (min 1)")
    ssp.set_defaults(func=cmd_greeting_cooldown)

    face_sub.add_parser("greeting-settings", help="Show all current greeting configuration values").set_defaults(func=cmd_greeting_settings)

    # ── vision subcommand group ──────────────────────────────────────
