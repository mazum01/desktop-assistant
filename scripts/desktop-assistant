# ── Object Detection subcommands ──────────────────────────────────────────────

def cmd_object_detection(args) -> int:
    if args.action == "status":
        try:
            d = _http_get("/api/settings/object-detection")
            enabled = d.get("enabled", False)
            print(f"Object detection: {'enabled' if enabled else 'disabled'}")
        except Exception:
            r = _request({"cmd": "last", "topic": "object.enabled_changed"})
            payload = r.get("payload")
            if isinstance(payload, dict):
                enabled = payload.get("enabled", True)
                print(f"Object detection: {'enabled' if enabled else 'disabled'}")
            else:
                print("Object detection: status unknown")
        return 0
    enabled = args.action == "enable"
    try:
        d = _http_put("/api/settings/object-detection", {"enabled": enabled})
        ok = d.get("ok", True)
    except Exception:
        r = _request({"cmd": "publish", "topic": "object.set_enabled",
                      "payload": {"enabled": enabled}})
        ok = r.get("ok", False)
    label = "enabled" if enabled else "disabled"
    print(f"Object detection {label}." if ok else "Error toggling object detection.")
    return 0 if ok else 1


def cmd_anthropic(args) -> int:
    if args.action == "status":
        try:
            d = _http_get("/api/settings/anthropic")
            enabled = d.get("enabled", True)
            print(f"Anthropic API: {'enabled' if enabled else 'disabled'}")
        except Exception:
            r = _request({"cmd": "last", "topic": "anthropic.set_enabled"})
            payload = r.get("payload")
            if isinstance(payload, dict):
                enabled = payload.get("enabled", True)
                print(f"Anthropic API: {'enabled' if enabled else 'disabled'}")
            else:
                print("Anthropic API: status unknown")
        return 0
    enabled = args.action == "enable"
    try:
        d = _http_put("/api/settings/anthropic", {"enabled": enabled})
        ok = d.get("ok", True)
    except Exception:
        r = _request({"cmd": "publish", "topic": "anthropic.set_enabled",
                      "payload": {"enabled": enabled}})
        ok = r.get("ok", False)
    label = "enabled" if enabled else "disabled"
    print(f"Anthropic API {label}." if ok else "Error toggling Anthropic API.")
    return 0 if ok else 1


# ── Fan subcommands (override + tach) ────────────────────────────────────────

def _parse_fan_curve_specs(specs: list[str]) -> list[dict[str, float]]:
    points: list[dict[str, float]] = []
    for spec in specs:
        token = spec.strip()
        if not token:
            continue
        if ":" not in token:
            raise ValueError(f"Invalid point '{spec}'. Use temp:duty")
        temp_s, duty_s = token.split(":", 1)
        points.append({"temp_c": float(temp_s), "duty": float(duty_s)})
    if len(points) < 2:
        raise ValueError("At least two control points are required")
    return points


def _format_fan_curve_points(points: list[dict]) -> str:
    return ", ".join(f"{float(p['temp_c']):g}:{float(p['duty']):g}" for p in points)

def cmd_fan(args) -> int:
    """Fan speed override and tach controls."""
    action = getattr(args, "fan_action", "status")

    GRN = "\033[32m"; YLW = "\033[33m"; RED = "\033[31m"; RST = "\033[0m"

    if action == "status":
        # Read from the core bus (core forwards thermal.* via IPCBridge)
        fan_r  = _request({"cmd": "last", "topic": "thermal.fan"})
        rpm_r  = _request({"cmd": "last", "topic": "thermal.rpm"})
        fan    = (fan_r.get("payload") or {})
        rpm    = (rpm_r.get("payload") or {})

        duty     = fan.get("duty")
        backend  = fan.get("backend", "?")
        override = fan.get("override", False)
        ovr_duty = fan.get("override_duty")
        tach_on  = rpm.get("enabled", True)
        rpm_val  = rpm.get("rpm")

        duty_str = f"{duty:.0f}%" if duty is not None else "—"
        ovr_str  = (f"{YLW}OVERRIDE pinned at {ovr_duty:.0f}%{RST}" if override
                    else f"{GRN}auto (thermal){RST}")
        rpm_str  = (str(rpm_val) if (rpm_val is not None and tach_on) else
                    ("—" if tach_on else f"{YLW}tach disabled{RST}"))

        print()
        print("  Fan")
        print(f"    Duty    : {duty_str}   backend={backend}")
        print(f"    Control : {ovr_str}")
        print(f"    RPM     : {rpm_str}")
        print()
        return 0

    if action == "set":
        duty = args.duty
        if duty is None:
            print("Error: missing duty value (e.g. da fan set 50)", file=sys.stderr)
            return 1
        duty = max(0.0, min(100.0, float(duty)))
        r = _thermal_request({
            "cmd": "publish",
            "topic": "thermal.fan.set_override",
            "payload": {"duty": duty},
        })
        if not r.get("ok"):
            print(f"Error: {r.get('error', r)}", file=sys.stderr)
            return 1
        print(f"Fan pinned at {duty:.0f}%  (run 'da fan auto' to release)")
        return 0

    if action == "auto":
        r = _thermal_request({
            "cmd": "publish",
            "topic": "thermal.fan.clear_override",
            "payload": {},
        })
        if not r.get("ok"):
            print(f"Error: {r.get('error', r)}", file=sys.stderr)
            return 1
        print("Fan override cleared — returned to thermal auto mode.")
        return 0

    if action == "curve-status":
        try:
            data = _http_get("/api/settings/fan/control-points")
        except Exception as exc:
            print(f"Error reading fan control points: {exc}", file=sys.stderr)
            return 1
        points = data.get("control_points") or []
        if not points:
            print("No fan control points configured.")
            return 1
        print("Fan control points:")
        for point in points:
            print(f"  - {float(point.get('temp_c', 0.0)):g} C -> {float(point.get('duty', 0.0)):g}%")
        runtime_source = data.get("runtime_source")
        runtime_error = data.get("runtime_error")
        if runtime_source:
            print(f"Runtime source: {runtime_source}")
        if runtime_error:
            print(f"Runtime note: {runtime_error}")
        return 0

    if action == "curve-set":
        try:
            points = _parse_fan_curve_specs(getattr(args, "points", []))
        except ValueError as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 1
        try:
            data = _http_put("/api/settings/fan/control-points", {"points": points})
        except Exception as exc:
            print(f"Error setting fan control points: {exc}", file=sys.stderr)
            return 1
        final_points = data.get("control_points") or points
        print(f"Fan control points set: {_format_fan_curve_points(final_points)}")
        if not data.get("runtime_applied", False):
            print(f"Saved to config; thermal runtime update pending ({data.get('runtime_error', 'thermal unavailable')}).")
        return 0

    # tach sub-actions delegated to cmd_fan_tach logic inline
    return cmd_fan_tach(args)


# ── Fan Tach subcommands ──────────────────────────────────────────────────────

def cmd_fan_tach(args) -> int:
    """Enable, disable, or check the fan tachometer."""
    import subprocess
    from pathlib import Path as _P

    # Supports both 'fan-tach <status|enable|disable>' (ft_action)
    # and 'fan tach-<status|enable|disable>' (fan_action with tach- prefix).
    raw = getattr(args, "ft_action", None) or getattr(args, "fan_action", "tach-status")
    action = raw.replace("tach-", "") if raw.startswith("tach-") else raw
    _CONFIG = _P(__file__).resolve().parent.parent / "config" / "thermal.yaml"

    GRN = "\033[32m"; YLW = "\033[33m"; RST = "\033[0m"

    if action == "status":
        r = _request({"cmd": "last", "topic": "thermal.rpm"})
        rpm_data = r.get("payload") or {}
        enabled  = rpm_data.get("enabled", True)
        rpm      = rpm_data.get("rpm")

        # Also check config on disk if daemon is unreachable
        if not r.get("ok") or not rpm_data:
            try:
                import yaml as _yaml
                with open(_CONFIG) as _f:
                    _cfg = _yaml.safe_load(_f) or {}
                enabled = _cfg.get("tach", {}).get("enabled", True)
                rpm = None
            except Exception:
                pass

        state = f"{GRN}enabled{RST}" if enabled else f"{YLW}disabled{RST}"
        rpm_str = str(rpm) if (rpm is not None and enabled) else "—"
        print()
        print("  Fan Tach")
        print(f"    State   : {state}")
        print(f"    RPM     : {rpm_str}")
        print()
        return 0

    if action in ("enable", "disable"):
        try:
            from ruamel.yaml import YAML as _YAML
            _yaml = _YAML()
            _yaml.preserve_quotes = True
            with open(_CONFIG) as _f:
                _cfg = _yaml.load(_f)
            if "tach" not in _cfg:
                _cfg["tach"] = {}
            _cfg["tach"]["enabled"] = (action == "enable")
            with open(_CONFIG, "w") as _f:
                _yaml.dump(_cfg, _f)
        except Exception as exc:
            print(f"Error updating config: {exc}", file=sys.stderr)
            return 1

        ret = subprocess.run(
            ["sudo", "-n", "systemctl", "restart", "desktop-assistant-thermal.service"],
            capture_output=True,
        )
        if ret.returncode != 0:
            print(f"Config updated but thermal service restart failed: {ret.stderr.decode().strip()}",
                  file=sys.stderr)
            return 1

        print(f"Fan tach {'enabled' if action == 'enable' else 'disabled'}.  Thermal service restarted.")
        return 0

    return 1


# ── Quiet Hours subcommands ───────────────────────────────────────────────────

def cmd_quiet_hours(args) -> int:
    """Get or set quiet-hours configuration."""
    action = args.qh_action
    if action == "status":
        try:
            d = _http_get("/api/settings/quiet-hours")
        except Exception as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 1
        enabled = d.get("enabled", False)
        start   = d.get("start", "?")
        end     = d.get("end", "?")
        on  = "\033[32menabled\033[0m"
        off = "\033[33mdisabled\033[0m"
        print()
        print("  Quiet Hours")
        print(f"    State   : {on if enabled else off}")
        print(f"    Hours   : {start} → {end}")
        print()
        return 0

    if action in ("enable", "disable"):
        try:
            current = _http_get("/api/settings/quiet-hours")
        except Exception as exc:
            print(f"Error reading current config: {exc}", file=sys.stderr)
            return 1
        try:
            _http_put("/api/settings/quiet-hours", {
                "enabled": action == "enable",
                "start":   current.get("start", "21:00"),
                "end":     current.get("end",   "06:00"),
            })
        except Exception as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 1
        print(f"Quiet hours {'enabled' if action == 'enable' else 'disabled'}.")
        return 0

    if action == "set":
        try:
            current = _http_get("/api/settings/quiet-hours")
        except Exception as exc:
            print(f"Error reading current config: {exc}", file=sys.stderr)
            return 1
        start = args.start or current.get("start", "21:00")
        end   = args.end   or current.get("end",   "06:00")
        try:
            _http_put("/api/settings/quiet-hours", {
                "enabled": current.get("enabled", False),
                "start": start,
                "end":   end,
            })
        except Exception as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 1
        print(f"Quiet hours set: {start} → {end}  (currently {'enabled' if current.get('enabled') else 'disabled'})")
        return 0

    return 1


def cmd_privacy(args) -> int:
    """Enable, disable, tune, or check the privacy (nudity look-away) service."""
    from pathlib import Path as _P
    action = getattr(args, "privacy_action", "status") or "status"
    _CONFIG = _P(__file__).resolve().parent.parent / "config" / "assistant.yaml"
    GRN = "\033[32m"; YLW = "\033[33m"; RST = "\033[0m"

    if action == "status":
        try:
            d = _http_get("/api/settings/privacy")
        except Exception:
            d = {}
        try:
            import yaml as _yaml
            with open(_CONFIG) as _f:
                _c = _yaml.safe_load(_f) or {}
            d = {**_c.get("privacy", {}), **d}
        except Exception:
            pass
        enabled  = d.get("enabled", True)
        hw       = d.get("hardware_ready", "?")
        rate     = d.get("rate_hz", 1.0)
        thr      = d.get("threshold", 0.6)
        look     = d.get("look_away_angle_deg", 45.0)
        cooldown = d.get("cooldown_s", 10.0)
        clear_n  = d.get("clear_frames", 3)
        announce = d.get("announce", True)
        state    = f"{GRN}enabled{RST}" if enabled else f"{YLW}disabled{RST}"
        hw_str   = (f"{GRN}✓{RST}" if hw is True else f"{YLW}⚠ sim{RST}") if hw != "?" else "?"
        print()
        print("  Privacy (nudity detection)")
        print(f"    State    : {state}")
        print(f"    Hardware : {hw_str}")
        print(f"    Rate     : {rate} Hz")
        print(f"    Threshold: {thr}")
        print(f"    Look away: {look}°")
        print(f"    Cooldown : {cooldown}s")
        print(f"    Clear N  : {clear_n} frame(s)")
        print(f"    Announce : {'yes' if announce else 'no'}")
        if "announce_text" in d:
            print(f"    Say-away : {d.get('announce_text')!r}")
        if "resume_text" in d and d.get("resume_text"):
            print(f"    Say-back : {d.get('resume_text')!r}")
        print()
        return 0

    if action in ("enable", "disable"):
        enabled = (action == "enable")
        try:
            _http_put("/api/settings/privacy", {"enabled": enabled})
        except Exception:
            # Fallback: write config directly
            try:
                from ruamel.yaml import YAML as _YAML
                _yaml = _YAML()
                _yaml.preserve_quotes = True
                with open(_CONFIG) as _f:
                    _cfg = _yaml.load(_f)
                if "privacy" not in _cfg:
                    _cfg["privacy"] = {}
                _cfg["privacy"]["enabled"] = enabled
                with open(_CONFIG, "w") as _f:
                    _yaml.dump(_cfg, _f)
            except Exception as exc:
                print(f"Error: {exc}", file=sys.stderr)
                return 1
        print(f"Privacy detection {'enabled' if enabled else 'disabled'}.")
        return 0

    if action == "set":
        patch = {}
        for key, value in (
            ("rate_hz", getattr(args, "rate_hz", None)),
            ("threshold", getattr(args, "threshold", None)),
            ("look_away_angle_deg", getattr(args, "look_away_deg", None)),
            ("cooldown_s", getattr(args, "cooldown_s", None)),
            ("clear_frames", getattr(args, "clear_frames", None)),
            ("announce_text", getattr(args, "announce_text", None)),
            ("resume_text", getattr(args, "resume_text", None)),
        ):
            if value is not None:
                patch[key] = value
        announce = getattr(args, "announce", None)
        if announce is not None:
            patch["announce"] = announce.lower() == "on"
        if not patch:
            print("Nothing to update. Use one or more --rate-hz/--threshold/--look-away-deg/--cooldown-s/--clear-frames/--announce/--announce-text/--resume-text options.", file=sys.stderr)
            return 1
        try:
            _http_put("/api/settings/privacy", patch)
        except Exception:
            # Fallback: write config directly
            try:
                from ruamel.yaml import YAML as _YAML
                _yaml = _YAML()
                _yaml.preserve_quotes = True
                with open(_CONFIG) as _f:
                    _cfg = _yaml.load(_f)
                if "privacy" not in _cfg:
                    _cfg["privacy"] = {}
                _cfg["privacy"].update(patch)
                with open(_CONFIG, "w") as _f:
                    _yaml.dump(_cfg, _f)
            except Exception as exc:
                print(f"Error: {exc}", file=sys.stderr)
                return 1
        print("Privacy settings updated.")
        return 0

    return 1


def cmd_audio(args) -> int:
    """Show or change audio backend configuration."""
    import json as _json
    from pathlib import Path as _P

    _BASE_URL = "http://localhost:8080"
    GRN = "\033[32m"; YLW = "\033[33m"; CYN = "\033[36m"; RST = "\033[0m"; BLD = "\033[1m"
    action = getattr(args, "audio_action", "status") or "status"
    _EQ_PRESETS = ["flat", "bass_boost", "treble_boost", "vocal", "loudness", "warm", "custom"]

    def _api_get():
        import urllib.request
        with urllib.request.urlopen(f"{_BASE_URL}/api/settings/audio", timeout=5) as resp:
            return _json.loads(resp.read())

    def _api_put(payload):
        import urllib.request
        data = _json.dumps(payload).encode()
        req = urllib.request.Request(
            f"{_BASE_URL}/api/settings/audio",
            data=data,
            method="PUT",
            headers={"Content-Type": "application/json"},
        )
        with urllib.request.urlopen(req, timeout=5) as resp:
            return _json.loads(resp.read())

    def _voice_get():
        import urllib.request
        with urllib.request.urlopen(f"{_BASE_URL}/api/settings/voice", timeout=5) as resp:
            return _json.loads(resp.read())

    def _voice_put(payload):
        import urllib.request
        data = _json.dumps(payload).encode()
        req = urllib.request.Request(
            f"{_BASE_URL}/api/settings/voice",
            data=data,
            method="PUT",
            headers={"Content-Type": "application/json"},
        )
        with urllib.request.urlopen(req, timeout=5) as resp:
            return _json.loads(resp.read())

    if action == "status":
        try:
            d = _api_get()
        except Exception as exc:
            # Fall back to reading config directly
            try:
                import yaml as _yaml
                _cfg_path = _P(__file__).resolve().parent.parent / "config" / "assistant.yaml"
                with open(_cfg_path) as _f:
                    _cfg = _yaml.safe_load(_f) or {}
                d = {"backend": _cfg.get("audio", {}).get("backend", "default")}
                d.update(_cfg.get("audio", {}))
            except Exception:
                print(f"Error: {exc}", file=sys.stderr)
                return 1

        backend = d.get("backend", "default")
        print()
        print(f"  {BLD}Audio Backend{RST}")
        print(f"    Active backend : {GRN}{backend}{RST}")
        backend_cfg = d.get(backend, {})
        for k, v in backend_cfg.items():
            print(f"    {k:<30}: {v}")
        devices = d.get("available_input_devices", [])
        if devices:
            print()
            print(f"  {BLD}Available Input Devices{RST}")
            for dev in devices:
                print(f"    [{dev['index']}] {dev['name']}  ({dev['channels']} ch)")
        print()
        return 0

    if action == "volume":
        level = getattr(args, "level", None)
        try:
            if level is None:
                d = _http_get("/api/music/volume")
                lvl = int(d.get("level", -1))
                print("Volume: (unavailable)" if lvl < 0 else f"Volume: {lvl}%")
            else:
                if level < 0 or level > 100:
                    print("Volume must be 0–100", file=sys.stderr)
                    return 1
                _http_put("/api/music/volume", {"level": int(level)})
                print(f"Volume set to {level}%")
            return 0
        except Exception as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 1

    if action == "mute":
        state = getattr(args, "state", None)
        try:
            if state is None:
                d = _http_get("/api/audio/mute")
                print(f"Muted: {'yes' if d.get('muted', False) else 'no'}")
            else:
                muted = str(state).lower() == "on"
                _http_put("/api/audio/mute", {"muted": muted})
                print("Audio muted." if muted else "Audio unmuted.")
            return 0
        except Exception as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 1

    if action == "repeat":
        try:
            d = _http_post("/api/audio/repeat", {})
            if not d.get("ok", False):
                print(d.get("error", "No spoken phrase available"), file=sys.stderr)
                return 1
            print(f"Repeating: {d.get('text', '')}")
            return 0
        except _urllib_error.HTTPError as exc:
            if exc.code == 404:
                print("No spoken phrase available yet.", file=sys.stderr)
            else:
                print(f"Error: HTTP {exc.code}", file=sys.stderr)
            return 1
        except Exception as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 1

    if action == "input-gain":
        level = getattr(args, "level", None)
        try:
            if level is None:
                d = _http_get("/api/audio/input-gain")
                if not d.get("available", False):
                    print("Input gain: unavailable")
                else:
                    print(f"Input gain: {int(d.get('level', 0))}%")
            else:
                if level < 0 or level > 100:
                    print("Input gain must be 0–100", file=sys.stderr)
                    return 1
                _http_put("/api/audio/input-gain", {"level": int(level)})
                print(f"Input gain set to {level}%")
            return 0
        except Exception as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 1

    if action == "eq":
        preset = getattr(args, "preset", None)
        try:
            if preset is None:
                d = _http_get("/api/music/eq")
                current = d.get("preset", "flat")
                presets = d.get("presets", _EQ_PRESETS)
                print(f"EQ preset: {current}")
                print(f"Available: {', '.join(presets)}")
            else:
                if preset not in _EQ_PRESETS:
                    print(f"Unknown preset '{preset}'. Valid: {', '.join(_EQ_PRESETS)}", file=sys.stderr)
                    return 1
                _http_put("/api/music/eq", {"preset": preset})
                print(f"EQ preset set to '{preset}'")
            return 0
        except Exception as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 1

    if action == "eq-custom":
        bands = []
        for spec in getattr(args, "band", []) or []:
            if "=" in spec:
                parts = dict(p.split("=") for p in spec.split(","))
                hz = float(parts.get("hz", 1000))
                gain = float(parts.get("gain", 0))
                q = float(parts.get("q", 1.0))
            elif ":" in spec:
                pieces = spec.split(":")
                hz = float(pieces[0]) if len(pieces) > 0 else 1000.0
                gain = float(pieces[1]) if len(pieces) > 1 else 0.0
                q = float(pieces[2]) if len(pieces) > 2 else 1.0
            else:
                print(f"Cannot parse band spec: {spec!r}", file=sys.stderr)
                return 1
            bands.append({"hz": hz, "gain_db": gain, "q": q})
        try:
            _http_put("/api/music/eq/custom", {"bands": bands})
            print(f"Custom EQ applied ({len(bands)} band(s)).")
            return 0
        except Exception as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 1

    if action == "set-backend":
        backend = getattr(args, "backend_name", None)
        if not backend:
            print("Usage: vera audio set-backend <default|respeaker_flex>", file=sys.stderr)
            return 1
        try:
            d = _api_put({"backend": backend})
            if not d.get("ok"):
                print(f"Error: {d.get('message', d)}", file=sys.stderr)
                return 1
            print(f"Backend set to {GRN}{backend}{RST}.")
            print(f"{YLW}Restart the service to apply: sudo systemctl restart desktop-assistant-core{RST}")
            return 0
        except Exception as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 1

    if action == "set":
        # Expect: vera audio set [--backend <b>] key=value [key=value ...]
        pairs = getattr(args, "settings", []) or []
        target_backend = getattr(args, "backend", None)
        if not pairs:
            print("Usage: vera audio set [--backend default|respeaker_flex] key=value ...", file=sys.stderr)
            return 1
        try:
            current = _api_get()
        except Exception as exc:
            print(f"Error fetching current config: {exc}", file=sys.stderr)
            return 1

        active_backend = target_backend or current.get("backend", "default")
        section = dict(current.get(active_backend, {}))

        for pair in pairs:
            if "=" not in pair:
                print(f"Bad key=value pair: {pair!r}  (expected key=value)", file=sys.stderr)
                return 1
            k, _, v = pair.partition("=")
            k = k.strip()
            # Coerce value type
            if v.lower() in ("true", "false"):
                section[k] = v.lower() == "true"
            else:
                try:
                    section[k] = int(v)
                except ValueError:
                    try:
                        section[k] = float(v)
                    except ValueError:
                        section[k] = v

        payload = {"backend": active_backend, active_backend: section}
        try:
            d = _api_put(payload)
            if not d.get("ok"):
                print(f"Error: {d}", file=sys.stderr)
                return 1
            print(f"Audio settings updated for {GRN}{active_backend}{RST}.")
            print(f"{YLW}Restart the service to apply: sudo systemctl restart desktop-assistant-core{RST}")
            return 0
        except Exception as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 1

    if action == "devices":
        try:
            d = _api_get()
            devices = d.get("available_input_devices", [])
        except Exception:
            # Try direct sounddevice query
            try:
                import sounddevice as _sd
                all_devs = _sd.query_devices()
                devices = [
                    {"index": i, "name": dev["name"], "channels": dev.get("max_input_channels", 0)}
                    for i, dev in enumerate(all_devs)
                    if dev.get("max_input_channels", 0) > 0
                ]
            except Exception as exc:
                print(f"Error: {exc}", file=sys.stderr)
                return 1

        if not devices:
            print("No input devices found.")
            return 0
        print()
        print(f"  {BLD}Available Input Devices{RST}")
        for dev in devices:
            print(f"    [{dev['index']}] {dev['name']}  ({dev['channels']} ch)")
        print()
        return 0

    if action == "stt-status":
        try:
            d = _voice_get()
            print()
            print(f"  {BLD}Voice STT{RST}")
            print(f"    Enabled                : {GRN if d.get('enabled') else YLW}{d.get('enabled', False)}{RST}")
            print(f"    Wake backend           : {d.get('wake_backend', 'energy')}")
            print(f"    OWW model              : {d.get('oww_model', 'hey_jarvis_v0.1')}")
            print(f"    OWW threshold          : {d.get('oww_threshold', 0.5)}")
            print(f"    OWW refractory (s)     : {d.get('oww_refractory_s', 2.0)}")
            print(f"    Wake threshold (dBFS)  : {d.get('wake_threshold_dbfs', -38.0)}")
            print(f"    Wake cooldown (s)      : {d.get('wake_cooldown_s', 1.5)}")
            print(f"    STT backend            : {d.get('stt_backend', 'faster_whisper')}")
            print(f"    STT model              : {d.get('stt_model', 'base.en')}")
            print(f"    STT language           : {d.get('stt_language', 'en')}")
            print(f"    STT timeout (s)        : {d.get('stt_timeout_s', 60.0)}")
            print(f"    STT command            : {d.get('stt_command', '') or '(not set)'}")
            print(f"    Sample rate            : {d.get('sample_rate', 16000)}")
            print(f"    Available wake backends: {', '.join(d.get('available_wake_backends', ['energy', 'openwakeword']))}")
            print(f"    Available STT backends : {', '.join(d.get('available_stt_backends', ['faster_whisper', 'shell', 'null']))}")
            print()
            return 0
        except Exception as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 1

    if action in ("stt-enable", "stt-disable"):
        enabled = action == "stt-enable"
        try:
            _voice_put({"enabled": enabled})
            print(f"STT {'enabled' if enabled else 'disabled'}.")
            return 0
        except Exception as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 1

    if action == "stt-set":
        pairs = getattr(args, "settings", []) or []
        if not pairs:
            print(
                "Usage: vera audio stt-set key=value ... "
                "(keys: enabled,poll_seconds,sample_rate,"
                "wake_backend,oww_model,oww_threshold,oww_refractory_s,"
                "wake_cooldown_s,wake_threshold_dbfs,wake_consecutive_frames,"
                "command_min_s,command_max_s,silence_end_s,"
                "stt_backend,stt_command,stt_language,stt_timeout_s,"
                "stt_cpu_threads,dialog_timeout_s)",
                file=sys.stderr,
            )
            return 1
        patch = {}
        for pair in pairs:
            if "=" not in pair:
                print(f"Bad key=value pair: {pair!r}  (expected key=value)", file=sys.stderr)
                return 1
            k, _, v = pair.partition("=")
            k = k.strip()
            v = v.strip()
            if v.lower() in ("true", "false"):
                patch[k] = v.lower() == "true"
            else:
                try:
                    patch[k] = int(v)
                except ValueError:
                    try:
                        patch[k] = float(v)
                    except ValueError:
                        patch[k] = v
        try:
            d = _voice_put(patch)
            if not d.get("ok", False):
                print(f"Error: {d}", file=sys.stderr)
                return 1
            print("STT settings updated.")
            return 0
        except Exception as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 1

    return 1


