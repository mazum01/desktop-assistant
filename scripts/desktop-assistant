    dep_sub.add_parser("status",       help="Show depth enabled state and hardware readiness").set_defaults(func=cmd_depth)
    dep_sub.add_parser("query",        help="Show nearest/farthest/mean depth stats").set_defaults(func=cmd_depth)
    dep_sub.add_parser("dense-enable", help="Enable dense stereo depth").set_defaults(func=cmd_depth)
    dep_sub.add_parser("dense-disable",help="Disable dense stereo depth").set_defaults(func=cmd_depth)
    dep_sub.add_parser("mono-enable",  help="Enable monocular Hailo-8 depth").set_defaults(func=cmd_depth)
    dep_sub.add_parser("mono-disable", help="Disable monocular depth").set_defaults(func=cmd_depth)

    # ── Snapshot ──────────────────────────────────────────────────────
    snap_sp = sub.add_parser("snapshot", help="Save a full-resolution JPEG snapshot from a camera")
