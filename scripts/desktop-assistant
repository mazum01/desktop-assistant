def cmd_record(args) -> int:
    """Record a microphone clip to WAV."""
    payload = {"seconds": float(args.seconds)}
    if getattr(args, "output", None):
        payload["path"] = args.output
    result: dict = {}
    error: list[Exception] = []

    def _call_record() -> None:
        try:
            result.update(
                _http_post(
                    "/api/audio/record",
                    payload,
                    timeout=max(30, int(args.seconds) + 30),
                )
            )
        except Exception as exc:
            error.append(exc)

    t = threading.Thread(target=_call_record, daemon=True)
    t.start()
    started = time.time()
    total = max(1.0, float(args.seconds))
    while t.is_alive():
        elapsed = time.time() - started
        left = max(0.0, total - elapsed)
        sys.stdout.write(f"\rRecording... {left:4.1f}s left")
        sys.stdout.flush()
        time.sleep(0.1)
    t.join()
    sys.stdout.write("\r" + (" " * 36) + "\r")
    sys.stdout.flush()

    if error:
        print(f"Error: {error[0]}", file=sys.stderr)
        return 1
    try:
        d = result
    except Exception:
        print("Error: record request failed", file=sys.stderr)
        return 1
    if not d.get("ok"):
        print(json.dumps(d, indent=2))
        return 1
    print(f"Recorded {d.get('seconds', 0):.2f}s to {d.get('path', '(unknown)')}")
    return 0


def cmd_playback(args) -> int:
    """Play a recorded WAV clip."""
    payload = {}
    if getattr(args, "input", None):
        payload["path"] = args.input
    try:
        d = _http_post("/api/audio/playback", payload, timeout=90)
    except Exception as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1
    if not d.get("ok"):
        print(json.dumps(d, indent=2))
        return 1
    print(f"Played {d.get('seconds', 0):.2f}s from {d.get('path', '(unknown)')}")
    return 0


# ── Depth estimation subcommands ──────────────────────────────────────────────

def cmd_depth(args) -> int:
    """Status, toggle, or query depth estimation."""
    action = getattr(args, "depth_action", "status")

    if action == "status":
        try:
            d = _http_get("/api/settings/depth")
        except Exception as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 1
        dense_en  = d.get("dense_enabled", False)
        mono_en   = d.get("mono_enabled", False)
        cal       = d.get("calibrated", False)
        mono_hw   = d.get("mono_hardware_ready", False)
        on  = "\033[32menabled\033[0m"
        off = "\033[33mdisabled\033[0m"
        ok  = "\033[32m✓\033[0m"
        no  = "\033[31m✗\033[0m"
        print()
        print("  Depth Estimation")
        print(f"    Dense stereo : {on if dense_en else off}  (calibrated: {ok if cal else no})")
        print(f"    Mono (Hailo) : {on if mono_en else off}  (hardware ready: {ok if mono_hw else no})")
        print()
        return 0

    if action == "query":
        try:
            d = _http_get("/api/depth/query")
        except Exception as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 1
        src = d.get("source", "unknown")
        print()
        print(f"  Depth Query  [{src}]")
        print(f"    Nearest   : {d.get('nearest_m', '?')} m")
        print(f"    Farthest  : {d.get('farthest_m', '?')} m")
        print(f"    Mean      : {d.get('mean_m', '?')} m")
        faces = d.get("faces", [])
        if faces:
            print(f"    Faces     :")
            for f in faces:
                print(f"      {f.get('name', '?')} — {f.get('depth_m', '?')} m")
        print()
        return 0

    # enable/disable dense or mono
    if action in ("dense-enable", "dense-disable", "mono-enable", "mono-disable"):
        kind   = "dense" if action.startswith("dense") else "mono"
        enable = action.endswith("enable")
        key    = "dense_enabled" if kind == "dense" else "mono_enabled"
        try:
            current = _http_get("/api/settings/depth")
            current[key] = enable
            d = _http_put("/api/settings/depth", {
                "dense_enabled": current.get("dense_enabled", False),
                "mono_enabled":  current.get("mono_enabled", False),
            })
        except Exception as exc:
            print(f"Error: {exc}", file=sys.stderr)
            return 1
        label = "enabled" if enable else "disabled"
        print(f"{kind.capitalize()} depth {label}.")
        return 0

    return 1


# ── Snapshot ──────────────────────────────────────────────────────────────────

def cmd_snapshot(args) -> int:
    """Download a full-resolution JPEG snapshot from camera 1."""
    output = getattr(args, "output", None)
    camera = getattr(args, "camera", 1)
    path_str = output or f"snapshot_cam{camera}.jpg"
    api_path = "/api/snapshot" if camera == 1 else "/api/snapshot2"
    url = _http_base() + api_path
    try:
        with _urllib_request.urlopen(url, timeout=10) as resp:
            data = resp.read()
        output_path = Path(path_str)
        output_path.write_bytes(data)
        print(f"Saved {len(data):,} bytes → {output_path.resolve()}")
        return 0
    except Exception as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1


def cmd_forget_faces(_args) -> int:
    from src.perception.face_registry import FaceRegistry
    reg = FaceRegistry()
    count = reg.delete_all_faces()
    reg.close()
    print(f"Deleted {count} face(s) from the registry.")
    return 0


def cmd_forget_guests(_args) -> int:
    from src.perception.face_registry import FaceRegistry
    reg = FaceRegistry()
    count = reg.delete_guest_faces()
    reg.close()
    print(f"Deleted {count} guest face(s) from the registry.")
    return 0


def cmd_refresh_faces(_args) -> int:
    """Reload face embedding cache and reset tracking state so faces are re-identified."""
    r = _request({"cmd": "publish", "topic": "face.refresh", "payload": {}})
    if r.get("ok"):
        print("Face embedding cache reloaded — faces will be re-identified on next frame.")
    else:
        print(f"Warning: daemon publish failed ({r.get('error', '?')}); reloading cache locally.")
        from src.perception.face_registry import FaceRegistry
        reg = FaceRegistry()
        reg.reload()
        reg.close()
        print("Cache reloaded locally.")
    return 0


def cmd_clean_gallery(_args) -> int:
    """Prune stale/outlier embeddings from the face gallery to fix mis-identification."""
    from src.perception.face_registry import FaceRegistry
    reg = FaceRegistry()
    removed = reg.prune_gallery()
    reg.close()
    if removed:
        print(f"Pruned {removed} outlier embedding(s) from the gallery.")
        print("Run 'da face refresh' to reload the daemon's embedding cache.")
    else:
        print("Gallery is already clean — no outlier embeddings found.")
    return 0


def cmd_clear_embeddings(args) -> int:
    """Clear all embeddings for a face identity (by name or ID prefix) to force re-enrollment."""
    from src.perception.face_registry import FaceRegistry
    reg = FaceRegistry()
    faces = reg.list_faces()
    target = args.name_or_id
    # Match by full ID, 8-char ID prefix, or case-insensitive name
    match = next(
        (f for f in faces if f["id"] == target
         or f["id"].startswith(target)
         or f["name"].lower() == target.lower()),
        None,
    )
    if not match:
        print(f"Error: no face found matching {target!r}. Use 'da face list' to see IDs and names.")
        reg.close()
        return 1
    removed = reg.clear_embeddings(match["id"])
    reg.close()
    if removed >= 0:
        print(f"Cleared {removed} embedding(s) for {match['name']!r} ({match['id'][:8]}…).")
        print("The gallery for this identity will rebuild from scratch on next sighting.")
        print("Run 'da face refresh' to reload the daemon's embedding cache.")
    else:
        print("Error: face not found (ID mismatch).")
        return 1
    return 0


def cmd_list_faces(_args) -> int:
    from src.perception.face_registry import FaceRegistry
    reg = FaceRegistry()
    faces = reg.list_faces()
    reg.close()
    if not faces:
        print("No faces in registry.")
        return 0
    col = max(len(f["name"]) for f in faces) + 2
    print(f"\n{'Name':<{col}}  {'ID (first 8)'}  {'Seen':>5}  {'Last Seen'}")
    print("─" * (col + 40))
    import time
    for f in faces:
        age = int(time.time() - f["last_seen"])
        if age < 60:
            age_str = f"{age}s ago"
        elif age < 3600:
            age_str = f"{age//60}m ago"
        else:
            age_str = f"{age//3600}h ago"
        print(f"  {f['name']:<{col}}  {f['id'][:8]}…  {f['seen_count']:>5}  {age_str}")
    print()
    return 0


def cmd_merge_faces(args) -> int:
    from src.perception.face_registry import FaceRegistry
    reg = FaceRegistry()
    keep = reg.get_face(args.keep_id)
    absorb = reg.get_face(args.absorb_id)
    if not keep:
        print(f"Error: keep_id {args.keep_id!r} not found.")
        reg.close()
        return 1
    if not absorb:
        print(f"Error: absorb_id {args.absorb_id!r} not found.")
        reg.close()
        return 1
    ok = reg.merge_faces(args.keep_id, args.absorb_id)
    reg.close()
    if ok:
        print(f"Merged {absorb['name']!r} ({args.absorb_id[:8]}…) into {keep['name']!r} ({args.keep_id[:8]}…).")
    else:
        print("Merge failed.")
    return 0 if ok else 1


def cmd_greeting_cooldown(args) -> int:
    """Set the base face greeting cooldown (minutes)."""
    minutes = float(args.minutes)
    if minutes < 1:
        print("Error: cooldown must be at least 1 minute")
        return 1
    r = _publish("tracking.set_greeting_cooldown", {"cooldown_min": minutes})
    if r is None:
        print(f"Greeting cooldown set to {minutes:.1f} minutes (bus publish; daemon may not be running).")
    else:
        print(f"Greeting cooldown updated to {minutes:.1f} minutes.")
    return 0


def cmd_greeting_settings(_args) -> int:
    """Show current greeting configuration from assistant.yaml / runtime_state.yaml."""
    import yaml
    cfg_path  = Path(__file__).resolve().parent.parent / "config" / "assistant.yaml"
    rt_path   = Path(__file__).resolve().parent.parent / "config" / "runtime_state.yaml"
    cfg: dict = {}
    rt: dict  = {}
    try:
        with open(cfg_path) as f:
            cfg = yaml.safe_load(f) or {}
    except Exception as exc:
        print(f"Warning: could not read assistant.yaml: {exc}")
    try:
        with open(rt_path) as f:
            rt = yaml.safe_load(f) or {}
    except FileNotFoundError:
        pass
    except Exception as exc:
        print(f"Warning: could not read runtime_state.yaml: {exc}")

    fr = cfg.get("face_recognition", {})
    rt_fr = rt.get("face_recognition", {})
    # Runtime state overrides these 4 tunables when present (persisted via
    # tracking.set_greeting_cooldown → tracking.greeting_cooldown_changed).
    cooldown_min = rt_fr.get("greeting_cooldown_min", fr.get("greeting_cooldown_min", 30.0))
    jitter_pct   = rt_fr.get("greeting_cooldown_jitter_pct", fr.get("greeting_cooldown_jitter_pct", 25.0))
    min_abs_s    = rt_fr.get("min_absence_s", fr.get("min_absence_s", 30.0))
    confidence   = rt_fr.get("confidence_threshold", fr.get("confidence_threshold", 0.5))
    enabled      = fr.get("enabled", True)

    W = 34
    BOLD = "\033[1m"; RST = "\033[0m"; GRN = "\033[32m"; RED = "\033[31m"
    status_str = f"{GRN}enabled{RST}" if enabled else f"{RED}disabled{RST}"
    print()
    print(f"{BOLD}Greeting Settings{RST}")
    print("─" * W)
    print(f"  {'Face recognition':<20} {status_str}")
    print(f"  {'Cooldown (base)':<20} {cooldown_min:.1f} min")
    print(f"  {'Jitter':<20} ±{jitter_pct:.0f}%  ({cooldown_min*(1-jitter_pct/100):.1f}–{cooldown_min*(1+jitter_pct/100):.1f} min)")
    print(f"  {'Min absence':<20} {min_abs_s:.0f} s")
    print(f"  {'Min confidence':<20} {confidence:.2f}")
    print()
    return 0


def cmd_restart(_args) -> int:
    """Restart the vera-core systemd service."""
    import subprocess
    print("Restarting desktop-assistant-core.service …")
    result = subprocess.run(
        ["sudo", "systemctl", "restart", "desktop-assistant-core.service"],
        capture_output=True, text=True,
    )
    if result.returncode != 0:
        print(f"Error: {result.stderr.strip() or 'unknown error'}")
        return 1
    print("Service restarted. Use 'da ping' to confirm it is back up.")
    return 0


def cmd_reboot(_args) -> int:
    """Reboot the Raspberry Pi."""
    import subprocess, time
    ans = input("Reboot the Raspberry Pi? [y/N] ").strip().lower()
    if ans != "y":
        print("Aborted.")
        return 0
    print("Centering head …")
    try:
        _http_post("/api/pan", {"angle": 180}, timeout=2)
        time.sleep(1.2)
    except Exception:
        pass
    print("Rebooting …")
    result = subprocess.run(["sudo", "reboot"], capture_output=True, text=True)
    if result.returncode != 0:
        print(f"Error: {result.stderr.strip() or 'unknown error'}")
        return 1
    return 0


def cmd_shutdown(_args) -> int:
    """Shut down the Raspberry Pi."""
    import subprocess, time
    ans = input("Shut down the Raspberry Pi? It will need to be powered on manually. [y/N] ").strip().lower()
    if ans != "y":
        print("Aborted.")
        return 0
    print("Centering head …")
    try:
        _http_post("/api/pan", {"angle": 180}, timeout=2)
        time.sleep(1.2)
    except Exception:
        pass
    print("Shutting down …")
    result = subprocess.run(["sudo", "shutdown", "-h", "now"], capture_output=True, text=True)
    if result.returncode != 0:
        print(f"Error: {result.stderr.strip() or 'unknown error'}")
        return 1
    return 0



# ── Camera 1 subcommands ──────────────────────────────────────────────────────

def cmd_camera(args) -> int:
    sub = args.camera_cmd
    if sub == "resolution":
        parts = args.resolution.split("x")
        if len(parts) != 2:
            print(f"Invalid format: {args.resolution!r}. Use WxH e.g. 640x480", file=sys.stderr)
            return 1
        try:
            w, h = int(parts[0]), int(parts[1])
        except ValueError:
            print(f"Invalid resolution: {args.resolution!r}", file=sys.stderr)
            return 1
        r = _request({
            "cmd": "publish",
            "topic": "camera.set_resolution",
            "payload": {"width": w, "height": h},
        })
        if r.get("ok"):
            print(f"Camera resolution set to {w}×{h}")
        else:
            print(json.dumps(r, indent=2))
        return 0 if r.get("ok") else 1
    if sub == "rotation":
        deg = int(args.degrees) % 360
        r = _request({"cmd": "publish", "topic": "camera.set_rotation",
                      "payload": {"rotation_deg": deg}})
        if r.get("ok"):
            print(f"Camera 1 rotation set to {deg}°")
        else:
            print(json.dumps(r, indent=2))
        return 0 if r.get("ok") else 1
    if sub == "rotation-status":
        import yaml as _yaml
        _base = Path(__file__).resolve().parents[1]
        _cfg, _rt = {}, {}
        try:
            _cfg = _yaml.safe_load((_base / "config" / "assistant.yaml").read_text()) or {}
        except Exception:
            pass
        try:
            _rt = _yaml.safe_load((_base / "config" / "runtime_state.yaml").read_text()) or {}
        except Exception:
            pass
        deg = _rt.get("camera", {}).get(
            "rotation_deg",
            _cfg.get("camera", {}).get("rotation_deg", 0),
        )
        print(f"  Camera 1 rotation : {deg}°")
        return 0
    if sub == "stream-resolution":
        parts = args.resolution.split("x")
        if len(parts) != 2:
            print(f"Invalid format: {args.resolution!r}. Use WxH e.g. 640x360", file=sys.stderr)
            return 1
        try:
            w, h = int(parts[0]), int(parts[1])
        except ValueError:
            print(f"Invalid resolution: {args.resolution!r}", file=sys.stderr)
            return 1
        r = _request({
            "cmd": "publish",
            "topic": "camera.set_stream_resolution",
            "payload": {"width": w, "height": h},
        })
        if r.get("ok"):
            print(f"Camera 1 stream resolution set to {w}×{h}")
        else:
            print(json.dumps(r, indent=2))
        return 0 if r.get("ok") else 1
    if sub == "stream-resolution-status":
        import yaml as _yaml
        _base = Path(__file__).resolve().parents[1]
        _cfg, _rt = {}, {}
        try:
            _cfg = _yaml.safe_load((_base / "config" / "assistant.yaml").read_text()) or {}
        except Exception:
            pass
        try:
            _rt = _yaml.safe_load((_base / "config" / "runtime_state.yaml").read_text()) or {}
        except Exception:
            pass
        w = _rt.get("camera", {}).get(
            "stream_width", _cfg.get("camera", {}).get("stream_width", 640)
        )
        h = _rt.get("camera", {}).get(
            "stream_height", _cfg.get("camera", {}).get("stream_height", 360)
        )
        print(f"  Camera 1 stream resolution : {w}×{h}")
        return 0
    return 1


