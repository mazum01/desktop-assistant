    # ── Consolidated servo subcommands ───────────────────────────────
    servo_sp = sub.add_parser("servo", help="Servo control (enable/disable/status/pan/move)")
    servo_sub = servo_sp.add_subparsers(dest="servo_cmd", metavar="<servo-command>")
