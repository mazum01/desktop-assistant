#!/usr/bin/env python3
"""
desktop-assistant CLI — control the running daemon over ZeroMQ.

Examples:
    desktop-assistant ping
    desktop-assistant pan --to 90
    desktop-assistant move-servo 90 1500
    desktop-assistant say "hello world"
    desktop-assistant version
    desktop-assistant topics
    desktop-assistant last thermal.temp
    desktop-assistant watch                  # stream all bus events
    desktop-assistant watch --topic motion   # filter by prefix

Talks to the IPCBridge service over ZMQ at:
    REP : ipc:///tmp/desktop-assistant.rep
    PUB : ipc:///tmp/desktop-assistant.pub
Override with $DA_BUS_PUB_ENDPOINT / $DA_BUS_REP_ENDPOINT.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
import time
import uuid

try:
    import zmq
except ImportError:
    print("pyzmq is required: sudo apt-get install -y python3-zmq", file=sys.stderr)
    sys.exit(2)


PUB_ENDPOINT = os.environ.get("DA_BUS_PUB_ENDPOINT", "ipc:///tmp/desktop-assistant.pub")
REP_ENDPOINT = os.environ.get("DA_BUS_REP_ENDPOINT", "ipc:///tmp/desktop-assistant.rep")
_ANNOUNCE_OVERLAP_SEC = 0.22


def _request(req: dict, timeout_ms: int = 2000) -> dict:
    ctx = zmq.Context.instance()
    sock = ctx.socket(zmq.REQ)
    sock.setsockopt(zmq.LINGER, 0)
    sock.setsockopt(zmq.RCVTIMEO, timeout_ms)
    sock.setsockopt(zmq.SNDTIMEO, timeout_ms)
    try:
        sock.connect(REP_ENDPOINT)
        sock.send_string(json.dumps(req))
        return json.loads(sock.recv_string())
    except zmq.error.Again:
        return {"ok": False, "error": "timeout — is desktop-assistant-core running?"}
    finally:
        sock.close(linger=0)


def _estimate_tts_duration_s(text: str) -> float:
    """Query the daemon for exact TTS render duration; fall back to a
    word/char heuristic when the daemon is not reachable."""
    r = _request({"cmd": "tts_duration", "text": text}, timeout_ms=10000)
    if r.get("ok") and isinstance(r.get("duration_s"), (int, float)):
        return float(r["duration_s"])
    # Offline heuristic fallback
    words = max(1, len(text.split()))
    return max(0.75, 0.16 * words + 0.018 * len(text) + 0.2)


def _wait_for_spoken_text(expected_text: str, timeout_s: float, request_id: str | None = None) -> bool:
    """Wait until av.spoke confirms the requested text (or request id)."""
    ctx = zmq.Context.instance()
    sub = ctx.socket(zmq.SUB)
    sub.setsockopt(zmq.LINGER, 0)
    sub.setsockopt_string(zmq.SUBSCRIBE, "av.spoke")
    sub.connect(PUB_ENDPOINT)

    # Allow the SUB socket to join before the matching av.say is published.
    time.sleep(0.15)

    deadline = time.monotonic() + timeout_s
    poller = zmq.Poller()
    poller.register(sub, zmq.POLLIN)

    try:
        while time.monotonic() < deadline:
            remaining_ms = max(1, int((deadline - time.monotonic()) * 1000))
            events = dict(poller.poll(timeout=remaining_ms))
            if sub not in events:
                continue
            try:
                topic, raw_payload = sub.recv_multipart(flags=zmq.NOBLOCK)
            except zmq.error.Again:
                continue
            if topic.decode("utf-8") != "av.spoke":
                continue
            try:
                payload = json.loads(raw_payload.decode("utf-8"))
            except Exception:
                continue
            if not isinstance(payload, dict):
                continue
            if request_id is not None and payload.get("request_id") == request_id:
                return True
            if payload.get("text") == expected_text:
                return True
    finally:
        sub.close(linger=0)

    # Backward-compatible fallback when PUB/SUB delivery misses due to
    # join timing or older services only expose the most recent payload.
    baseline = _request({"cmd": "last", "topic": "av.spoke"}, timeout_ms=1500)
    baseline_payload = baseline.get("payload") if baseline.get("ok") else None

    deadline = time.monotonic() + timeout_s
    while time.monotonic() < deadline:
        r = _request({"cmd": "last", "topic": "av.spoke"}, timeout_ms=1500)
        if r.get("ok"):
            payload = r.get("payload")
            if isinstance(payload, dict):
                if request_id is not None and payload.get("request_id") == request_id:
                    return True
                if payload.get("text") == expected_text and payload != baseline_payload:
                    return True
        time.sleep(0.05)
    return False


def cmd_ping(_args) -> int:
    r = _request({"cmd": "ping"})
    print(json.dumps(r, indent=2))
    return 0 if r.get("ok") else 1


def cmd_topics(_args) -> int:
    r = _request({"cmd": "topics"})
    if not r.get("ok"):
        print(r); return 1
    for t in r.get("topics", []):
        print(t)
    return 0


def cmd_last(args) -> int:
    r = _request({"cmd": "last", "topic": args.topic})
    print(json.dumps(r, indent=2))
    return 0 if r.get("ok") else 1


def cmd_publish(args) -> int:
    payload = json.loads(args.payload) if args.payload else None
    r = _request({"cmd": "publish", "topic": args.topic, "payload": payload})
    print(json.dumps(r, indent=2))
    return 0 if r.get("ok") else 1


def cmd_pan(args) -> int:
    payload = {"angle": args.to}
    timeout_ms = 2000
    if args.move_time_ms is not None:
        payload["move_time_ms"] = args.move_time_ms
        timeout_ms = max(2000, int(float(args.move_time_ms)) + 3000)
    r = _request({
        "cmd": "publish",
        "topic": "motion.pan_to",
        "payload": payload,
    }, timeout_ms=timeout_ms)
    print(json.dumps(r, indent=2))
    return 0 if r.get("ok") else 1


def cmd_move_servo(args) -> int:
    timeout_ms = max(2000, int(float(args.move_time_ms)) + 3000)

    if args.announce_start:
        start_text = f"Starting servo move to {args.position:.1f} degrees."
        start_req = _request({
            "cmd": "publish",
            "topic": "av.say",
            "payload": {
                "text": start_text,
                "request_id": str(uuid.uuid4()),
            },
        })
        if not start_req.get("ok"):
            print(json.dumps(start_req, indent=2))
            return 1
        lead_time_s = max(0.0, _estimate_tts_duration_s(start_text) - _ANNOUNCE_OVERLAP_SEC)
        time.sleep(lead_time_s)

    r = _request({
        "cmd": "publish",
        "topic": "motion.pan_to",
        "payload": {
            "angle": args.position,
            "move_time_ms": args.move_time_ms,
        },
    }, timeout_ms=timeout_ms)

    if r.get("ok") and args.announce_finish:
        _request({
            "cmd": "publish",
            "topic": "av.say",
            "payload": {
                "text": f"Servo move stopped at {args.position:.1f} degrees.",
            },
        })

    print(json.dumps(r, indent=2))
    return 0 if r.get("ok") else 1


def cmd_meet(args) -> int:
    """Name the most recently seen face."""
    r = _request({
        "cmd": "publish",
        "topic": "face.meet",
        "payload": {"name": args.name},
    })
    print(json.dumps(r, indent=2))
    return 0 if r.get("ok") else 1


def cmd_say(args) -> int:
    r = _request({
        "cmd": "publish",
        "topic": "av.say",
        "payload": {"text": args.text},
    })
    print(json.dumps(r, indent=2))
    return 0 if r.get("ok") else 1


def cmd_help(args) -> int:
    """Print a formatted command reference, or detailed help for one command."""
    commands = {
        "ping":        "Round-trip latency check — confirms the daemon is reachable.",
        "status":      "Health and telemetry dashboard (temp, fan, servo, vision, audio).\n"
                       "               --json  Emit raw JSON instead of the human-readable table.",
        "topics":      "List every bus topic that has at least one active subscriber.",
        "last":        "Show the most recent payload published on a given topic.\n"
                       "               Usage: last <topic>",
        "watch":       "Stream live bus events to stdout (Ctrl-C to stop).\n"
                       "               --topic <prefix>  Filter to topics starting with <prefix>.",
        "say":         "Speak a phrase through the speakers via neural TTS.\n"
                       "               Usage: say \"<text>\"",
        "version":     "Have the assistant speak its current version number.",
        "pan":         "Pan the servo head to a logical angle (1–360°).\n"
                       "               --to <deg>            Target angle (required).\n"
                       "               --move-time-ms <ms>   Optional movement duration.",
        "move-servo":  "Move servo with explicit position and move time.\n"
                       "               Usage: move-servo <deg> <ms>\n"
                       "               -as  Announce before moving.\n"
                       "               -af  Announce when finished.",
        "meet":        "Assign a name to the most recently seen face.\n"
                       "               Usage: meet \"<Name>\"",
        "publish":     "Publish a raw JSON event onto the internal bus (advanced).\n"
                       "               Usage: publish <topic> [--payload '{...}']",
        "help":        "Show this command reference, or help for a specific command.\n"
                       "               Usage: help [command]",
    }

    if hasattr(args, "command") and args.command:
        name = args.command
        if name not in commands:
            print(f"Unknown command: {name!r}\n")
            print("Available commands: " + ", ".join(commands))
            return 1
        print(f"\ndesktop-assistant {name}")
        print("─" * (len(name) + 21))
        print(commands[name])
        print(f"\nFor argument details: desktop-assistant {name} --help\n")
        return 0

    width = max(len(k) for k in commands) + 2
    print()
    print("desktop-assistant — control the running assistant over ZMQ")
    print("=" * 60)
    print(f"  Daemon REP : {REP_ENDPOINT}")
    print(f"  Daemon PUB : {PUB_ENDPOINT}")
    print("  Override   : $DA_BUS_REP_ENDPOINT / $DA_BUS_PUB_ENDPOINT")
    print()
    print("Commands")
    print("─" * 60)
    for cmd, desc in commands.items():
        first_line = desc.split("\n")[0]
        print(f"  {cmd:<{width}}{first_line}")
    print()
    print("Tip: desktop-assistant <command> --help  for full argument details.")
    print()
    return 0


    r = _request({
        "cmd": "publish",
        "topic": "av.say",
        "payload": {"text": args.text},
    })
    print(json.dumps(r, indent=2))
    return 0 if r.get("ok") else 1


def cmd_status(args) -> int:
    r = _request({"cmd": "status"}, timeout_ms=2000)
    if not r.get("ok"):
        print(json.dumps(r, indent=2))
        return 2
    if args.json:
        print(json.dumps(r["status"], indent=2))
        return 0 if _is_healthy(r["status"]) else 1

    s = r["status"]
    last = s.get("last", {})
    svcs = s.get("services", {})
    healthy = _is_healthy(s)

    # ── Header ─────────────────────────────────────────────────────────
    status_tag = "● OK" if healthy else "✗ DEGRADED"
    print(f"\ndesktop-assistant  v{s.get('version','?')}   "
          f"uptime: {_fmt_uptime(s.get('uptime_s', 0))}   {status_tag}")
    print(f"  pub  {s['endpoints']['pub']}")
    print(f"  rep  {s['endpoints']['rep']}")

    # ── Services ───────────────────────────────────────────────────────
    print()
    print("┌─ Services " + "─" * 49)
    if not svcs:
        print("│  (none reported)")
    for name, info in sorted(svcs.items()):
        mark = "✓" if info.get("running") else "✗"
        ts   = info.get("ts")
        age  = f"  (since {_fmt_ts(ts)})" if ts else ""
        print(f"│  {mark}  {name}{age}")

    # ── Hardware / Thermal ─────────────────────────────────────────────
    print("├─ Hardware / Thermal " + "─" * 38)
    temp = last.get("thermal.temp") or {}
    if temp:
        ok_sym = "✓" if temp.get("ok") else "✗"
        print(f"│  {ok_sym}  temperature   "
              f"{_safe_float(temp,'celsius'):.1f} °C  "
              f"({_safe_float(temp,'fahrenheit'):.1f} °F)")
    else:
        print("│  —  temperature   no data")

    fan = last.get("thermal.fan") or {}
    rpm = last.get("thermal.rpm") or {}
    if fan:
        duty    = _safe_float(fan, "duty")
        backend = fan.get("backend", "?")
        rpm_val = rpm.get("rpm", "—") if rpm else "—"
        print(f"│     fan           {duty:.0f}% duty   {rpm_val} RPM   backend={backend}")
    else:
        print("│  —  fan           no data")

    err_temp = last.get("thermal.error")
    if err_temp:
        print(f"│  ⚠  thermal error: {err_temp}")

    # ── Vision / Perception ────────────────────────────────────────────
    print("├─ Vision / Perception " + "─" * 37)
    frame = last.get("vision.frame_ready") or {}
    if frame:
        fid = frame.get("frame_id", frame.get("index", "?"))
        w   = frame.get("width")  or (frame.get("shape") or [None, "?"])[1]
        h   = frame.get("height") or (frame.get("shape") or ["?"])[0]
        print(f"│  ✓  camera        frame #{fid}   {w}×{h}")
    else:
        print("│  —  camera        no frames yet")

    pf = last.get("perception.faces") or {}
    if pf:
        count   = pf.get("count", 0)
        backend = pf.get("backend", "?")
        faces   = pf.get("faces") or []
        names   = [f.get("name") or "unknown" for f in faces if f.get("face_id")]
        age_s   = _payload_age(pf)
        face_str = (", ".join(names) if names else "no identified faces") if count else "none"
        print(f"│  ✓  faces         {count} detected   [{face_str}]   "
              f"backend={backend}   {age_s}")
    else:
        print("│  —  faces         no detection data")

    err_vis = last.get("vision.error")
    err_prc = last.get("perception.error")
    if err_vis:
        print(f"│  ⚠  vision error: {err_vis}")
    if err_prc:
        print(f"│  ⚠  perception error: {err_prc}")

    # ── Identity / Head Tracking ───────────────────────────────────────
    print("├─ Identity / Head Tracking " + "─" * 32)
    fi = last.get("face.identified") or {}
    if fi:
        name  = fi.get("name", "?")
        fid   = fi.get("face_id", "?")
        score = fi.get("score", 0.0)
        is_new = fi.get("is_new", False)
        label = "new" if is_new else f"score={score:.2f}"
        age_s = _payload_age(fi)
        print(f"│  ✓  last identity  {name!r}  (id={fid[:8]}…  {label})  {age_s}")
    else:
        print("│  —  last identity  no face recognized yet")

    motion = last.get("motion.position") or {}
    if motion:
        angle = motion.get("angle", "?")
        print(f"│     servo angle   {angle}°")
    else:
        print("│  —  servo angle   no data")

    # ── Audio / Speech ─────────────────────────────────────────────────
    print("├─ Audio / Speech " + "─" * 42)
    audio = last.get("audio.level") or {}
    if audio:
        dbfs = _safe_float(audio, "dbfs")
        rms  = _safe_float(audio, "rms")
        print(f"│  ✓  microphone    {dbfs:.1f} dBFS   rms={rms:.4f}")
    else:
        print("│  —  microphone    no data")

    spoke = last.get("av.spoke") or {}
    if spoke:
        text   = spoke.get("text", "")
        snip   = (text[:50] + "…") if len(text) > 50 else text
        age_s  = _payload_age(spoke)
        print(f"│  ✓  last spoken   \"{snip}\"  {age_s}")
    else:
        print("│  —  last spoken   (nothing spoken yet)")

    err_aud = last.get("audio.error")
    if err_aud:
        print(f"│  ⚠  audio error: {err_aud}")

    print("└" + "─" * 59)
    print()
    return 0 if healthy else 1


def _safe_float(d: dict, key: str, default: float = 0.0) -> float:
    v = d.get(key, default)
    try:
        return float(v)
    except (TypeError, ValueError):
        return default


def _payload_age(payload: dict) -> str:
    """Return a human-readable age string from a payload's 'ts' field."""
    ts = payload.get("ts")
    if ts is None:
        return ""
    age = time.time() - float(ts)
    if age < 2:
        return "(just now)"
    if age < 60:
        return f"({age:.0f}s ago)"
    if age < 3600:
        return f"({age/60:.0f}m ago)"
    return f"({age/3600:.1f}h ago)"


def _fmt_ts(ts) -> str:
    """Format a Unix timestamp as HH:MM:SS."""
    try:
        import datetime
        return datetime.datetime.fromtimestamp(float(ts)).strftime("%H:%M:%S")
    except Exception:
        return str(ts)


def _is_healthy(status: dict) -> bool:
    last = status.get("last", {})
    if last.get("thermal.error"):
        return False
    if last.get("vision.error"):
        return False
    if last.get("audio.error"):
        return False
    temp = last.get("thermal.temp") or {}
    if temp.get("ok") is False:
        return False
    for name, info in (status.get("services") or {}).items():
        if not info.get("running", False):
            return False
    return True


def _fmt_uptime(seconds: float) -> str:
    s = int(seconds)
    h, s = divmod(s, 3600)
    m, s = divmod(s, 60)
    if h:
        return f"{h}h{m:02d}m{s:02d}s"
    if m:
        return f"{m}m{s:02d}s"
    return f"{s}s"


def cmd_version(_args) -> int:
    r = _request({"cmd": "publish", "topic": "av.announce_version", "payload": None})
    print(json.dumps(r, indent=2))
    return 0 if r.get("ok") else 1


def cmd_watch(args) -> int:
    ctx = zmq.Context.instance()
    sock = ctx.socket(zmq.SUB)
    sock.connect(PUB_ENDPOINT)
    prefix = args.topic or ""
    sock.setsockopt_string(zmq.SUBSCRIBE, prefix)
    print(f"# watching {PUB_ENDPOINT} (prefix={prefix!r}) — Ctrl-C to stop")
    try:
        while True:
            topic, payload = sock.recv_multipart()
            print(f"{topic.decode()}\t{payload.decode()}")
    except KeyboardInterrupt:
        return 0
    finally:
        sock.close(linger=0)


def main() -> int:
    p = argparse.ArgumentParser(
        prog="desktop-assistant",
        description="Control the running assistant over ZMQ.",
    )
    sub = p.add_subparsers(dest="cmd")

    sp = sub.add_parser("help", help="Show command reference or help for a specific command")
    sp.add_argument("command", nargs="?", default=None, help="Command name to get help for")
    sp.set_defaults(func=cmd_help)

    sub.add_parser("ping", help="Round-trip check").set_defaults(func=cmd_ping)
    sub.add_parser("topics", help="List subscribed topics").set_defaults(func=cmd_topics)
    sub.add_parser("version", help="Speak the version (FR-VR2)").set_defaults(func=cmd_version)

    sp = sub.add_parser("status", help="Show health/telemetry dashboard")
    sp.add_argument("--json", action="store_true", help="Emit raw JSON")
    sp.set_defaults(func=cmd_status)

    sp = sub.add_parser("last", help="Most recent payload on a topic")
    sp.add_argument("topic")
    sp.set_defaults(func=cmd_last)

    sp = sub.add_parser("publish", help="Publish raw event to bus")
    sp.add_argument("topic")
    sp.add_argument("--payload", help="JSON payload (default: null)")
    sp.set_defaults(func=cmd_publish)

    sp = sub.add_parser("pan", help="Pan the servo to a logical angle")
    sp.add_argument("--to", type=float, required=True, help="logical degrees 1–360")
    sp.add_argument(
        "--move-time-ms",
        type=float,
        default=None,
        help="Optional target move time in milliseconds",
    )
    sp.set_defaults(func=cmd_pan)

    sp = sub.add_parser("move-servo", help="Move servo: position and move time (ms)")
    sp.add_argument("position", type=float, help="logical degrees 1–360")
    sp.add_argument("move_time_ms", type=float, help="target move time in milliseconds")
    sp.add_argument("-as", "--announce-start", action="store_true",
                    help="Speak when move starts")
    sp.add_argument("-af", "--announce-finish", action="store_true",
                    help="Speak when move finishes")
    sp.set_defaults(func=cmd_move_servo)

    sp = sub.add_parser("say", help="Speak a phrase via TTS")
    sp.add_argument("text")
    sp.set_defaults(func=cmd_say)

    sp = sub.add_parser("meet", help="Name the most recently seen face")
    sp.add_argument("name", help="Name to assign (e.g. 'Alice')")
    sp.set_defaults(func=cmd_meet)

    sp = sub.add_parser("watch", help="Stream all bus events")
    sp.add_argument("--topic", default="", help="Topic prefix filter (default: all)")
    sp.set_defaults(func=cmd_watch)

    args = p.parse_args()
    if args.cmd is None:
        # No subcommand → show help
        args.command = None
        return cmd_help(args)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
