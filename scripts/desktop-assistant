def cmd_forget_faces(_args) -> int:
    from src.perception.face_registry import FaceRegistry
    reg = FaceRegistry()
    count = reg.delete_all_faces()
    reg.close()
    print(f"Deleted {count} face(s) from the registry.")
    return 0


def cmd_forget_guests(_args) -> int:
    from src.perception.face_registry import FaceRegistry
    reg = FaceRegistry()
    count = reg.delete_guest_faces()
    reg.close()
    print(f"Deleted {count} guest face(s) from the registry.")
    return 0


def cmd_list_faces(_args) -> int:
    from src.perception.face_registry import FaceRegistry
    reg = FaceRegistry()
    faces = reg.list_faces()
    reg.close()
    if not faces:
        print("No faces in registry.")
        return 0
    col = max(len(f["name"]) for f in faces) + 2
    print(f"\n{'Name':<{col}}  {'ID (first 8)'}  {'Seen':>5}  {'Last Seen'}")
    print("─" * (col + 40))
    import time
    for f in faces:
        age = int(time.time() - f["last_seen"])
        if age < 60:
            age_str = f"{age}s ago"
        elif age < 3600:
            age_str = f"{age//60}m ago"
        else:
            age_str = f"{age//3600}h ago"
        print(f"  {f['name']:<{col}}  {f['id'][:8]}…  {f['seen_count']:>5}  {age_str}")
    print()
    return 0


def cmd_merge_faces(args) -> int:
    from src.perception.face_registry import FaceRegistry
    reg = FaceRegistry()
    keep = reg.get_face(args.keep_id)
    absorb = reg.get_face(args.absorb_id)
    if not keep:
        print(f"Error: keep_id {args.keep_id!r} not found.")
        reg.close()
        return 1
    if not absorb:
        print(f"Error: absorb_id {args.absorb_id!r} not found.")
        reg.close()
        return 1
    ok = reg.merge_faces(args.keep_id, args.absorb_id)
    reg.close()
    if ok:
        print(f"Merged {absorb['name']!r} ({args.absorb_id[:8]}…) into {keep['name']!r} ({args.keep_id[:8]}…).")
    else:
        print("Merge failed.")
    return 0 if ok else 1


def cmd_greeting_cooldown(args) -> int:
    """Set the base face greeting cooldown (minutes)."""
    minutes = float(args.minutes)
    if minutes < 1:
        print("Error: cooldown must be at least 1 minute")
        return 1
    r = _publish("tracking.set_greeting_cooldown", {"cooldown_min": minutes})
    if r is None:
        print(f"Greeting cooldown set to {minutes:.1f} minutes (bus publish; daemon may not be running).")
    else:
        print(f"Greeting cooldown updated to {minutes:.1f} minutes.")
    return 0


def cmd_greeting_settings(_args) -> int:
    """Show current greeting configuration from assistant.yaml / runtime_state.yaml."""
    import yaml
    cfg_path  = Path(__file__).resolve().parent.parent / "config" / "assistant.yaml"
    rt_path   = Path(__file__).resolve().parent.parent / "config" / "runtime_state.yaml"
    cfg: dict = {}
    rt: dict  = {}
    try:
        with open(cfg_path) as f:
            cfg = yaml.safe_load(f) or {}
    except Exception as exc:
        print(f"Warning: could not read assistant.yaml: {exc}")
    try:
        with open(rt_path) as f:
            rt = yaml.safe_load(f) or {}
    except FileNotFoundError:
        pass
    except Exception as exc:
        print(f"Warning: could not read runtime_state.yaml: {exc}")

    fr = cfg.get("face_recognition", {})
    # Runtime state can override cooldown
    rt_cooldown = rt.get("face_recognition", {}).get("greeting_cooldown_min")

    cooldown_min = rt_cooldown if rt_cooldown is not None else fr.get("greeting_cooldown_min", 30.0)
    jitter_pct   = fr.get("greeting_cooldown_jitter_pct", 25.0)
    min_abs_s    = fr.get("min_absence_s", 30.0)
    confidence   = fr.get("confidence_threshold", 0.5)
    enabled      = fr.get("enabled", True)

    W = 34
    BOLD = "\033[1m"; RST = "\033[0m"; GRN = "\033[32m"; RED = "\033[31m"
    status_str = f"{GRN}enabled{RST}" if enabled else f"{RED}disabled{RST}"
    print()
    print(f"{BOLD}Greeting Settings{RST}")
    print("─" * W)
    print(f"  {'Face recognition':<20} {status_str}")
    print(f"  {'Cooldown (base)':<20} {cooldown_min:.1f} min")
    print(f"  {'Jitter':<20} ±{jitter_pct:.0f}%  ({cooldown_min*(1-jitter_pct/100):.1f}–{cooldown_min*(1+jitter_pct/100):.1f} min)")
    print(f"  {'Min absence':<20} {min_abs_s:.0f} s")
    print(f"  {'Min confidence':<20} {confidence:.2f}")
    print()
    return 0


def cmd_restart(_args) -> int:
    """Restart the desktop-assistant-core systemd service."""
    import subprocess
    print("Restarting desktop-assistant-core.service …")
    result = subprocess.run(
        ["sudo", "systemctl", "restart", "desktop-assistant-core.service"],
        capture_output=True, text=True,
    )
    if result.returncode != 0:
        print(f"Error: {result.stderr.strip() or 'unknown error'}")
        return 1
    print("Service restarted. Use 'da ping' to confirm it is back up.")
    return 0


def cmd_reboot(_args) -> int:
    """Reboot the Raspberry Pi."""
    import subprocess
    ans = input("Reboot the Raspberry Pi? [y/N] ").strip().lower()
    if ans != "y":
        print("Aborted.")
        return 0
    print("Rebooting …")
    result = subprocess.run(["sudo", "reboot"], capture_output=True, text=True)
    if result.returncode != 0:
        print(f"Error: {result.stderr.strip() or 'unknown error'}")
        return 1
    return 0


def cmd_shutdown(_args) -> int:
    """Shut down the Raspberry Pi."""
    import subprocess
    ans = input("Shut down the Raspberry Pi? It will need to be powered on manually. [y/N] ").strip().lower()
    if ans != "y":
        print("Aborted.")
        return 0
    print("Shutting down …")
    result = subprocess.run(["sudo", "shutdown", "-h", "now"], capture_output=True, text=True)
    if result.returncode != 0:
        print(f"Error: {result.stderr.strip() or 'unknown error'}")
        return 1
    return 0

def cmd_help(args) -> int:
    """Print a formatted command reference, or detailed help for one command."""
    commands = {
        "status":        "Health and telemetry dashboard (temp, fan, servo, vision, audio).\n"
                         "               --json  Emit raw JSON instead of the human-readable table.",
        "topics":        "List every bus topic that has at least one active subscriber.",
        "last":          "Show the most recent payload published on a given topic.\n"
                         "               Usage: last <topic>",
        "watch":         "Stream live bus events to stdout (Ctrl-C to stop).\n"
                         "               --topic <prefix>  Filter to topics starting with <prefix>.",
        "say":           "Speak a phrase through the speakers via neural TTS.\n"
                         "               Usage: say \"<text>\"",
        "joke":          "Have the assistant tell a random dad joke.",
        "time":          "Have the assistant announce the current time.",
        "publish":       "Publish a raw JSON event onto the internal bus (advanced).\n"
                         "               Usage: publish <topic> [--payload '{...}']",
        "servo":         "Servo control. Sub-commands:\n"
                         "               servo enable             Enable servo motion.\n"
                         "               servo disable            Disable servo motion.\n"
                         "               servo status             Show servo state, limits, and current angle.\n"
                         "               servo pan --to <deg>     Pan to logical angle 1–360°.\n"
                         "                 [--move-time-ms <ms>]  Optional movement duration.\n"
                         "               servo move <deg> <ms>    Move to position with explicit time.\n"
                         "                 [-as]  Announce before moving.  [-af]  Announce when done.\n"
                         "               servo limits --min <deg> --max <deg>  Set travel limits.",
        "face-tracking": "Enable/disable servo tracking of detected faces. Sub-commands:\n"
                         "               face-tracking enable    Head follows detected faces.\n"
                         "               face-tracking disable   Head does not follow faces.\n"
                         "               face-tracking status    Show current state.",
        "random-motion": "Enable/disable random idle head movement. Sub-commands:\n"
                         "               random-motion enable    Idle gaze drifts when no face visible.\n"
                         "               random-motion disable   Head stays still when no face visible.\n"
                         "               random-motion status    Show current state.",
        "system":        "System management. Sub-commands:\n"
                         "               system ping             Round-trip latency check.\n"
                         "               system restart          Restart desktop-assistant-core service.\n"
                         "               system reboot           Reboot the Raspberry Pi.\n"
                         "               system shutdown         Shut down the Raspberry Pi.\n"
                         "               system version          Speak the current version number.",
        "face":          "Face registry and greeting management. Sub-commands:\n"
                         "               face meet \"<Name>\"      Name the most recently seen face.\n"
                         "               face list               List faces with IDs and last-seen times.\n"
                         "               face forget-all         Delete ALL faces permanently.\n"
                         "               face forget-guests      Remove unnamed Guest entries.\n"
                         "               face merge <keep> <absorb>  Merge two face identities.\n"
                         "               face greeting-cooldown <min>  Set re-greeting cooldown.\n"
                         "               face greeting-settings  Show all greeting config values.",
        "vision":        "Vision and object detection. Sub-commands:\n"
                         "               vision describe         Speak a description of everything seen.",
        "help":          "Show this command reference, or help for a specific command.\n"
                         "               Usage: help [command]",
    }

    if hasattr(args, "command") and args.command:
        name = args.command
        if name not in commands:
            print(f"Unknown command: {name!r}\n")
            print("Available commands: " + ", ".join(commands))
            return 1
        print(f"\ndesktop-assistant {name}")
        print("─" * (len(name) + 21))
        print(commands[name])
        print(f"\nFor argument details: desktop-assistant {name} --help\n")
        return 0

    width = max(len(k) for k in commands) + 2
    print()
    print("desktop-assistant — control the running assistant over ZMQ")
    print("=" * 60)
    print(f"  Daemon REP : {REP_ENDPOINT}")
    print(f"  Daemon PUB : {PUB_ENDPOINT}")
    print("  Override   : $DA_BUS_REP_ENDPOINT / $DA_BUS_PUB_ENDPOINT")
    print()
    print("Commands")
    print("─" * 60)
    for cmd, desc in commands.items():
        first_line = desc.split("\n")[0]
        print(f"  {cmd:<{width}}{first_line}")
    print()
    print("Tip: desktop-assistant <command> --help  for full argument details.")
    print()
    return 0


def cmd_status(args) -> int:
    r = _request({"cmd": "status"}, timeout_ms=2000)
    if not r.get("ok"):
        print(json.dumps(r, indent=2))
        return 2
    if args.json:
        print(json.dumps(r["status"], indent=2))
        return 0 if _is_healthy(r["status"]) else 1

    s = r["status"]
    last = s.get("last", {})
    svcs = s.get("services", {})
    healthy = _is_healthy(s)

    # ── Header ─────────────────────────────────────────────────────────
    status_tag = "● OK" if healthy else "✗ DEGRADED"
    print(f"\ndesktop-assistant  v{s.get('version','?')}   "
          f"uptime: {_fmt_uptime(s.get('uptime_s', 0))}   {status_tag}")
    print(f"  pub  {s['endpoints']['pub']}")
    print(f"  rep  {s['endpoints']['rep']}")

    # ── Services ───────────────────────────────────────────────────────
    print()
    print("┌─ Services " + "─" * 49)
    if not svcs:
        print("│  (none reported)")
    for name, info in sorted(svcs.items()):
        mark = "✓" if info.get("running") else "✗"
        ts   = info.get("ts")
        age  = f"  (since {_fmt_ts(ts)})" if ts else ""
        print(f"│  {mark}  {name}{age}")

    # ── Hardware / Thermal ─────────────────────────────────────────────
    print("├─ Hardware / Thermal " + "─" * 38)
    temp = last.get("thermal.temp") or {}
    if temp:
        ok_sym = "✓" if temp.get("ok") else "✗"
        print(f"│  {ok_sym}  temperature   "
              f"{_safe_float(temp,'celsius'):.1f} °C  "
              f"({_safe_float(temp,'fahrenheit'):.1f} °F)")
    else:
        print("│  —  temperature   no data")

    fan = last.get("thermal.fan") or {}
    rpm = last.get("thermal.rpm") or {}
    if fan:
        duty    = _safe_float(fan, "duty")
        backend = fan.get("backend", "?")
        rpm_val = rpm.get("rpm", "—") if rpm else "—"
        print(f"│     fan           {duty:.0f}% duty   {rpm_val} RPM   backend={backend}")
    else:
        print("│  —  fan           no data")

    err_temp = last.get("thermal.error")
    if err_temp:
        print(f"│  ⚠  thermal error: {err_temp}")

    # ── Vision / Perception ────────────────────────────────────────────
    print("├─ Vision / Perception " + "─" * 37)
    frame = last.get("vision.frame_ready") or {}
    if frame:
        fid = frame.get("frame_id", frame.get("index", "?"))
        w   = frame.get("width")  or (frame.get("shape") or [None, "?"])[1]
        h   = frame.get("height") or (frame.get("shape") or ["?"])[0]
        print(f"│  ✓  camera        frame #{fid}   {w}×{h}")
    else:
        print("│  —  camera        no frames yet")

    pf = last.get("perception.faces") or {}
    if pf:
        count   = pf.get("count", 0)
        backend = pf.get("backend", "?")
        faces   = pf.get("faces") or []
        names   = [f.get("name") or "unknown" for f in faces if f.get("face_id")]
        age_s   = _payload_age(pf)
        face_str = (", ".join(names) if names else "no identified faces") if count else "none"
        print(f"│  ✓  faces         {count} detected   [{face_str}]   "
              f"backend={backend}   {age_s}")
    else:
        print("│  —  faces         no detection data")

    err_vis = last.get("vision.error")
    err_prc = last.get("perception.error")
    if err_vis:
        print(f"│  ⚠  vision error: {err_vis}")
    if err_prc:
        print(f"│  ⚠  perception error: {err_prc}")

    # ── Identity / Head Tracking ───────────────────────────────────────
    print("├─ Identity / Head Tracking " + "─" * 32)
    fi = last.get("face.identified") or {}
    if fi:
        name  = fi.get("name", "?")
        fid   = fi.get("face_id", "?")
        score = fi.get("score", 0.0)
        is_new = fi.get("is_new", False)
        label = "new" if is_new else f"score={score:.2f}"
        age_s = _payload_age(fi)
        print(f"│  ✓  last identity  {name!r}  (id={fid[:8]}…  {label})  {age_s}")
    else:
        print("│  —  last identity  no face recognized yet")

    motion = last.get("motion.position") or {}
    if motion:
        angle = motion.get("angle", "?")
        print(f"│     servo angle   {angle}°")
    else:
        print("│  —  servo angle   no data")

    # ── Audio / Speech ─────────────────────────────────────────────────
    print("├─ Audio / Speech " + "─" * 42)
    audio = last.get("audio.level") or {}
    if audio:
        dbfs = _safe_float(audio, "dbfs")
        rms  = _safe_float(audio, "rms")
        print(f"│  ✓  microphone    {dbfs:.1f} dBFS   rms={rms:.4f}")
    else:
        print("│  —  microphone    no data")

    spoke = last.get("av.spoke") or {}
    if spoke:
        text   = spoke.get("text", "")
        snip   = (text[:50] + "…") if len(text) > 50 else text
        age_s  = _payload_age(spoke)
        print(f"│  ✓  last spoken   \"{snip}\"  {age_s}")
    else:
        print("│  —  last spoken   (nothing spoken yet)")

    err_aud = last.get("audio.error")
    if err_aud:
        print(f"│  ⚠  audio error: {err_aud}")

    print("└" + "─" * 59)
    print()
    return 0 if healthy else 1


def _safe_float(d: dict, key: str, default: float = 0.0) -> float:
    v = d.get(key, default)
    try:
        return float(v)
    except (TypeError, ValueError):
        return default


def _payload_age(payload: dict) -> str:
    """Return a human-readable age string from a payload's 'ts' field."""
    ts = payload.get("ts")
    if ts is None:
        return ""
    age = time.time() - float(ts)
    if age < 2:
        return "(just now)"
    if age < 60:
        return f"({age:.0f}s ago)"
    if age < 3600:
        return f"({age/60:.0f}m ago)"
    return f"({age/3600:.1f}h ago)"


def _fmt_ts(ts) -> str:
    """Format a Unix timestamp as HH:MM:SS."""
    try:
        import datetime
        return datetime.datetime.fromtimestamp(float(ts)).strftime("%H:%M:%S")
    except Exception:
        return str(ts)


def _is_healthy(status: dict) -> bool:
    last = status.get("last", {})
    if last.get("thermal.error"):
        return False
    if last.get("vision.error"):
        return False
    if last.get("audio.error"):
        return False
    temp = last.get("thermal.temp") or {}
    if temp.get("ok") is False:
        return False
    for name, info in (status.get("services") or {}).items():
        if not info.get("running", False):
            return False
    return True


def _fmt_uptime(seconds: float) -> str:
    s = int(seconds)
    h, s = divmod(s, 3600)
    m, s = divmod(s, 60)
    if h:
        return f"{h}h{m:02d}m{s:02d}s"
    if m:
        return f"{m}m{s:02d}s"
    return f"{s}s"


def cmd_version(_args) -> int:
    r = _request({"cmd": "publish", "topic": "av.announce_version", "payload": None})
    print(json.dumps(r, indent=2))
    return 0 if r.get("ok") else 1


def cmd_watch(args) -> int:
    ctx = zmq.Context.instance()
    sock = ctx.socket(zmq.SUB)
    sock.connect(PUB_ENDPOINT)
    prefix = args.topic or ""
    sock.setsockopt_string(zmq.SUBSCRIBE, prefix)
    print(f"# watching {PUB_ENDPOINT} (prefix={prefix!r}) — Ctrl-C to stop")
    try:
        while True:
            topic, payload = sock.recv_multipart()
            print(f"{topic.decode()}\t{payload.decode()}")
    except KeyboardInterrupt:
        return 0
    finally:
        sock.close(linger=0)


def cmd_vision_describe(_args) -> int:
    """Publish vision.describe — ObjectService builds and speaks a scene description."""
    r = _request({"cmd": "publish", "topic": "vision.describe", "payload": {}})
    if r.get("ok"):
        print("Describing what I see…")
    else:
        print(json.dumps(r, indent=2))
    return 0 if r.get("ok") else 1


def main() -> int:
    p = argparse.ArgumentParser(
        prog="desktop-assistant",
        description="Control the running assistant over ZMQ.",
    )
    sub = p.add_subparsers(dest="cmd")

    sp = sub.add_parser("help", help="Show command reference or help for a specific command")
    sp.add_argument("command", nargs="?", default=None, help="Command name to get help for")
    sp.set_defaults(func=cmd_help)

    # ── system subcommand group ──────────────────────────────────────
    sys_sp = sub.add_parser("system", help="System management (ping/restart/reboot/shutdown/version)")
    sys_sub = sys_sp.add_subparsers(dest="sys_cmd", metavar="<subcommand>")
    sys_sub.required = True
    sys_sub.add_parser("ping",     help="Round-trip check — confirms daemon is reachable").set_defaults(func=cmd_ping)
    sys_sub.add_parser("restart",  help="Restart desktop-assistant-core systemd service").set_defaults(func=cmd_restart)
    sys_sub.add_parser("reboot",   help="Reboot the Raspberry Pi (prompts for confirmation)").set_defaults(func=cmd_reboot)
    sys_sub.add_parser("shutdown", help="Shut down the Raspberry Pi (prompts for confirmation)").set_defaults(func=cmd_shutdown)
    sys_sub.add_parser("version",  help="Speak the current version number via TTS").set_defaults(func=cmd_version)

    # ── face subcommand group ────────────────────────────────────────
    face_sp = sub.add_parser("face", help="Face registry and greeting management")
    face_sub = face_sp.add_subparsers(dest="face_cmd", metavar="<subcommand>")
    face_sub.required = True

    ssp = face_sub.add_parser("meet", help="Assign a name to the most recently seen face")
    ssp.add_argument("name", help="Name to assign (e.g. 'Alice')")
    ssp.set_defaults(func=cmd_meet)

    face_sub.add_parser("list", help="List all faces with IDs, names, and last-seen times").set_defaults(func=cmd_list_faces)
    face_sub.add_parser("forget-all", help="Delete ALL known faces from the registry permanently").set_defaults(func=cmd_forget_faces)
    face_sub.add_parser("forget-guests", help="Delete only Guest-named faces, keeping named identities").set_defaults(func=cmd_forget_guests)

    ssp = face_sub.add_parser("merge", help="Merge two face identities into one")
    ssp.add_argument("keep_id",   help="Face ID to keep (use 'face list' to get IDs)")
    ssp.add_argument("absorb_id", help="Face ID to absorb into keep_id")
    ssp.set_defaults(func=cmd_merge_faces)

    ssp = face_sub.add_parser("greeting-cooldown", help="Set the base face greeting cooldown in minutes")
    ssp.add_argument("minutes", type=float, help="Base cooldown in minutes (min 1)")
    ssp.set_defaults(func=cmd_greeting_cooldown)

    face_sub.add_parser("greeting-settings", help="Show all current greeting configuration values").set_defaults(func=cmd_greeting_settings)

    # ── vision subcommand group ──────────────────────────────────────
    vis_sp = sub.add_parser("vision", help="Vision and object detection commands")
    vis_sub = vis_sp.add_subparsers(dest="vis_cmd", metavar="<subcommand>")
    vis_sub.required = True
    vis_sub.add_parser("describe", help="Speak a natural-language description of everything currently seen").set_defaults(func=cmd_vision_describe)

    sub.add_parser("topics", help="List subscribed topics").set_defaults(func=cmd_topics)

    sp = sub.add_parser("status", help="Show health/telemetry dashboard")
    sp.add_argument("--json", action="store_true", help="Emit raw JSON")
    sp.set_defaults(func=cmd_status)

    sp = sub.add_parser("last", help="Most recent payload on a topic")
    sp.add_argument("topic")
    sp.set_defaults(func=cmd_last)

    sp = sub.add_parser("publish", help="Publish raw event to bus")
    sp.add_argument("topic")
    sp.add_argument("--payload", help="JSON payload (default: null)")
    sp.set_defaults(func=cmd_publish)

    sp = sub.add_parser("say", help="Speak a phrase via TTS")
    sp.add_argument("text")
    sp.set_defaults(func=cmd_say)

    sub.add_parser("joke", help="Tell a random dad joke").set_defaults(func=cmd_joke)
    sub.add_parser("time", help="Announce the current time").set_defaults(func=cmd_time)

    # ── Consolidated servo subcommands ───────────────────────────────
    servo_sp = sub.add_parser("servo", help="Servo control (enable/disable/status/pan/move)")
    servo_sub = servo_sp.add_subparsers(dest="servo_cmd", metavar="<servo-command>")
    servo_sub.required = True

    servo_sub.add_parser("enable",  help="Enable servo motion").set_defaults(func=cmd_servo_enable)
    servo_sub.add_parser("disable", help="Disable servo motion").set_defaults(func=cmd_servo_disable)
    servo_sub.add_parser("status",  help="Show servo state, limits, and current angle").set_defaults(func=cmd_servo_status)

    ssp = servo_sub.add_parser("limits", help="Set servo travel limits")
    ssp.add_argument("--min", type=float, required=True, help="Minimum logical angle (1–359)")
    ssp.add_argument("--max", type=float, required=True, help="Maximum logical angle (2–360)")
    ssp.set_defaults(func=cmd_servo_limits)

    ssp = servo_sub.add_parser("pan", help="Pan servo to a logical angle (1–360°)")
    ssp.add_argument("--to", type=float, required=True, help="logical degrees 1–360")
    ssp.add_argument("--move-time-ms", type=float, default=None,
                     help="Optional target move time in ms")
    ssp.set_defaults(func=cmd_pan)

    ssp = servo_sub.add_parser("move", help="Move servo: position and move time (ms)")
    ssp.add_argument("position", type=float, help="logical degrees 1–360")
    ssp.add_argument("move_time_ms", type=float, help="target move time in ms")
    ssp.add_argument("-as", "--announce-start", action="store_true",
                     help="Speak when move starts")
    ssp.add_argument("-af", "--announce-finish", action="store_true",
                     help="Speak when move finishes")
    ssp.set_defaults(func=cmd_move_servo)

    # ── Face tracking subcommands ────────────────────────────────────
    ft_sp = sub.add_parser("face-tracking", help="Enable/disable face-following servo behavior")
    ft_sub = ft_sp.add_subparsers(dest="ft_cmd", metavar="<subcommand>")
    ft_sub.required = True
    ft_sub.add_parser("enable",  help="Head follows detected faces").set_defaults(func=cmd_face_tracking_enable)
    ft_sub.add_parser("disable", help="Head does not follow faces").set_defaults(func=cmd_face_tracking_disable)
    ft_sub.add_parser("status",  help="Show current face tracking state").set_defaults(func=cmd_face_tracking_status)

    # ── Random motion subcommands ────────────────────────────────────
    rm_sp = sub.add_parser("random-motion", help="Enable/disable idle random head movement")
    rm_sub = rm_sp.add_subparsers(dest="rm_cmd", metavar="<subcommand>")
    rm_sub.required = True
    rm_sub.add_parser("enable",  help="Idle gaze drifts when no face visible").set_defaults(func=cmd_random_motion_enable)
    rm_sub.add_parser("disable", help="Head stays still when no face visible").set_defaults(func=cmd_random_motion_disable)
    rm_sub.add_parser("status",  help="Show current random motion state").set_defaults(func=cmd_random_motion_status)

    sp = sub.add_parser("watch", help="Stream all bus events")
    sp.add_argument("--topic", default="", help="Topic prefix filter (default: all)")
    sp.set_defaults(func=cmd_watch)

    args = p.parse_args()
    if args.cmd is None:
        # No subcommand → show help
        args.command = None
        return cmd_help(args)
    return args.func(args)


if __name__ == "__main__":
    sys.exit(main())
