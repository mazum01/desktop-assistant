    r = _request({
        "cmd": "publish",
        "topic": "motion.set_enabled",
        "payload": {"enabled": True},
    })
    print("Servo enabled." if r.get("ok") else json.dumps(r, indent=2))
    return 0 if r.get("ok") else 1


