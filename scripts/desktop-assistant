def cmd_skills(args) -> int:
    """List, enable, disable, or configure voice skills."""
    sub = getattr(args, "skills_cmd", "list")

    if sub == "list":
        try:
            data = _http_get("/api/skills")
        except Exception as exc:
            print(f"Error: {exc}")
            return 1
        skills = data.get("skills", [])
        if not skills:
            print("No skills registered.")
            return 0
        name_w = max(len(s["name"]) for s in skills) + 2
        print()
        print(f"  {'Enabled':<8} {'Skill':<{name_w}}  Example phrase")
        print("  " + "─" * 72)
        for s in skills:
            enabled_str = "✓" if s.get("enabled", True) else "✗"
            cfg_marker  = " ⚙" if s.get("has_config") else ""
            print(f"  {enabled_str:<8} {s['name']:<{name_w}}{s.get('example', '')}{cfg_marker}")
        print()
        return 0

    if sub == "enable":
        name = args.skill_name
        try:
            r = _http_post(f"/api/skills/{name}/enabled", {"enabled": True})
        except Exception as exc:
            print(f"Error: {exc}")
            return 1
        print(f"Skill '{name}' enabled.")
        return 0

    if sub == "disable":
        name = args.skill_name
        try:
            r = _http_post(f"/api/skills/{name}/enabled", {"enabled": False})
        except Exception as exc:
            print(f"Error: {exc}")
            return 1
        print(f"Skill '{name}' disabled.")
        return 0

    if sub == "config":
        name = args.skill_name
        pairs = getattr(args, "settings", [])
        if not pairs:
            # Show current config
            try:
                data = _http_get(f"/api/skills/{name}/config")
            except Exception as exc:
                print(f"Error: {exc}")
                return 1
            schema = data.get("schema", [])
            values = data.get("values", {})
            if not schema:
                print(f"Skill '{name}' has no configurable fields.")
                return 0
            print()
            print(f"  Config for skill: {name}")
            print("  " + "─" * 50)
            for f in schema:
                val = values.get(f["name"], f.get("default", ""))
                desc = f"  ({f['description']})" if f.get("description") else ""
                print(f"  {f['name']:<24} = {val}{desc}")
            print()
            return 0
        else:
            # Apply key=value pairs
            errors = []
            for pair in pairs:
                if "=" not in pair:
                    errors.append(f"  Invalid: {pair!r} (expected key=value)")
                    continue
                key, _, value = pair.partition("=")
                # Attempt numeric coercion
                try:
                    parsed: object
                    try:
                        parsed = int(value)
                    except ValueError:
                        try:
                            parsed = float(value)
                        except ValueError:
                            if value.lower() in ("true", "false"):
                                parsed = value.lower() == "true"
                            else:
                                parsed = value
                    try:
                        _http_post(f"/api/skills/{name}/config", {"key": key, "value": parsed})
                    except Exception as exc:
                        errors.append(f"  {key}: {exc}")
                        continue
                    print(f"  {key} = {parsed}")
                except Exception as exc:
                    errors.append(f"  {key}: {exc}")
            if errors:
                for e in errors:
                    print(e)
                return 1
            return 0

    print(f"Unknown skills sub-command: {sub!r}")
    return 1


def cmd_music_play(args) -> int:
    """Start or resume Pandora playback, optionally selecting a station by name."""
    payload: dict = {}
    if hasattr(args, "station") and args.station:
        # Try to resolve station name to ID from the last known stations payload.
        import yaml as _yaml
        from pathlib import Path
        station_name = " ".join(args.station).lower()
        r = _request({"cmd": "last", "topic": "music.stations_updated"})
        stations = r.get("payload", {}).get("stations", []) if isinstance(r.get("payload"), dict) else []
        matched = next(
            (s for s in stations if station_name in s.get("name", "").lower()),
            None,
        )
        if matched:
            payload["station_id"] = matched["id"]
            print(f"Playing station: {matched['name']}")
        elif stations:
            print(f"Station {args.station!r} not found. Starting default station.")
        # No stations cached yet — pianobar will show list and pick first
    r = _request({"cmd": "publish", "topic": "music.play", "payload": payload})
    if r.get("ok"):
        print("▶  Music starting…")
    else:
        print(json.dumps(r, indent=2))
    return 0 if r.get("ok") else 1


