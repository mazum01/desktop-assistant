def cmd_vision_rotation_status(_args) -> int:
    """Show the current camera rotation angle."""
    from pathlib import Path
    import yaml as _yaml

    _base = Path(__file__).resolve().parents[1]
    _cfg_path = _base / "config" / "assistant.yaml"
    _rt_path  = _base / "config" / "runtime_state.yaml"

    _cfg = {}
    try:
        _cfg = _yaml.safe_load(_cfg_path.read_text()) or {} if _cfg_path.exists() else {}
    except Exception:
        pass
    _rt = {}
    try:
        _rt = _yaml.safe_load(_rt_path.read_text()) or {} if _rt_path.exists() else {}
    except Exception:
        pass

    deg = _rt.get("camera", {}).get(
        "rotation_deg",
        _cfg.get("camera", {}).get("rotation_deg", 0),
    )
    print(f"  Camera rotation : {deg}°")
    return 0


def cmd_music_play(args) -> int:
    """Start or resume Pandora playback, optionally selecting a station by name."""
    payload: dict = {}
    if hasattr(args, "station") and args.station:
        # Try to resolve station name to ID from the last known stations payload.
        import yaml as _yaml
        from pathlib import Path
        station_name = " ".join(args.station).lower()
        r = _request({"cmd": "last", "topic": "music.stations_updated"})
        stations = r.get("payload", {}).get("stations", []) if isinstance(r.get("payload"), dict) else []
        matched = next(
            (s for s in stations if station_name in s.get("name", "").lower()),
            None,
        )
        if matched:
            payload["station_id"] = matched["id"]
            print(f"Playing station: {matched['name']}")
        elif stations:
            print(f"Station {args.station!r} not found. Starting default station.")
        # No stations cached yet — pianobar will show list and pick first
    r = _request({"cmd": "publish", "topic": "music.play", "payload": payload})
    if r.get("ok"):
        print("▶  Music starting…")
    else:
        print(json.dumps(r, indent=2))
    return 0 if r.get("ok") else 1


