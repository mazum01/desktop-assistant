                            "                  fan tach-disable              Disable GPIO edge-callback tach; restart thermal.",
        "help":             "Show this command reference, or help for a specific command.\n"
                            "                  Usage: help [command]",
    }

    if hasattr(args, "command") and args.command:
        name = args.command
        if name not in commands:
            print(f"Unknown command: {name!r}\n")
            print("Available commands: " + ", ".join(commands))
            return 1
        print(f"\nvera {name}")
        print("─" * (len(name) + 5))
        print(commands[name])
        print(f"\nFor argument details: vera {name} --help\n")
        return 0

    width = max(len(k) for k in commands) + 2
    print()
    print("vera — VERA (Vision-Enabled Reasoning Agent) control CLI")
    print("=" * 60)
    print(f"  Daemon REP : {REP_ENDPOINT}")
    print(f"  Daemon PUB : {PUB_ENDPOINT}")
    print("  Override   : $DA_BUS_REP_ENDPOINT / $DA_BUS_PUB_ENDPOINT")
    print()
    print("Commands")
    print("─" * 60)
    for cmd, desc in commands.items():
        first_line = desc.split("\n")[0]
        print(f"  {cmd:<{width}}{first_line}")
    print()
    print("Tip: vera <command> --help  for full argument details.")
    print()
    return 0


def cmd_status(args) -> int:
    r = _request({"cmd": "status"}, timeout_ms=2000)
    if not r.get("ok"):
        print(json.dumps(r, indent=2))
        return 2
    if args.json:
        print(json.dumps(r["status"], indent=2))
        return 0 if _is_healthy(r["status"]) else 1

    s = r["status"]
    last = s.get("last", {})
    svcs = s.get("services", {})
    healthy = _is_healthy(s)

    # ── Header ─────────────────────────────────────────────────────────
    status_tag = "● OK" if healthy else "✗ DEGRADED"
    print(f"\nvera  v{s.get('version','?')}   "
          f"uptime: {_fmt_uptime(s.get('uptime_s', 0))}   {status_tag}")
    print(f"  pub  {s['endpoints']['pub']}")
    print(f"  rep  {s['endpoints']['rep']}")

    # ── Services ───────────────────────────────────────────────────────
    print()
    print("┌─ Services " + "─" * 49)
    if not svcs:
        print("│  (none reported)")
    GRN = "\033[32m"; RED = "\033[31m"; YLW = "\033[33m"; RST = "\033[0m"
    for name, info in sorted(svcs.items()):
        if not info.get("running"):
            mark = f"{YLW}✗{RST}"
            extra = f"  {YLW}(stopped){RST}"
        elif info.get("error"):
            mark = f"{RED}⚠{RST}"
            extra = f"  {RED}(error/degraded){RST}"
        else:
            mark = f"{GRN}✓{RST}"
            extra = ""
        ts  = info.get("ts")
        age = f"  (since {_fmt_ts(ts)})" if ts else ""
        print(f"│  {mark}  {name}{age}{extra}")

    # ── Hardware / Thermal ─────────────────────────────────────────────
    print("├─ Hardware / Thermal " + "─" * 38)
    temp = last.get("thermal.temp") or {}
    if temp:
        ok_sym = "✓" if temp.get("ok") else "✗"
        print(f"│  {ok_sym}  temperature   "
              f"{_safe_float(temp,'celsius'):.1f} °C  "
              f"({_safe_float(temp,'fahrenheit'):.1f} °F)")
    else:
        print("│  —  temperature   no data")

    fan = last.get("thermal.fan") or {}
    rpm = last.get("thermal.rpm") or {}
    if fan:
        duty    = _safe_float(fan, "duty")
        backend = fan.get("backend", "?")
        rpm_val = rpm.get("rpm", "—") if rpm else "—"
        print(f"│     fan           {duty:.0f}% duty   {rpm_val} RPM   backend={backend}")
    else:
        print("│  —  fan           no data")

    err_temp = last.get("thermal.error")
    if err_temp:
        print(f"│  ⚠  thermal error: {err_temp}")

    # ── Vision / Perception ────────────────────────────────────────────
    print("├─ Vision / Perception " + "─" * 37)
    frame = last.get("vision.frame_ready") or {}
    if frame:
        fid = frame.get("frame_id", frame.get("index", "?"))
        w   = frame.get("width")  or (frame.get("shape") or [None, "?"])[1]
        h   = frame.get("height") or (frame.get("shape") or ["?"])[0]
        print(f"│  ✓  camera        frame #{fid}   {w}×{h}")
    else:
        print("│  —  camera        no frames yet")

    pf = last.get("perception.faces") or {}
    if pf:
        count   = pf.get("count", 0)
        backend = pf.get("backend", "?")
        faces   = pf.get("faces") or []
        names   = [f.get("name") or "unknown" for f in faces if f.get("face_id")]
        age_s   = _payload_age(pf)
        face_str = (", ".join(names) if names else "no identified faces") if count else "none"
        print(f"│  ✓  faces         {count} detected   [{face_str}]   "
              f"backend={backend}   {age_s}")
    else:
        print("│  —  faces         no detection data")

    err_vis = last.get("vision.error")
    err_prc = last.get("perception.error")
    if err_vis:
        print(f"│  ⚠  vision error: {err_vis}")
    if err_prc:
        print(f"│  ⚠  perception error: {err_prc}")

    # ── Identity / Head Tracking ───────────────────────────────────────
    print("├─ Identity / Head Tracking " + "─" * 32)
    fi = last.get("face.identified") or {}
    if fi:
        name  = fi.get("name", "?")
        fid   = fi.get("face_id", "?")
        score = fi.get("score", 0.0)
        is_new = fi.get("is_new", False)
        label = "new" if is_new else f"score={score:.2f}"
        age_s = _payload_age(fi)
        print(f"│  ✓  last identity  {name!r}  (id={fid[:8]}…  {label})  {age_s}")
    else:
        print("│  —  last identity  no face recognized yet")

    motion = last.get("motion.position") or {}
    if motion:
        angle = motion.get("angle", "?")
        print(f"│     servo angle   {angle}°")
    else:
        print("│  —  servo angle   no data")

    # ── Audio / Speech ─────────────────────────────────────────────────
    print("├─ Audio / Speech " + "─" * 42)
    audio = last.get("audio.level") or {}
    if audio:
        dbfs = _safe_float(audio, "dbfs")
        rms  = _safe_float(audio, "rms")
        print(f"│  ✓  microphone    {dbfs:.1f} dBFS   rms={rms:.4f}")
    else:
        print("│  —  microphone    no data")

    spoke = last.get("av.spoke") or {}
    if spoke:
        text   = spoke.get("text", "")
        snip   = (text[:50] + "…") if len(text) > 50 else text
        age_s  = _payload_age(spoke)
        print(f"│  ✓  last spoken   \"{snip}\"  {age_s}")
    else:
        print("│  —  last spoken   (nothing spoken yet)")

    err_aud = last.get("audio.error")
    if err_aud:
        print(f"│  ⚠  audio error: {err_aud}")

    print("└" + "─" * 59)
    print()
    return 0 if healthy else 1


def _safe_float(d: dict, key: str, default: float = 0.0) -> float:
    v = d.get(key, default)
    try:
        return float(v)
    except (TypeError, ValueError):
        return default


def _payload_age(payload: dict) -> str:
    """Return a human-readable age string from a payload's 'ts' field."""
    ts = payload.get("ts")
    if ts is None:
        return ""
    age = time.time() - float(ts)
    if age < 2:
        return "(just now)"
    if age < 60:
        return f"({age:.0f}s ago)"
    if age < 3600:
        return f"({age/60:.0f}m ago)"
    return f"({age/3600:.1f}h ago)"


def _fmt_ts(ts) -> str:
    """Format a Unix timestamp as HH:MM:SS."""
    try:
        import datetime
        return datetime.datetime.fromtimestamp(float(ts)).strftime("%H:%M:%S")
    except Exception:
        return str(ts)


def _is_healthy(status: dict) -> bool:
    last = status.get("last", {})
    if last.get("thermal.error"):
        return False
    if last.get("vision.error"):
        return False
    if last.get("audio.error"):
        return False
    temp = last.get("thermal.temp") or {}
    if temp.get("ok") is False:
        return False
    for name, info in (status.get("services") or {}).items():
        if not info.get("running", False):
            return False
    return True


def _fmt_uptime(seconds: float) -> str:
    s = int(seconds)
    h, s = divmod(s, 3600)
    m, s = divmod(s, 60)
    if h:
        return f"{h}h{m:02d}m{s:02d}s"
    if m:
        return f"{m}m{s:02d}s"
    return f"{s}s"


def cmd_radon(args) -> int:
    """Show the current radon level or announce it via TTS."""
    subcmd = getattr(args, "radon_cmd", "status")
    try:
        if subcmd == "announce":
            d = _http_post("/api/radon/announce", {})
            if d.get("ok"):
                print("Radon level announced via TTS.")
            else:
                print(f"Error: {d.get('error', 'unknown error')}", file=sys.stderr)
                return 1
        else:
            d = _http_get("/api/radon")
            if not d.get("available"):
                print(f"Radon service unavailable: {d.get('error', 'no reading yet')}")
                return 1
            r = d.get("reading", {})
            pcil   = r.get("radon_pcil")
            bqm3   = r.get("radon_bqm3")
            alert  = r.get("alert", "—")
            device = r.get("device_name", "EcoQube")
            updated = r.get("last_updated", "—")
            ALERT_COLOR = {"Green": "\033[32m", "Orange": "\033[33m", "Red": "\033[31m"}
            RESET = "\033[0m"
            color = ALERT_COLOR.get(alert, "")
            print(f"\nRadon Monitor — {device}")
            print("─" * 40)
            print(f"  Level   : {color}{pcil:.2f} pCi/L  ({bqm3:.0f} Bq/m³){RESET}")
            print(f"  Alert   : {color}{alert}{RESET}")
            print(f"  Updated : {updated}")
            print()
    except Exception as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1
    return 0


def cmd_drop(args) -> int:
    """Show DROP water softener status or announce it via TTS."""
    subcmd = getattr(args, "drop_cmd", "status")
    try:
        if subcmd == "announce":
            d = _http_post("/api/drop/announce", {})
            if d.get("ok"):
                print("DROP status announced via TTS.")
                print(f"  \"{d.get('text', '')}\"")
            else:
                print(f"Error: {d.get('error', 'unknown error')}", file=sys.stderr)
                return 1
        else:
            d = _http_get("/api/drop")
            if not d.get("available"):
                print(f"DROP service unavailable: {d.get('error', 'no reading yet')}")
                return 1
            r = d.get("reading", {})
            devices = d.get("devices", [])
            RESET = "\033[0m"
            YELLOW = "\033[33m"
            RED = "\033[31m"
            GREEN = "\033[32m"

            print("\nDROP Water System")
            print("─" * 40)
            name = r.get("softener_name", "Softener")
            print(f"  Device    : {name}")
            flow = r.get("flow_gpm")
            if flow is not None:
                print(f"  Flow      : {flow:.2f} gpm")
            used = r.get("used_today_gal")
            if used is not None:
                print(f"  Used today: {used:.0f} gal")
            capacity = r.get("capacity_remaining_gal")
            if capacity is not None:
                print(f"  Capacity  : {capacity:.0f} gal remaining")
            pressure = r.get("pressure_psi")
            if pressure is not None:
                print(f"  Pressure  : {pressure:.0f} PSI")
            tds_in = r.get("tds_in_ppm")
            tds_out = r.get("tds_out_ppm")
            if tds_in is not None:
                print(f"  TDS in    : {tds_in} ppm")
            if tds_out is not None:
                print(f"  TDS out   : {tds_out} ppm")
            salt_low = r.get("salt_low")
            if salt_low is True:
                print(f"  Salt      : {YELLOW}LOW — add salt{RESET}")
            elif salt_low is False:
                print(f"  Salt      : {GREEN}OK{RESET}")
            water_on = r.get("water_on")
            if water_on is False:
                print(f"  Water     : {RED}SHUT OFF{RESET}")
            elif water_on is True:
                print(f"  Water     : {GREEN}ON{RESET}")
            protect = r.get("protect_mode")
            if protect:
                print(f"  Protect   : {protect}")
            updated = r.get("last_updated")
            if updated:
                import datetime
                ts = datetime.datetime.fromtimestamp(updated).strftime("%Y-%m-%d %H:%M:%S")
                print(f"  Updated   : {ts}")
            if len(devices) > 1:
                print(f"  Devices   : {', '.join(d['name'] for d in devices)}")
            print()
    except Exception as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1
    return 0


def cmd_iot(args) -> int:
    """CRUD management for IoT plugin devices via REST API."""
    subcmd = getattr(args, "iot_cmd", "list")
    BOLD  = "\033[1m"
    GREEN = "\033[32m"
    RED   = "\033[31m"
    YELLOW = "\033[33m"
    RESET = "\033[0m"

    try:
        if subcmd == "list":
            d = _http_get("/api/iot")
            devices = d.get("devices", [])
            if not devices:
                print("No IoT plugin devices registered.")
                print("Use 'vera iot types' to see available types.")
                return 0
            print(f"\n{BOLD}IoT Plugin Devices{RESET}")
            print("─" * 50)
            for dev in devices:
                avail = dev.get("available", False)
                status_str = f"{GREEN}● available{RESET}" if avail else f"{RED}○ unavailable{RESET}"
                icon = dev.get("device_icon", "🔌")
                print(f"  {icon}  {BOLD}{dev['device_id']:<20}{RESET}  {dev['device_name']:<24}  {status_str}")
            print()

        elif subcmd == "types":
            d = _http_get("/api/iot/types")
            types = d.get("types", [])
            if not types:
                print("No discoverable IoT plugin types found in src/iot/devices/.")
                return 0
            print(f"\n{BOLD}Available IoT Plugin Types{RESET}")
            print("─" * 50)
            for t in types:
                icon = t.get("device_icon", "🔌")
                print(f"  {icon}  {BOLD}{t['type_id']:<20}{RESET}  {t['device_name']}")
            print()

        elif subcmd == "status":
            device_id = getattr(args, "device_id", None)
            if not device_id:
                print("Usage: vera iot status <device_id>", file=sys.stderr)
                return 1
            d = _http_get(f"/api/iot/{device_id}")
            available = d.get("available", False)
            icon = d.get("device_icon", "🔌")
            print(f"\n{icon}  {BOLD}{d.get('device_name', device_id)}{RESET}  (id: {device_id})")
            print("─" * 50)
            if not available:
                print(f"  Status  : {RED}unavailable{RESET}  {d.get('error', '')}")
            else:
                disp    = d.get("display") or {}
                primary = disp.get("primary") or {}
                badges  = disp.get("badges") or []
                metrics = disp.get("metrics") or []
                detail  = disp.get("detail") or ""
                value   = primary.get("value", "—")
                unit    = primary.get("unit", "")
                print(f"  Status  : {GREEN}available{RESET}")
                print(f"  Value   : {BOLD}{value}{RESET}{(' ' + unit) if unit else ''}")
                for badge in badges:
                    print(f"  Badge   : {badge.get('text', '')}")
                for m in metrics:
                    print(f"  {m.get('label', ''):<12}: {m.get('value', '')}")
                if detail:
                    print(f"  Detail  : {detail}")
            print()

        elif subcmd == "add":
            type_id = getattr(args, "type_id", None)
            if not type_id:
                print("Usage: vera iot add <type_id> [--config '{\"key\": \"val\"}']", file=sys.stderr)
                return 1
            cfg_str = getattr(args, "config", None) or "{}"
            try:
                cfg = json.loads(cfg_str)
            except json.JSONDecodeError as exc:
                print(f"Invalid JSON config: {exc}", file=sys.stderr)
                return 1
            d = _http_post("/api/iot", {"type_id": type_id, "config": cfg})
            if d.get("ok"):
                print(f"Registered: {d.get('device_icon', '🔌')}  {d.get('device_name', type_id)}  (id: {d.get('device_id', type_id)})")
            else:
                print(f"Error: {d.get('detail', d.get('error', 'unknown error'))}", file=sys.stderr)
                return 1

        elif subcmd == "config":
            device_id = getattr(args, "device_id", None)
            if not device_id:
                print("Usage: vera iot config <device_id> [key=val ...]", file=sys.stderr)
                return 1
            settings = getattr(args, "settings", []) or []
            if not settings:
                # Read mode — show snapshot config
                d = _http_get(f"/api/iot/{device_id}")
                print(f"\nConfig for {BOLD}{device_id}{RESET}:")
                print(f"  (device config is not exposed directly — showing snapshot)")
                print(json.dumps(d, indent=2))
            else:
                # Write mode — parse key=value pairs
                cfg: dict = {}
                for kv in settings:
                    if "=" not in kv:
                        print(f"Invalid setting {kv!r} — must be key=value", file=sys.stderr)
                        return 1
                    k, _, v = kv.partition("=")
                    # Try int/float/bool coercion
                    if v.lower() in ("true", "false"):
                        cfg[k] = v.lower() == "true"
                    else:
                        try:
                            cfg[k] = int(v)
                        except ValueError:
                            try:
                                cfg[k] = float(v)
                            except ValueError:
                                cfg[k] = v
                d = _http_put(f"/api/iot/{device_id}", {"config": cfg})
                if d.get("ok"):
                    print(f"Config updated for {device_id}.")
                else:
                    print(f"Error: {d.get('detail', d.get('error', 'unknown'))}", file=sys.stderr)
                    return 1

        elif subcmd == "remove":
            device_id = getattr(args, "device_id", None)
            if not device_id:
                print("Usage: vera iot remove <device_id>", file=sys.stderr)
                return 1
            d = _http_delete(f"/api/iot/{device_id}")
            if d.get("ok"):
                print(f"Removed IoT device: {device_id}")
            else:
                print(f"Error: {d.get('detail', d.get('error', 'unknown'))}", file=sys.stderr)
                return 1

        elif subcmd == "announce":
            device_id = getattr(args, "device_id", None)
            if not device_id:
                print("Usage: vera iot announce <device_id>", file=sys.stderr)
                return 1
            d = _http_post(f"/api/iot/{device_id}/announce", {})
            if d.get("ok"):
                print("Announced via TTS.")
                if d.get("text"):
                    print(f"  \"{d['text']}\"")
            else:
                print(f"Error: {d.get('detail', d.get('error', 'unknown'))}", file=sys.stderr)
                return 1

        elif subcmd == "action":
            device_id = getattr(args, "device_id", None)
            action    = getattr(args, "action_name", None)
            if not device_id or not action:
                print("Usage: vera iot action <device_id> <action> [--params '{\"key\":\"val\"}']", file=sys.stderr)
                return 1
            params_str = getattr(args, "params", None) or "{}"
            try:
                params = json.loads(params_str)
            except json.JSONDecodeError as exc:
                print(f"Invalid JSON params: {exc}", file=sys.stderr)
                return 1
            d = _http_post(f"/api/iot/{device_id}/action", {"action": action, "params": params})
            if d.get("ok"):
                msg = d.get("message", "Action completed.")
                print(f"✓ {msg}")
            else:
                msg = d.get("message") or d.get("detail") or d.get("error") or "unknown error"
                print(f"✗ {msg}", file=sys.stderr)
                return 1

        else:
            print(f"Unknown iot subcommand: {subcmd!r}", file=sys.stderr)
            return 1

    except Exception as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1
    return 0


def cmd_lock(args) -> int:
    """Convenience command for Yale lock operations."""
    BOLD  = "\033[1m"
    GREEN = "\033[32m"
    RED   = "\033[31m"
    RESET = "\033[0m"
    subcmd = getattr(args, "lock_cmd", "status")
    device_id = "yale_lock"

    try:
        if subcmd == "status":
            d = _http_get(f"/api/iot/{device_id}")
            available = d.get("available", False)
            if not available:
                print(f"Yale lock: {RED}unavailable{RESET}  {d.get('error', '')}")
                return 1
            disp    = d.get("display") or {}
            primary = disp.get("primary") or {}
            value   = primary.get("value", "—")
            unit    = primary.get("unit", "")
            print(f"\n🔒  {BOLD}Yale Lock{RESET}")
            print("─" * 40)
            print(f"  State   : {BOLD}{value}{RESET}{(' — ' + unit) if unit else ''}")
            metrics = disp.get("metrics") or []
            for m in metrics:
                print(f"  {m.get('label', ''):<12}: {m.get('value', '')}")
            print()

        elif subcmd == "lock":
            d = _http_post(f"/api/iot/{device_id}/action", {"action": "lock", "params": {}})
            if d.get("ok"):
                print(f"🔒  {GREEN}Locked{RESET}")
            else:
                msg = d.get("message") or d.get("detail") or "unknown error"
                print(f"✗ {msg}", file=sys.stderr)
                return 1

        elif subcmd == "unlock":
            pin = getattr(args, "pin", None) or ""
            if not pin:
                import getpass
                pin = getpass.getpass("Yale PIN: ")
            d = _http_post(f"/api/iot/{device_id}/action", {"action": "unlock", "params": {"pin": pin}})
            if d.get("ok"):
                print(f"🔓  {RED}Unlocked{RESET}")
            else:
                msg = d.get("message") or d.get("detail") or "unknown error"
                print(f"✗ {msg}", file=sys.stderr)
                return 1

        else:
            print(f"Unknown lock subcommand: {subcmd!r}", file=sys.stderr)
            return 1

    except Exception as exc:
        print(f"Error: {exc}", file=sys.stderr)
        return 1
    return 0


